/formular.css?1759669674\" media=\"screen\" nonce=\"S4CTmSiLR01QmBfJ40MQwxAFzCESrpDZEzpQMAAJ2c93Ygrc4vsdDQ\">\n<link rel=\"stylesheet\" href=\"/_assets/d57d955b9e53c734140a859f0960631c/Css/basic/dbb-nav.css?1759669674\" media=\"screen\" nonce=\"S4CTmSiLR01QmBfJ40MQwxAFzCESrpDZEzpQMAAJ2c93Ygrc4vsdDQ\">\n<link rel=\"stylesheet\" href=\"/_assets/d57d955b9e53c734140a859f0960631c/Css/basic/dbb-topicons.css?1759669674\" media=\"screen\" nonce=\"S4CTmSiLR01QmBfJ40MQwxAFzCESrpDZEzpQMAAJ2c93Ygrc4vsdDQ\">\n<link rel=\"stylesheet\" href=\"/_assets/d57d955b9e53c734140a859f0960631c/Css/basic/dbb-multisite.css?1781183078\" media=\"all\" nonce=\"S4CTmSiLR01QmBfJ40MQwxAFzCESrpDZEzpQMAAJ2c93Ygrc4vsdDQ\">\n<link rel=\"stylesheet\" href=\"/_assets/d57d955b9e53c734140a859f0960631c/Css/basic/print-content.css?1759669674\" media=\"print\" nonce=\"S4CTmSiLR01QmBfJ40MQwxAFzCESrpDZEzpQMAAJ2c93Ygrc4vsdDQ\">\n<link rel=\"stylesheet\" href=\"/_assets/d57d955b9e53c734140a859f0960631c/Css/Ext/tx_dce/dce-button.css?1781264798\" media=\"screen\" nonce=\"S4CTmSiLR01QmBfJ40MQwxAFzCESrpDZEzpQMAAJ2c93Ygrc4vsdDQ\">\n<link rel=\"stylesheet\" href=\"/_assets/1bc8151e3278ac5e9ed670c93338217d/Css/dbb.css?1793367552\" media=\"screen\" nonce=\"S4CTmSiLR01QmBfJ40MQwxAFzCESrpDZEzpQMAAJ2c93Ygrc4vsdDQ\">\n<link href=\"/_assets/d57d955b9e53c734140a859f0960631c/Css/Ext/tx_news/news-ms.css?1779294950\" rel=\"stylesheet\" >\n<link href=\"/_assets/1bc8151e3278ac5e9ed670c93338217d/Css/Ext/tx_news/news-add.css?1759669674\" rel=\"stylesheet\" >\n\n\n\n\n\n\n<title>Amtsangemessene Alimentation: dbb fordert Umsetzung </title>        <link rel=\"shortcut icon\" href=\"/_assets/d57d955b9e53c734140a859f0960631c/Images/favicon.png\" type=\"image/ico\"><link rel=\"apple-touch-icon\" sizes=\"57x57\" href=\"/_assets/1bc8151e3278ac5e9ed670c93338217d/Images/dbb_logo_180.png\"><link rel=\"apple-touch-icon\" sizes=\"76x76\" href=\"/_assets/1bc8151e3278ac5e9ed670c93338217d/Images/dbb_logo_180.png\"><link rel=\"apple-touch-icon\" size