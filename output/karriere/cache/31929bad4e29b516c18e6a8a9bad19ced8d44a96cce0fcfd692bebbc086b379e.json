  "fetched_at": "2026-11-25T16:01:28.609741+00:00",
  "text": "<!doctype html>\n\r\n<html lang=\"ja\">\r\n<head>\r\n<script src=\"//nexus.ensighten.com/kirin/prod_kyowakirin-co-jp/Bootstrap.js\"></script>\r\n<meta charset=\"UTF-8\">\r\n<meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\r\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n<title>福利厚生｜採用情報サイト｜協和キリン株式会社</title>\r\n<meta name=\"description\" content=\"製薬会社・協和キリンの採用情報ウェブサイトです。新卒採用情報、キャリア採用情報、障害者採用情報、グループ各企業の採用情報を公開しています。\">\r\n<meta property=\"og:type\" content=\"website\">\r\n<meta property=\"og:image\" content=\"https://www.kyowakirin.co.jp/careers/recruit/share/img/ogp.png\">\r\n<meta property=\"og:title\" content=\"福利厚生｜採用情報サイト｜協和キリン株式会社\">\r\n<meta property=\"og:description\" content=\"製薬会社・協和キリンの採用情報ウェブサイトです。新卒採用情報、キャリア採用情報、障害者採用情報、グループ各企業の採用情報を公開しています。\">\r\n<link rel=\"shortcut icon\" href=\"/careers/recruit/share/img/favicon.ico\">\r\n<link rel=\"apple-touch-icon\" href=\"/careers/recruit/share/img/apple_touch_icon.png\">\r\n<link rel=\"canonical\" href=\"https://www.kyowakirin.co.jp/careers/recruit/welfare/\">\r\n<link rel=\"preconnect\" href=\"https://www.googletagmanager.com\">\r\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\r\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"\">\r\n<link rel=\"preload\" as=\"style\" href=\"/careers/recruit/welfare/css/welfare.css\">\r\n\r\n<link href=\"https://fonts.googleapis.com/css2?family=Hind+Madurai:wght@400;500;600;700&amp;display=swap\" rel=\"stylesheet\">\r\n<link rel=\"stylesheet\" href=\"/careers/recruit/share/css/common.css?20261119121404442\">\r\n<link rel=\"stylesheet\" href=\"/careers/recruit/welfare/css/welfare.css?20261119121404442\">\r\n<script src=\"/careers/recruit/share/js/init.js?20261119121404442\"></script>\r\n<script type=\"module\" src=\"/careers/recruit/share/js/common.js?20261119121404442\" crossorigin=\"\"></script>\r\n<!--  Google Tag Manager  -->\r\n<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':\r\nnew Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],\r\nj=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=\r\n'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);\r\n})(window,document,'script','dataLayer','GTM-5BDMWGT');</script>\r\n<!--  End Google Tag Manager  --></head>\r\n<body id=\"top\">\r\n<!--  Google Tag Manager (noscript)  -->\r\n<noscript><iframe src=\"https://www.googletagmanager.com/ns.html?id=GTM-5BDMWGT\" height=\"0\" width=\"0\" style=\"display:none;visibility:hidden\"></iframe></noscript>\r\n<!--  End Google Tag Manager (noscript)  --><!--  /careers/recruit/share/inc/header.html include start  -->\r\n<div class=\"inc_careers_recruit_share_inc_header\">\r\n<header id=\"str-header\" class=\"str-header\">\r\n<div class=\"str-header__body\">\r\n<div class=\"str-header-logo\">\r\n<a href=\"/careers/recruit/\" class=\"str-header-logo__body\">\r\n<img src=\"/careers/recruit/share/img/logo-main.svg\" alt=\"KYOWA KIRIN\" width=\"221\" height=\"36\" class=\"str-header-logo__item\">\r\n<span class=\"str-header-logo__title\">Recruiting</span>\r\n</a>\r\n<!--  /.str-header-logo  --></div>\r\n\r\n<ul class=\"str-header-link\">\r\n<li class=\"str-header-link__item\"><a href=\"https://mypage.3010.i-webs.jp/kyowakirin2028/\" target=\"_blank\" class=\"str-header-link__link str-header-link__link--main str-header-link__link--new\">新卒 2028年卒<span>ENTRY・MY PAGE<svg class=\"m-icon m-icon--blank-default-white\" role=\"img\" aria-label=\"別窓で開く\"><use href=\"#icon-blank-default\"></use></svg></span></a></li>\r\n<li class=\"str-header-link__item\"><a href=\"https://mypage.3010.i-webs.jp/kyowakirin2027/\" target=\"_blank\" class=\"str-header-link__link str-header-link__link--main str-header-link__link--mid\">新卒 2027年卒<span>ENTRY・MY PAGE<svg class=\"m-icon m-icon--blank-default-white\" role=\"img\" aria-label=\"別窓で開く\"><use href=\"#icon-blank-default\"></use></svg></span></a></li>\r\n<li class=\"str-header-link__item\"><a href=\"https://hrmos.co/pages/kyowakirin\" target=\"_blank\" class=\"str-header-link__link\"><span>キャリア採用<svg class=\"m-icon m-icon--blank-default\" role=\"img\" aria-label=\"別窓で開く\"><use href=\"#icon-blank-default\"></use></svg></span></a></li>\r\n<li class=\"str-header-link__item\"><a href=\"/careers/recruit/handicapped/\" class=\"str-header-link__link\">障害をお持ちの方</a></li>\r\n<!--  /.str-header-link  --></ul>\r\n\r\n<button type=\"button\" class=\"str-header-menu\"><span class=\"js-gnav-btn-label\">MENU</span></button>\r\n<!--  /.str-header__body  --></div>\r\n\r\n<nav class=\"str-nav\" aria-label=\"global navigation\">\r\n<div class=\"str-nav__body\">\r\n<div class=\"str-nav__item\">\r\n<p class=\"str-nav__title js-gnav-toggle-btn\">Company（協和キリンについて）</p>\r\n\r\n<div class=\"str-nav-menu\">\r\n<div class=\"str-nav-menu__body\">\r\n<ul class=\"str-nav-menu-link\" data-col=\"1\" data-col-wide=\"3\">\r\n<li class=\"str-nav-menu-link__item\"><a href=\"/careers/recruit/ambition/\" class=\"str-nav-menu-link__link\">私たちの志</a></li>\r\n<li class=\"str-nav-menu-link__item\"><a href=\"/careers/recruit/company/\" class=\"str-nav-menu-link__link\">vision</a></li>\r\n</ul>\r\n<!--  /.str-nav-menu__body  --></div>\r\n<!--  /.str-nav-menu  --></div>\r\n<!--  /.str-nav__item  --></div>\r\n\r\n<div class=\"str-nav__item\">\r\n<p class=\"str-nav__title js-gnav-toggle-btn\">People&amp;Job（人と仕事）</p>\r\n\r\n<div class=\"str-nav-menu\">\r\n<div class=\"str-nav-menu__body\">\r\n<ul class=\"str-nav-menu-link\" data-col=\"1\" data-col-wide=\"3\">\r\n<li class=\"str-nav-menu-link__item\"><a href=\"/careers/recruit/interview/\" class=\"str-nav-menu-link__link\">社員インタビュー</a></li>\r\n<li class=\"str-nav-menu-link__item\"><a href=\"/careers/recruit/personality/\" class=\"str-nav-menu-link__link\">【新卒向け】求める人材像</a></li>\r\n<li class=\"str-nav-menu-link__item\"><a href=\"/careers/recruit/work/\" class=\"str-nav-menu-link__link\">【新卒向け】職種紹介</a></li>\r\n<li class=\"str-nav-menu-link__item\"><a href=\"/careers/recruit/project/\" class=\"str-nav-menu-link__link\">プロジェクトストーリー</a></li>\r\n</ul>\r\n<!--  /.str-nav-menu__body  --></div>\r\n<!--  /.str-nav-menu  --></div>\r\n<!--  /.str-nav__item  --></div>\r\n\r\n<div class=\"str-nav__item\">\r\n<p class=\"str-nav__title js-gnav-toggle-btn\">Work Style（働く環境）</p>\r\n\r\n<div class=\"str-nav-menu\">\r\n<div class=\"str-nav-menu__body\">\r\n<ul class=\"str-nav-menu-link\" data-col=\"1\" data-col-wide=\"3\">\r\n<li class=\"str-nav-menu-link__item\"><a href=\"/careers/recruit/office/\" class=\"str-nav-menu-link__link\">国内拠点紹介</a></li>\r\n<li class=\"str-nav-menu-link__item\"><a href=\"/careers/recruit/interviewmovie/\" class=\"str-nav-menu-link__link\">女性の経営職</a></li>\r\n<li class=\"str-nav-menu-link__item\"><a href=\"/careers/recruit/training/\" class=\"str-nav-menu-link__link\">人材育成</a></li>\r\n<li class=\"str-nav-menu-link__item\"><a href=\"/careers/recruit/welfare/\" class=\"str-nav-menu-link__link\">福利厚生</a></li>\r\n<li class=\"str-nav-menu-link__item\"><a href=\"https://www.kyowakirin.co.jp/sustainability/human_resources_infrastructure/dei/index.html\" target=\"_blank\" class=\"str-nav-menu-link__link\">ダイバーシティへの取り組み<svg class=\"m-icon m-icon--blank-default\" role=\"img\" aria-label=\"別窓で開く\"><use href=\"#icon-blank-default\"></use></svg></a></li>\r\n<li class=\"str-nav-menu-link__item\"><a href=\"https://www.kyowakirin.co.jp/sustainability/human_resources_infrastructure/portfolio/workplace_safety/index.html\" target=\"_blank\" class=\"str-nav-menu-link__link\">健康経営<svg class=\"m-icon m-icon--blank-default\" role=\"img\" aria-label=\"別窓で開く\"><use href=\"#icon-blank-default\"></use></svg></a></li>\r\n</ul>\r\n<!--  /.str-nav-menu__body  --></div>\r\n<!--  /.str-nav-menu  --></div>\r\n<!--  /.str-nav__item  --></div>\r\n\r\n<div class=\"str-nav__item\">\r\n<p class=\"str-nav__title js-gnav-toggle-btn\">Cross Talk（クロストーク）</p>\r\n\r\n<div class=\"str-nav-menu\">\r\n<div class=\"str-nav-menu__body\">\r\n<ul class=\"str-nav-menu-link\" data-col=\"1\" data-col-wide=\"3\">\r\n<li class=\"str-nav-menu-link__item\"><a href=\"/careers/recruit/talk/03.html\" class=\"str-nav-menu-link__link\">患者さんの声を大切に形にする活動</a></li>\r\n<li class=\"str-nav-menu-link__item\"><a href=\"/careers/recruit/talk/02.html\" class=\"str-nav-menu-link__link\">協和キリンのグローバル化</a></li>\r\n</ul>\r\n<!--  /.str-nav-menu__body  --></div>\r\n<!--  /.str-nav-menu  --></div>\r\n<!--  /.str-nav__item  --></div>\r\n\r\n<div class=\"str-nav__item\">\r\n<p class=\"str-nav__title js-gnav-toggle-btn\">Recruit（採用情報）</p>\r\n\r\n<div class=\"str-nav-menu\">\r\n<div class=\"str-nav-menu__body\">\r\n<ul class=\"str-nav-menu-link\" data-col=\"1\" data-col-wide=\"3\">\r\n<li class=\"str-nav-menu-link__item\"><a href=\"/careers/recruit/guideline/\" class=\"str-nav-menu-link__link\">新卒採用</a></li>\r\n<li class=\"str-nav-menu-link__item\"><a href=\"https://hrmos.co/pages/kyowakirin\" target=\"_blank\" class=\"str-nav-menu-link__link\">キャリア採用<svg class=\"m-icon m-icon--blank-default\" role=\"img\" aria-label=\"別窓で開く\"><use href=\"#icon-blank-default\"></use></svg></a></li>\r\n<li class=\"str-nav-menu-link__item\"><a href=\"/careers/recruit/handicapped/\" class=\"str-nav-menu-link__link\">障害者採用</a></li>\r\n<li class=\"str-nav-menu-link__item\"><a href=\"/careers/recruit/faq/\" class=\"str-nav-menu-link__link\">FAQ</a></li>\r\n</ul>\r\n<!--  /.str-nav-menu__body  --></div>\r\n<!--  /.str-nav-menu  --></div>\r\n<!--  /.str-nav__item  --></div>\r\n\r\n<!--  /.str-nav__body  --></div>\r\n<!--  /.str-nav  --></nav>\r\n<!--  /.str-header  --></header>\r\n</div>\r\n<!--  /careers/recruit/share/inc/header.html include end  -->\r\n\r\n<main class=\"str-main\">\r\n<nav class=\"str-breadcrumb\" aria-label=\"breadcrumb\">\r\n<ol class=\"str-breadcrumb__list\">\r\n<li class=\"str-breadcrumb__item\"><a href=\"/careers/recruit/\" class=\"str-breadcrumb__text str-breadcrumb__text--top\"><span class=\"str-breadcrumb__label\">ホーム</span></a></li>\r\n<li class=\"str-breadcrumb__item\"><span class=\"str-breadcrumb__text\" aria-current=\"page\">福利厚生</span></li>\r\n</ol>\r\n<!--  /.breadcrumb  --></nav>\r\n\r\n\r\n<div class=\"m-hdg-lv1-4\">\r\n<div class=\"m-hdg-lv1-4__body\">\r\n<h1 class=\"m-hdg-lv1-4__title\"><span class=\"m-hdg-lv1-4__sub\">働く環境</span>福利厚生</h1>\r\n<!--  /.m-hdg-lv1-4__body  --></div>\r\n<div class=\"m-hdg-lv1-4__media\"><img src=\"/careers/recruit/welfare/img/index-mv.jpg\" width=\"1360\" height=\"600\" alt=\"\" decoding=\"async\"></div>\r\n<!--  /.m-hdg-lv1-4  --></div>\r\n\r\n<div class=\"str-section\">\r\n<div class=\"str-section__inner\">\r\n\r\n<div class=\"m-list-link-anchor\">\r\n<ul class=\"m-list-link-anchor__body\" data-col=\"1\" data-col-wide=\"2\">\r\n<li class=\"m-list-link-anchor__item\"><a href=\"#anc-leave\" class=\"m-list-link-anchor__link\">休暇制度</a></li>\r\n<li class=\"m-list-link-anchor__item\"><a href=\"#anc-support\" class=\"m-list-link-anchor__link\">出産・育児・介護・転勤などをサポートする制度</a></li>\r\n<li class=\"m-list-link-anchor__item\"><a href=\"#anc-other\" class=\"m-list-link-anchor__link\">その他の制度</a></li>\r\n<li class=\"m-list-link-anchor__item\"><a href=\"#anc-values\" class=\"m-list-link-anchor__link\">働く環境の実際の数値データ</a></li>\r\n<!--  /.m-list-link-anchor__body  --></ul>\r\n<!--  /.m-list-link-anchor  --></div>\r\n\r\n<div class=\"m-hdg-lv2\">\r\n<h2 id=\"anc-leave\" class=\"m-hdg-lv2__title\">休暇制度</h2>\r\n<!--  /.m-hdg-lv2  --></div>\r\n\r\n<div class=\"m-layout-media\">\r\n<div class=\"m-layout-media__body\">\r\n<picture>\r\n<source srcset=\"/careers/recruit/welfare/img/index-img-pc-01.jpg\" width=\"1120\" height=\"320\" media=\"(min-width: 769px)\">\r\n<img src=\"/careers/recruit/welfare/img/index-img-01.jpg\" width=\"325\" height=\"168\" alt=\"\" decoding=\"async\" loading=\"lazy\">\r\n</picture>\r\n<!--  /.m-layout-media__body  --></div>\r\n<!--  /.m-layout-media  --></div>\r\n\r\n<div class=\"m-layout-grid\" data-col=\"1\" data-col-wide=\"2\">\r\n<div class=\"m-layout-grid__col\">\r\n<div class=\"m-hdg-lv3-2\">\r\n<h3 class=\"m-hdg-lv3-2__title\">年次有給休暇</h3>\r\n<!--  /.m-hdg-lv3-2  --></div>\r\n\r\n<ul class=\"m-list\">\r\n<li class=\"m-list__item\">毎年20日の有給休暇付与。（有効期間は2年間）</li>\r\n<li class=\"m-list__item\">半日単位・時間単位で取得可能</li>\r\n<!--  /.m-list  --></ul>\r\n<!--  /.m-layout-grid__col  --></div>\r\n\r\n<div class=\"m-layout-grid__col\">\r\n<div class=\"m-hdg-lv3-2\">\r\n<h3 class=\"m-hdg-lv3-2__title\">セルフマネジメント休暇</h3>\r\n<!--  /.m-hdg-lv3-2  --></div>\r\n\r\n<p class=\"m-text\">年次有給休暇とは別で、自身の心身の状態や私生活でのイベントを自らマネジメントし、ベストコンディションで業務を遂行していく状態を主体的につくることを目的として、毎年10日の有給休暇を付与。私傷病、不妊治療、結婚、配偶者の出産時、看護、介護、ボランティア等の事由で取得可能。</p>\r\n<!--  /.m-layout-grid__col  --></div>\r\n<!--  /.m-layout-grid  --></div>\r\n\r\n\r\n<div class=\"m-hdg-lv2\">\r\n<h2 id=\"anc-support\" class=\"m-hdg-lv2__title\">出産・育児・介護・転勤などをサポートする制度</h2>\r\n<!--  /.m-hdg-lv2  --></div>\r\n\r\n<div class=\"m-layout-media\">\r\n<div class=\"m-layout-media__body\">\r\n<picture>\r\n<source srcset=\"/careers/recruit/welfare/img/index-img-pc-02.jpg\" width=\"1120\" height=\"320\" media=\"(min-width: 769px)\">\r\n<img src=\"/careers/recruit/welfare/img/index-img-02.jpg\" width=\"325\" height=\"168\" alt=\"\" decoding=\"async\" loading=\"lazy\">\r\n</picture>\r\n<!--  /.m-layout-media__body  --></div>\r\n<!--  /.m-layout-media  --></div>\r\n\r\n<div class=\"m-hdg-lv3-2\">\r\n<h3 class=\"m-hdg-lv3-2__title\">出産・育児に関する制度</h3>\r\n<!--  /.m-hdg-lv3-2  --></div>\r\n<div class=\"m-hdg-lv4\">\r\n<h4 class=\"m-hdg-lv4__title\">女性が取得可能</h4>\r\n<!--  /.m-hdg-lv4  --></div>\r\n\r\n<ul class=\"m-list\">\r\n<li class=\"m-list__item\">産前産後休職\r\n<ul class=\"m-list\">\r\n<li class=\"m-list__item\">産前6週間（多胎妊娠の場合は14週間以内）、産後8週間取得可能。</li>\r\n<li class=\"m-list__item\">産前産後休職期間中は支援金を支給。</li>\r\n<!--  /.m-list  --></ul>\r\n</li>\r\n<li class=\"m-list__item\">育児時間\r\n<ul class=\"m-list\">\r\n<li class=\"m-list__item\">生後満1年に達しない生児を育てる女性社員は、休憩時間のほか、1日2回各々30分間、育児時間を取得可能。</li>\r\n<!--  /.m-list  --></ul>\r\n</li>\r\n<li class=\"m-list__item\">他、妊娠中や出産後に労働時間などに関する配慮を目的とした措置が受けられます（申請制）</li>\r\n<!--  /.m-list  --></ul>\r\n\r\n<div class=\"m-hdg-lv4\">\r\n<h4 class=\"m-hdg-lv4__title\">男女問わず取得可能</h4>\r\n<!--  /.m-hdg-lv4  --></div>\r\n\r\n<ul class=\"m-list\">\r\n<li class=\"m-list__item\">セルフマネジメント休暇（配偶者出産時に取得可能・賃金支給対象）\r\n<ul class=\"m-list\">\r\n<li class=\"m-list__item\">配偶者の出産時、分娩を目的とした入院日から退院日まで最大10日間</li>\r\n<!--  /.m-list  --></ul>\r\n</li>\r\n<li class=\"m-list__item\">出生時育児休暇（賃金支給対象）\r\n<ul class=\"m-list\">\r\n<li class=\"m-list__item\">休職中ではない社員について、子の出生後8週間以内のうち年次有給休暇を20日間取得可能。（主に男性が取得可能）</li>\r\n<!--  /.m-list  --></ul>\r\n</li>\r\n<li class=\"m-list__item\">育児休職\r\n<ul class=\"m-list\">\r\n<li class=\"m-list__item\">勤続6ヵ月以上の社員について、子が2歳に達するまで取得可能。</li>\r\n<!--  /.m-list  --></ul>\r\n</li>\r\n<li class=\"m-list__item\">育児短時間勤務\r\n<ul class=\"m-list\">\r\n<li class=\"m-list__item\">子が小学校3年生の学年末に達するまで、取得可能。</li>\r\n<!--  /.m-list  --></ul>\r\n</li>\r\n<li class=\"m-list__item\">子の看護等休暇（賃金不支給）\r\n<ul class=\"m-list\">\r\n<li class=\"m-list__item\">小学校3年生の学年末に達するまでの子でケガ・病気等の世話、予防接種や健康診断を受けるため、または子の学級閉鎖等、入園（入学）式・卒園式を理由に子の看護等休暇を取得可能。年間10日間（時間単位での取得が可能）</li>\r\n<!--  /.m-list  --></ul>\r\n</li>\r\n<li class=\"m-list__item\">ベビーシッター利用補助\r\n<ul class=\"m-list\">\r\n<li class=\"m-list__item\">社員が就業するためにベビーシッターサービスを利用した場合は、会社から補助を受けることができる。</li>\r\n<!--  /.m-list  --></ul>\r\n</li>\r\n<li class=\"m-list__item\">企業内保育施設\r\n<ul class=\"m-list\">\r\n<li class=\"m-list__item\">富士リサーチパーク／CMC研究センター（静岡県）、高崎工場／バイオ生産技術研究所（群馬県）に企業内保育施設を設置。</li>\r\n<!--  /.m-list  --></ul>\r\n</li>\r\n<li class=\"m-list__item\">他、小学校就学の初期に達するまでの子を育てる社員を対象に、労働時間に関する配慮を目的とした措置が受けられます（申請制）</li>\r\n<!--  /.m-list  --></ul>\r\n\r\n\r\n<div class=\"m-layout-grid\" data-col=\"1\" data-col-wide=\"2\">\r\n<div class=\"m-layout-grid__col\">\r\n<div class=\"m-hdg-lv3-2\">\r\n<h3 class=\"m-hdg-lv3-2__title\">介護制度</h3>\r\n<!--  /.m-hdg-lv3-2  --></div>\r\n\r\n<ul class=\"m-list\">\r\n<li class=\"m-list__item\">介護休職\r\n<ul class=\"m-list\">\r\n<li class=\"m-list__item\">勤続6カ月以上の社員は、家族が要介護状態である場合、最長12ヵ月間を限度として取得可能。</li>\r\n<!--  /.m-list  --></ul>\r\n</li>\r\n<li class=\"m-list__item\">介護短時間勤務\r\n<ul class=\"m-list\">\r\n<li class=\"m-list__item\">利用開始から36ヵ月の間で取得可能。</li>\r\n<!--  /.m-list  --></ul>\r\n</li>\r\n<!--  /.m-list  --></ul>\r\n<!--  /.m-layout-grid__col  --></div>\r\n\r\n<div class=\"m-layout-grid__col\">\r\n<div class=\"m-hdg-lv3-2\">\r\n<h3 class=\"m-hdg-lv3-2__title\">転勤・家族サポート制度</h3>\r\n<!--  /.m-hdg-lv3-2  --></div>\r\n\r\n<ul class=\"m-list\">\r\n<li class=\"m-list__item\">配偶者の転勤に伴う休職\r\n<ul class=\"m-list\">\r\n<li class=\"m-list__item\">勤続3年以上の社員について、配偶者の国内外への転勤によりその転勤先へ転居する場合、最長2年間取得可能。</li>\r\n<!--  /.m-list  --></ul>\r\n</li><li class=\"m-list__item\">MR結婚・出産時同居支援制度\r\n<ul class=\"m-list\">\r\n<li class=\"m-list__item\">勤続3年以上のMR職の社員が、結婚または子の出生といったライフイベントを迎えた際に、 配偶者と同居下で就業することを最長9年間支援。</li>\r\n<!--  /.m-list  --></ul>\r\n</li>\r\n<li class=\"m-list__item\">ファミリーサポート手当\r\n<ul class=\"m-list\">\r\n<li class=\"m-list__item\">扶養する22歳未満の子、要介護者の家族、扶養する70歳以上の本人・配偶者の実養父母、扶養する重度障害者をもつ2親等以内の親族を対象に支給。</li>\r\n<!--  /.m-list  --></ul>\r\n</li>\r\n<!--  /.m-list  --></ul>\r\n<!--  /.m-layout-grid__col  --></div>\r\n<!--  /.m-layout-grid  --></div>\r\n\r\n<ul class=\"m-list-link m-list-link--anchor\">\r\n<li class=\"m-list-link__item\"><a href=\"#anc-values\" class=\"m-list-link__link\"><span class=\"m-list-link__text\">実際の数値データはこちら</span></a></li>\r\n<!--  /.m-list-link  --></ul>\r\n\r\n<div class=\"m-btn\">\r\n<a href=\"/careers/recruit/welfare/employee_voices/index.html\" class=\"m-btn__btn m-btn__btn--em\">仕事と育児を両立している<br>社員3名に聞いてみました！\r\n</a>\r\n<!--  /.m-btn  --></div>\r\n\r\n\r\n<div class=\"m-hdg-lv2\">\r\n<h2 id=\"anc-other\" class=\"m-hdg-lv2__title\">その他の制度</h2>\r\n<!--  /.m-hdg-lv2  --></div>\r\n\r\n<div class=\"m-layout-grid\" data-col=\"1\" data-col-wide=\"2\">\r\n<div class=\"m-layout-grid__col\">\r\n<div class=\"m-hdg-lv3-2\">\r\n<h3 class=\"m-hdg-lv3-2__title\">社宅・寮</h3>\r\n<!--  /.m-hdg-lv3-2  --></div>\r\n\r\n<p class=\"m-text\">自宅から通勤できない勤務地に配属・転勤になった場合に貸与。</p>\r\n<!--  /.m-layout-grid__col  --></div>\r\n\r\n<div class=\"m-layout-grid__col\">\r\n<div class=\"m-hdg-lv3-2\">\r\n<h3 class=\"m-hdg-lv3-2__title\">社会保険</h3>\r\n<!--  /.m-hdg-lv3-2  --></div>\r\n\r\n<p class=\"m-text\">健康保険、介護保険、厚生年金保険、雇用保険、労災保険。</p>\r\n<!--  /.m-layout-grid__col  --></div>\r\n\r\n<div class=\"m-layout-grid__col\">\r\n<div class=\"m-hdg-lv3-2\">\r\n<h3 class=\"m-hdg-lv3-2__title\">各種財形・融資制度</h3>\r\n<!--  /.m-hdg-lv3-2  --></div>\r\n\r\n<p class=\"m-text\">一般財形貯蓄、財形住宅貯蓄、財形年金貯蓄、財形持家転貸融資など。</p>\r\n<!--  /.m-layout-grid__col  --></div>\r\n\r\n<div class=\"m-layout-grid__col\">\r\n<div class=\"m-hdg-lv3-2\">\r\n<h3 class=\"m-hdg-lv3-2__title\">従業員持株会</h3>\r\n<!--  /.m-hdg-lv3-2  --></div>\r\n\r\n<p class=\"m-text\">自社株を１口1,000円から購入可能。（口数に応じて会社から奨励金の支給があり）</p>\r\n<!--  /.m-layout-grid__col  --></div>\r\n\r\n<div class=\"m-layout-grid__col\">\r\n<div class=\"m-hdg-lv3-2\">\r\n<h3 class=\"m-hdg-lv3-2__title\">キリングループ福祉会</h3>\r\n<!--  /.m-hdg-lv3-2  --></div>\r\n\r\n<p class=\"m-text\">キリングループの従業員（会員）から集められた会費を財源にして運営。<br>慶弔慰・見舞金給付、遺児育英年金給付、医療助成金給付、ホームヘルパー制度、共済融資など。</p>\r\n<!--  /.m-layout-grid__col  --></div>\r\n\r\n<div class=\"m-layout-grid__col\">\r\n<div class=\"m-hdg-lv3-2\">\r\n<h3 class=\"m-hdg-lv3-2__title\">レクリエーション補助</h3>\r\n<!--  /.m-hdg-lv3-2  --></div>\r\n\r\n<p class=\"m-text\">社内で企画されたレクリエーション活動に対する補助金制度。</p>\r\n<!--  /.m-layout-grid__col  --></div>\r\n\r\n<div class=\"m-layout-grid__col\">\r\n<div class=\"m-hdg-lv3-2\">\r\n<h3 class=\"m-hdg-lv3-2__title\">福利厚生充実プラン</h3>\r\n<!--  /.m-hdg-lv3-2  --></div>\r\n\r\n<p class=\"m-text\">宿泊施設やスポーツクラブなど、様々な福利厚生メニューを会員価格で利用可能。</p>\r\n<!--  /.m-layout-grid__col  --></div>\r\n\r\n<div class=\"m-layout-grid__col\">\r\n<div class=\"m-hdg-lv3-2\">\r\n<h3 class=\"m-hdg-lv3-2__title\">GLTD（団体長期障害所得補償保険）</h3>\r\n<!--  /.m-hdg-lv3-2  --></div>\r\n\r\n<p class=\"m-text\">万が一病気やケガで働けなくなったとき、社内制度終了後のセーフティーネットとして、会社負担の所得補償保険に加入。</p>\r\n<!--  /.m-layout-grid__col  --></div>\r\n<!--  /.m-layout-grid  --></div>\r\n\r\n\r\n<div class=\"m-hdg-lv2\">\r\n<h2 id=\"anc-values\" class=\"m-hdg-lv2__title\">働く環境の実際の数値データ</h2>\r\n<!--  /.m-hdg-lv2  --></div>\r\n\r\n<div class=\"m-layout-grid\" data-col=\"1\" data-col-wide=\"3\">\r\n<div class=\"m-layout-grid__col\">\r\n<dl class=\"uniq-welfare-list-definition uniq-welfare-list-definition--supple-bottom\">\r\n<dt class=\"uniq-welfare-list-definition__title\">平均年齢（※2）</dt>\r\n<dd class=\"uniq-welfare-list-definition__content\">\r\n<div class=\"uniq-welfare-data\">\r\n<p class=\"uniq-welfare-text\"><em> 42.4</em>歳</p>\r\n<p class=\"uniq-welfare-text__sub\">（男性：43.0歳、女性：41.2歳）</p>\r\n</div>\r\n<div class=\"uniq-welfare-layout-media\">\r\n<img src=\"/careers/recruit/welfare/img/index-img-07.svg\" width=\"186\" height=\"141\" alt=\"\" decoding=\"async\" loading=\"lazy\">\r\n<!--  /.uniq-welfare-layout-media  --></div>\r\n</dd>\r\n<!--  /.uniq-welfare-list-definition  --></dl>\r\n<!--  /.m-layout-grid__col  --></div>\r\n\r\n<div class=\"m-layout-grid__col\">\r\n<dl class=\"uniq-welfare-list-definition uniq-welfare-list-definition--supple-bottom\">\r\n<dt class=\"uniq-welfare-list-definition__title\">平均勤続年数（※2）</dt>\r\n<dd class=\"uniq-welfare-list-definition__content\">\r\n<div class=\"uniq-welfare-data\">\r\n<p class=\"uniq-welfare-text\"><em>15.5</em>年</p>\r\n<p class=\"uniq-welfare-text--supple-bottom\">（男性：15.8年、女性：14.8年）</p>\r\n</div>\r\n<div class=\"uniq-welfare-layout-media\">\r\n<img src=\"/careers/recruit/welfare/img/index-img-06.svg\" width=\"189\" height=\"132\" alt=\"\" decoding=\"async\" loading=\"lazy\">\r\n<!--  /.uniq-welfare-layout-media  --></div>\r\n</dd>\r\n<!--  /.uniq-welfare-list-definition  --></dl>\r\n<!--  /.m-layout-grid__col  --></div>\r\n\r\n<div class=\"m-layout-grid__col\">\r\n<dl class=\"uniq-welfare-list-definition uniq-welfare-list-definition--supple-bottom\">\r\n<dt class=\"uniq-welfare-list-definition__title\">月平均時間外労働時間</dt>\r\n<dd class=\"uniq-welfare-list-definition__content\">\r\n<div class=\"uniq-welfare-data\">\r\n<p class=\"uniq-welfare-text\"><em>22.1</em>時間/月</p>\r\n<p class=\"uniq-welfare-text__sub\">（経営職を除く）</p>\r\n</div>\r\n<div class=\"uniq-welfare-layout-media\">\r\n<img src=\"/careers/recruit/welfare/img/index-img-04.svg\" width=\"189\" height=\"138\" alt=\"\" decoding=\"async\" loading=\"lazy\">\r\n<!--  /.uniq-welfare-layout-media  --></div>\r\n</dd>\r\n<!--  /.uniq-welfare-list-definition  --></dl>\r\n<!--  /.m-layout-grid__col  --></div>\r\n\r\n<div class=\"m-layout-grid__col\">\r\n<dl class=\"uniq-welfare-list-definition\">\r\n<dt class=\"uniq-welfare-list-definition__title\">年平均有給休暇取得日数</dt>\r\n<dd class=\"uniq-welfare-list-definition__content\">\r\n<div class=\"uniq-welfare-data\">\r\n<p class=\"uniq-welfare-text\"><em>15.9</em>日/年</p>\r\n<p class=\"uniq-welfare-text__sub\">（正社員）</p>\r\n</div>\r\n<div class=\"uniq-welfare-layout-media\">\r\n<img src=\"/careers/recruit/welfare/img/index-img-03.svg\" width=\"199\" height=\"134\" alt=\"\" decoding=\"async\" loading=\"lazy\">\r\n<!--  /.uniq-welfare-layout-media  --></div>\r\n</dd>\r\n<!--  /.uniq-welfare-list-definition  --></dl>\r\n<!--  /.m-layout-grid__col  --></div>\r\n\r\n<div class=\"m-layout-grid__col\">\r\n<dl class=\"uniq-welfare-list-definition uniq-welfare-list-definition--supple-top\">\r\n<dt class=\"uniq-welfare-list-definition__title\">出産育児休暇取得率（※1）</dt>\r\n<dd class=\"uniq-welfare-list-definition__content\">\r\n<div class=\"uniq-welfare-data\" data-col=\"2\">\r\n<div class=\"uniq-welfare-layout-grid\">\r\n<div class=\"uniq-welfare-layout-grid__col\">\r\n<p class=\"uniq-welfare-text__sub\">男性</p>\r\n<p class=\"uniq-welfare-text\"><em>129.4</em>％</p>\r\n<!--  /.uniq-welfare-layout-grid__col  --></div>\r\n<div class=\"uniq-welfare-layout-grid__col\">\r\n<p class=\"uniq-welfare-text__sub\">女性</p>\r\n<p class=\"uniq-welfare-text\"><em>117.4</em>％</p>\r\n<!--  /.uniq-welfare-layout-grid__col  --></div>\r\n<!--  /.uniq-welfare-layout-grid  --></div>\r\n</div>\r\n<div class=\"uniq-welfare-layout-media\">\r\n<img src=\"/careers/recruit/welfare/img/index-img-05.svg\" width=\"197\" height=\"138\" alt=\"\" decoding=\"async\" loading=\"lazy\">\r\n<!--  /.uniq-welfare-layout-media  --></div>\r\n</dd>\r\n<!--  /.uniq-welfare-list-definition  --></dl>\r\n<!--  /.m-layout-grid__col  --></div>\r\n\r\n<div class=\"m-layout-grid__col\">\r\n<dl class=\"uniq-welfare-list-definition\">\r\n<dt class=\"uniq-welfare-list-definition__title\">女性経営職比率</dt>\r\n<dd class=\"uniq-welfare-list-definition__content\">\r\n<div class=\"uniq-welfare-data\">\r\n<p class=\"uniq-welfare-text\"><em>17.1</em>％</p>\r\n</div>\r\n<div class=\"uniq-welfare-layout-media\">\r\n<img src=\"/careers/recruit/welfare/img/index-img-08.svg\" width=\"197\" height=\"139\" alt=\"\" decoding=\"async\" loading=\"lazy\">\r\n<!--  /.uniq-welfare-layout-media  --></div>\r\n</dd>\r\n<!--  /.uniq-welfare-list-definition  --></dl>\r\n<!--  /.m-layout-grid__col  --></div>\r\n\r\n<!--  /.m-layout-grid  --></div>\r\n\r\n<ul class=\"m-list-note\">\r\n<li class=\"m-list-note__item\"><span class=\"m-list-note__symbol\">※</span><div class=\"m-list-note__content\">上記は2025年末のものです。</div></li>\r\n<li class=\"m-list-note__item\"><span class=\"m-list-note__symbol\">※1</span><div class=\"m-list-note__content\">育児休業等を取得した社員の人数/本人もしくは配偶者が出産した社員の人数</div></li>\r\n<li class=\"m-list-note__item\"><span class=\"m-list-note__symbol\">※2</span><div class=\"m-list-note__content\">正社員かつ受出向者を除く</div></li>\r\n<!--  /.m-list-note  --></ul>\r\n\r\n<!--  /.str-section__inner  --></div>\r\n<!--  /.str-section  --></div></main>\r\n\r\n<nav class=\"str-breadcrumb str-breadcrumb--bottom\" aria-label=\"breadcrumb\">\r\n<ol class=\"str-breadcrumb__list\">\r\n<li class=\"str-breadcrumb__item\"><a href=\"/careers/recruit/\" class=\"str-breadcrumb__text str-breadcrumb__text--top\"><span class=\"str-breadcrumb__label\">ホーム<