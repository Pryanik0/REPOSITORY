ore {  left: 40px; } .service-list li .tooltip.right:before {  left: auto;  right: 20px; } .service-list li.active .service-icon {  background: #b1c127; } .service-list li.active .service-icon .icon-service {  fill: #ffffff; } .service-list li.active .tooltip {  opacity: 1;  top: 95px; } .bubble {  display: block;  text-align: center;  margin-bottom: 100px;  position: relative; } .bubble p {  display: inline-block;  background: #e4ec99;  margin: 0;  padding: 30px 35px;  border-radius: 20px;  font-size: 24px; } .bubble:after {  content: '';  width: 0;  height: 0;  border-style: solid;  border-width: 23px 26px 0 0;  border-color: #e4ec99 transparent transparent transparent;  position: absolute;  bottom: -23px;  left: 25%; } @media screen and (max-width: 969px) {  .header .header-title {  bottom: 0;  font-size: 18px;  }  .main {  padding-right: 20px;  width: calc(100% - 230px);  }  .sidebar {  width: 230px;  padding-left: 20px;  } } @media screen and (max-width: 767px) {  .header .header-title {  position: relative;  }  .logo img {  height: 44px;  width: auto;  }  .top {  margin: 30px 0 40px;  }  h1 {  font-size: 24px;  margin-bottom: 10px;  }  h2 {  font-size: 15px;  margin: 30px 0 20px;  }  .subtitle {  margin-bottom: 30px;  }  .main {  order: 1;  width: 100%;  padding: 0;  border-right: 0;  }  .sidebar {  text-align: center;  width: 100%;  padding: 0;  order: 3;  }  .social {  display: flex;  flex-wrap: wrap;  justify-content: center;  }  .social .title {  flex-basis: 100%;  }  .services {  order: 2;  }  .link-list {  display: flex;  flex-wrap: wrap;  justify-content: space-around;  }  .link-list li a {  white-space: nowrap;  }  .bubble {  margin-top: 30px;  }  .bubble p {  font-size: 18px;  padding: 20px;  } } @media print {  body {  margin: 0;  padding: 0;  -webkit-print-color-adjust: exact;  }  .wrapper {  padding: 0;  margin: 0;  }  .header .header-title {  background-color: rgba(188, 207, 0, 0.9) !important;  -webkit-print-color-adjust: exact;  }  .service-list