  "text": "<!doctype html>\n\r\n<html lang=\"ja\">\r\n<head>\r\n<script src=\"//nexus.ensighten.com/kirin/prod_kyowakirin-co-jp/Bootstrap.js\"></script>\r\n<meta charset=\"UTF-8\">\r\n<meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\r\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n<title>上市に向けた奮闘物語｜プロジェクトストーリー｜採用情報サイト｜協和キリン株式会社</title>\r\n<meta name=\"description\" content=\"製薬会社・協和キリンの採用情報ウェブサイトです。新卒採用情報、キャリア採用情報、障害者採用情報、グループ各企業の採用情報を公開しています。\">\r\n<meta property=\"og:type\" content=\"website\">\r\n<meta property=\"og:image\" content=\"https://www.kyowakirin.co.jp/careers/recruit/share/img/ogp.png\">\r\n<meta property=\"og:title\" content=\"上市に向けた奮闘物語｜プロジェクトストーリー｜採用情報サイト｜協和キリン株式会社\">\r\n<meta property=\"og:description\" content=\"製薬会社・協和キリンの採用情報ウェブサイトです。新卒採用情報、キャリア採用情報、障害者採用情報、グループ各企業の採用情報を公開しています。\">\r\n<link rel=\"shortcut icon\" href=\"/careers/recruit/share/img/favicon.ico\">\r\n<link rel=\"apple-touch-icon\" href=\"/careers/recruit/share/img/apple_touch_icon.png\">\r\n<link rel=\"canonical\" href=\"https://www.kyowakirin.co.jp/careers/recruit/project/project03/\">\r\n<link rel=\"preconnect\" href=\"https://www.googletagmanager.com\">\r\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\r\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"\">\r\n<link rel=\"preload\" as=\"style\" href=\"/careers/recruit/project/css/project-detail.css\">\r\n\r\n<link href=\"https://fonts.googleapis.com/css2?family=Hind+Madurai:wght@400;500;600;700&amp;display=swap\" rel=\"stylesheet\">\r\n<link rel=\"stylesheet\" href=\"/careers/recruit/share/css/common.css?20261119121404442\">\r\n<link rel=\"stylesheet\" href=\"/careers/recruit/project/css/project-detail.css?20261119121404442\">\r\n<script src=\"/careers/recruit/share/js/init.js?20261119121404442\"></script>\r\n<script type=\"module\" src=\"/careers/recruit/share/js/common.js?20261119121404442\" crossorigin=\"\"></script>\r\n<!--  Google Tag Manager 