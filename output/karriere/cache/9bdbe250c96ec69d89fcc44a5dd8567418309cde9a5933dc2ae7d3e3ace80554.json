  "text": "<!doctype html>\n\r\n<html lang=\"ja\">\r\n<head>\r\n<script src=\"//nexus.ensighten.com/kirin/prod_kyowakirin-co-jp/Bootstrap.js\"></script>\r\n<meta charset=\"UTF-8\">\r\n<meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\r\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n<title>採用情報サイト｜協和キリン株式会社</title>\r\n<meta name=\"description\" content=\"製薬会社・協和キリンの採用情報ウェブサイトです。新卒採用情報、キャリア採用情報、障害者採用情報、グループ各企業の採用情報を公開しています。\">\r\n<meta property=\"og:type\" content=\"website\">\r\n<meta property=\"og:image\" content=\"https://www.kyowakirin.co.jp/careers/recruit/share/img/ogp.png\">\r\n<meta property=\"og:title\" content=\"採用情報サイト｜協和キリン株式会社\">\r\n<meta property=\"og:description\" content=\"製薬会社・協和キリンの採用情報ウェブサイトです。新卒採用情報、キャリア採用情報、障害者採用情報、グループ各企業の採用情報を公開しています。\">\r\n<link rel=\"shortcut icon\" href=\"/careers/recruit/share/img/favicon.ico\">\r\n<link rel=\"apple-touch-icon\" href=\"/careers/recruit/share/img/apple_touch_icon.png\">\r\n<link rel=\"canonical\" href=\"https://www.kyowakirin.co.jp/careers/recruit/\">\r\n<link rel=\"preconnect\" href=\"https://www.googletagmanager.com\">\r\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\r\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"\">\r\n<link rel=\"preload\" as=\"image\" href=\"/careers/recruit/img/index-mv-01.jpg\">\r\n<link rel=\"preload\" as=\"style\" href=\"/careers/recruit/css/top.css\">\r\n<link rel=\"preload\" as=\"script\" href=\"/careers/recruit/js/top.js\">\r\n\r\n<link href=\"https://fonts.googleapis.com/css2?family=Hind+Madurai:wght@400;500;600;700&amp;display=swap\" rel=\"stylesheet\">\r\n<link rel=\"stylesheet\" href=\"/careers/recruit/share/css/common.css?20261119121404442\">\r\n<link rel=\"stylesheet\" href=\"/careers/recruit/css/top.css?20261119121404442\">\r\n<script src=\"/careers/recruit/share/js/init.js?20261119121404442\"></script>\r\n<script type=\"module\" src=\"/careers/recruit/share/js/common.js?20261119121404442\" crossorigin=\"\"></script>\r\n<script type=\"module\" src=\"/careers/recruit/js/top.js?20261119121404442\" crossorigin=\"\"></script>\r\n<!--  Google Tag Manager  -->\r\n<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':\r\nnew Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],\r\nj=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=\r\n'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);\r\n})(window,document,'script','dataLayer','GTM-5BDMWGT');</script>\r\n<!--  End Google Tag Manager  --></head>\r\n<body id=\"top\">\r\n<!--  Google Tag Manager (noscript)  -->\r\n<noscript><iframe src=\"https://www.googletagmanager.com/ns.html?id=GTM-5BDMWGT\" height=\"0\" width=\"0\" style=\"display:none;visibility:hidden\"></iframe></noscript>\r\n<!--  End Google Tag Manager (noscript)  --><!--  /careers/recruit/share/inc/header.html include start  -->\r\n<div class=\"inc_careers_recruit_share_inc_header\">\r\n<header id=\"str-header\" class=\"str-header\">\r\n<div class=\"str-header__body\">\r\n<div class=\"str-header-logo\">\r\n<a href=\"/careers/recruit/\" class=\"str-header-logo__body\">\r\n<img src=\"/careers/recruit/share/img/logo-main.svg\" alt=\"KYOWA KIRIN\" width=\"221\" height=\"36\" class=\"str-header-logo__item\">\r\n<span class=\"str-header-logo__title\">Recruiting</span>\r\n</a>\r\n<!--  /.str-header-logo  --></div>\r\n\r\n<ul class=\"str-header-link\">\r\n<li class=\"str-header-link__item\"><a href=\"https://mypage.3010.i-webs.jp/kyowakirin2028/\" target=\"_blank\" class=\"str-header-link__link str-header-link__link--main str-header-link__link--new\">新卒 2028年卒<span>ENTRY・MY PAGE<svg class=\"m-icon m-icon--blank-default-white\" role=\"img\" aria-label=\"別窓で開く\"><use href=\"#icon-blank-default\"></use></svg></span></a></li>\r\n<li class=\"str-header-link__item\"><a href=\"https://mypage.3010.i-webs.jp/kyowakirin2027/\" target=\"_blank\" class=\"str-header-link__link str-header-link__link--main str-header-link__link--mid\">新卒 2027年卒<span>ENTRY・MY PAGE<svg class=\"m-icon m-icon--blank-default-white\" role=\"img\" aria-label=\"別窓で開く\"><use href=\"#icon-blank-default\"></use></svg></span></a></li>\r\n<li class=\"str-header-link__item\"><a href=\"https://hrmos.co/pages/kyowakirin\" target=\"_blank\" class=\"str-header-link__link\"><span>キャリア採用<svg class=\"m-icon m-icon--blank-default\" role=\"img\" aria-label=\"別窓で開く\"><use href=\"#icon-blank-default\"></use></svg></span></a></li>\r\n<li class=\"str-header-link__item\"><a href=\"/careers/recruit/handicapped/\" class=\"str-header-link__link\">障害をお持ちの方</a></li>\r\n<!--  /.str-header-link  --></ul>\r\n\r\n<button type=\"button\" class=\"str-header-menu\"><span class=\"js-gnav-btn-label\">MENU</span></button>\r\n<!--  /.str-header__body  --></div>\r\n\r\n<nav class=\"str-nav\" aria-label=\"global navigation\">\r\n<div class=\"str-nav__body\">\r\n<div class=\"str-nav__item\">\r\n<p class=\"str-nav__title js-gnav-toggle-btn\">Company（協和キリンについて）</p>\r\n\r\n<div class=\"str-nav-menu\">\r\n<div class=\"str-nav-menu__body\">\r\n<ul class=\"str-nav-menu-link\" data-col=\"1\" data-col-wide=\"3\">\r\n<li class=\"str-nav-menu-link__item\"><a href=\"/careers/recruit/ambition/\" class=\"str-nav-menu-link__link\">私たちの志</a></li>\r\n<li class=\"str-nav-menu-link__item\"><a href=\"/careers/recruit/company/\" class=\"str-nav-menu-link__link\">vision</a></li>\r\n</ul>\r\n<!--  /.str-nav-menu__body  --></div>\r\n<!--  /.str-nav-menu  --></div>\r\n<!--  /.str-nav__item  --></div>\r\n\r\n<div class=\"str-nav__item\">\r\n<p class=\"str-nav__title js-gnav-toggle-btn\">People&amp;Job（人と仕事）</p>\r\n\r\n<div class=\"str-nav-menu\">\r\n<div class=\"str-nav-menu__body\">\r\n<ul class=\"str-nav-menu-link\" data-col=\"1\" data-col-wide=\"3\">\r\n<li class=\"str-nav-menu-link__item\"><a href=\"/careers/recruit/interview/\" class=\"str-nav-menu-link__link\">社員インタビュー</a></li>\r\n<li class=\"str-nav-menu-link__item\"><a href=\"/careers/recruit/personality/\" class=\"str-nav-menu-link__link\">【新卒向け】求める人材像</a></li>\r\n<li class=\"str-nav-menu-link__item\"><a href=\"/careers/recruit/work/\" class=\"str-nav-menu-link__link\">【新卒向け】職種紹介</a></li>\r\n<li class=\"str-nav-menu-link__item\"><a href=\"/careers/recruit/project/\" class=\"str-nav-menu-link__link\">プロジェクトストーリー</a></li>\r\n</ul>\r\n<!--  /.str-nav-menu__body  --></div>\r\n<!--  /.str-nav-menu  --></div>\r\n<!--  /.str-nav__item  --></div>\r\n\r\n<div class=\"str-nav__item\">\r\n<p class=\"str-nav__title js-gnav-toggle-btn\">Work Style（働く環境）</p>\r\n\r\n<div class=\"str-nav-menu\">\r\n<div class=\"str-nav-menu__body\">\r\n<ul class=\"str-nav-menu-link\" data-col=\"1\" data-col-wide=\"3\">\r\n<li class=\"str-nav-menu-link__item\"><a href=\"/careers/recruit/office/\" class=\"str-nav-menu-link__link\">国内拠点紹介</a></li>\r\n<li class=\"str-nav-menu-link__item\"><a href=\"/careers/recruit/interviewmovie/\" class=\"str-nav-menu-link__link\">女性の経営職</a></li>\r\n<li class=\"str-nav-menu-link__item\"><a href=\"/careers/recruit/training/\" class=\"str-nav-menu-link__link\">人材育成</a></li>\r\n<li class=\"str-nav-menu-link__item\"><a href=\"/careers/recruit/welfare/\" class=\"str-nav-menu-link__link\">福利厚生</a></li>\r\n<li class=\"str-nav-menu-link__item\"><a href=\"https://www.kyowakirin.co.jp/sustainability/human_resources_infrastructure/dei/index.html\" target=\"_blank\" class=\"str-nav-menu-link__link\">ダイバーシティへの取り組み<svg class=\"m-icon m-icon--blank-default\" role=\"img\" aria-label=\"別窓で開く\"><use href=\"#icon-blank-default\"></use></svg></a></li>\r\n<li class=\"str-nav-menu-link__item\"><a href=\"https://www.kyowakirin.co.jp/sustainability/human_resources_infrastructure/portfolio/workplace_safety/index.html\" target=\"_blank\" class=\"str-nav-menu-link__link\">健康経営<svg class=\"m-icon m-icon--blank-default\" role=\"img\" aria-label=\"別窓で開く\"><use href=\"#icon-blank-default\"></use></svg></a></li>\r\n</ul>\r\n<!--  /.str-nav-menu__body  --></div>\r\n<!--  /.str-nav-menu  --></div>\r\n<!--  /.str-nav__item  --></div>\r\n\r\n<div class=\"str-nav__item\">\r\n<p class=\"str-nav__title js-gnav-toggle-btn\">Cross Talk（クロストーク）</p>\r\n\r\n<div class=\"str-nav-menu\">\r\n<div class=\"str-nav-menu__body\">\r\n<ul class=\"str-nav-menu-link\" data-col=\"1\" data-col-wide=\"3\">\r\n<li class=\"str-nav-menu-link__item\"><a href=\"/careers/recruit/talk/03.html\" class=\"str-nav-menu-link__link\">患者さんの声を大切に形にする活動</a></li>\r\n<li class=\"str-nav-menu-link__item\"><a href=\"/careers/recruit/talk/02.html\" class=\"str-nav-menu-link__link\">協和キリンのグローバル化</a></li>\r\n</ul>\r\n<!--  /.str-nav-menu__body  --></div>\r\n<!--  /.str-nav-menu  --></div>\r\n<!--  /.str-nav__item  --></div>\r\n\r\n<div class=\"str-nav__item\">\r\n<p class=\"str-nav__title js-gnav-toggle-btn\">Recruit（採用情報）</p>\r\n\r\n<div class=\"str-nav-menu\">\r\n<div class=\"str-nav-menu__body\">\r\n<ul class=\"str-nav-menu-link\" data-col=\"1\" data-col-wide=\"3\">\r\n<li class=\"str-nav-menu-link__item\"><a href=\"/careers/recruit/guideline/\" class=\"str-nav-menu-link__link\">新卒採用</a></li>\r\n<li class=\"str-nav-menu-link__item\"><a href=\"https://hrmos.co/pages/kyowakirin\" target=\"_blank\" class=\"str-nav-menu-link__link\">キャリア採用<svg class=\"m-icon m-icon--blank-default\" role=\"img\" aria-label=\"別窓で開く\"><use href=\"#icon-blank-default\"></use></svg></a></li>\r\n<li class=\"str-nav-menu-link__item\"><a href=\"/careers/recruit/handicapped/\" class=\"str-nav-menu-link__link\">障害者採用</a></li>\r\n<li class=\"str-nav-menu-link__item\"><a href=\"/careers/recruit/faq/\" class=\"str-nav-menu-link__link\">FAQ</a></li>\r\n</ul>\r\n<!--  /.str-nav-menu__body  --></div>\r\n<!--  /.str-nav-menu  --></div>\r\n<!--  /.str-nav__item  --></div>\r\n\r\n<!--  /.str-nav__body  --></div>\r\n<!--  /.str-nav  --></nav>\r\n<!--  /.str-header  --></header>\r\n</div>\r\n<!--  /careers/recruit/share/inc/header.html include end  -->\r\n\r\n<main class=\"str-main\">\r\n\r\n\r\n<div class=\"uniq-top-wrapper\">\r\n\r\n<div class=\"uniq-top-mv js-top-mv-animation-root\">\r\n<div class=\"uniq-top-mv__body\">\r\n<div class=\"uniq-top-mv__inner\">\r\n<div class=\"uniq-top-mv__content\">\r\n<h1 class=\"uniq-top-mv__title\"><span class=\"uniq-top-mv__animation-text uniq-top-mv__animation-text--first\">Commitment</span><br aria-hidden=\"true\"> <span class=\"uniq-top-mv__animation-text uniq-top-mv__animation-text--second\">to Life</span></h1>\r\n<p class=\"uniq-top-mv__lead uniq-top-mv__animation-text uniq-top-mv__animation-text--third\">たった一度の、いのちと歩く。</p>\r\n\r\n<button type=\"button\" id=\"js-top-mv-slideshow-btn\" class=\"uniq-top-mv__btn\"><span></span></button>\r\n<!--  /.uniq-top-mv__content  --></div>\r\n<!--  /.uniq-top-mv__inner  --></div>\r\n<!--  /.uniq-top-mv__body  --></div>\r\n\r\n<div id=\"js-top-mv-slideshow\" class=\"uniq-top-mv__bg splide\">\r\n<div class=\"uniq-top-mv-slider splide__track\">\r\n<ul class=\"uniq-top-mv-slider__body splide__list\">\r\n<li class=\"uniq-top-mv-slider__slide splide__slide\"><img src=\"/careers/recruit/img/index-mv-01.jpg\" width=\"1440\" height=\"815\" alt=\"\" decoding=\"async\"></li>\r\n<li class=\"uniq-top-mv-slider__slide splide__slide\"><img src=\"/careers/recruit/img/index-mv-03.jpg\" width=\"1440\" height=\"815\" alt=\"\" decoding=\"async\" loading=\"lazy\"></li>\r\n<li class=\"uniq-top-mv-slider__slide splide__slide\"><img src=\"/careers/recruit/img/index-mv-02.jpg\" width=\"1440\" height=\"815\" alt=\"\" decoding=\"async\" loading=\"lazy\"></li>\r\n</ul>\r\n</div>\r\n<!--  /.uniq-top-mv__bg  --></div>\r\n\r\n<div class=\"uniq-top-mv__animation-overlay js-top-mv-animation-last\"></div>\r\n<!--  /.uniq-top-mv  --></div>\r\n\r\n<div class=\"uniq-top-section uniq-top-section--info-news\">\r\n<div class=\"uniq-top-section__inner\">\r\n<h2 class=\"uniq-top-hdg-info\">INFORMATION</h2>\r\n<ul class=\"uniq-top-info-list\">\r\n<li class=\"uniq-top-info-list__item\">SNSにおける当社情報の発信はすべて当社公式のアカウントを通じて行っております。当社の公式アカウントは<a href=\"/\">当社Webサイト</a>でご確認ください。<br>\r\nこれらのアカウント以外で発信されている採用関連情報は、事実と異なる可能性がありますのでご注意ください。</li>\r\n</ul>\r\n</div>\r\n</div>\r\n\r\n<div class=\"uniq-top-section uniq-top-section--company\">\r\n<div class=\"uniq-top-section__inner\">\r\n<h2 class=\"top-hdg-lv2 js-observe-target js-observe-target--fade-in-up\">Company<span class=\"top-hdg-lv2__sub\">協和キリンについて</span></h2>\r\n\r\n<div class=\"uniq-top-company js-observe-target js-observe-target--fade-in-up\">\r\n<h3 class=\"uniq-top-hdg-lv3\">私たちの志</h3>\r\n\r\n<div class=\"uniq-top-company__content\">\r\n<p class=\"uniq-top-text\">病気と闘うすべての人に笑顔を届けるために、いのちにまっすぐ真摯に向き合うこと。</p>\r\n<p class=\"uniq-top-text\">そして医療関係者とともに、いのちと歩み続ける。</p>\r\n<p class=\"uniq-top-text\">ここには1,000人を超える社員が、年齢や職種の壁を越えて製薬会社で働く者としての思いを込めた『私たちの志』があります。</p>\r\n\r\n<ul class=\"m-list-link m-list-link--large\">\r\n<li class=\"m-list-link__item\"><a href=\"/careers/recruit/ambition/\" class=\"m-list-link__link\"><span class=\"m-list-link__text\">詳細はこちら</span></a></li>\r\n<!--  /.m-list-link  --></ul>\r\n</div>\r\n<!--  /.uniq-top-company  --></div>\r\n\r\n<img src=\"/careers/recruit/img/index-element-02.svg\" width=\"692\" height=\"542\" alt=\"\" class=\"uniq-top-element-02 js-observe-target js-observe-target--fade-in-up\" decoding=\"async\" loading=\"lazy\">\r\n<!--  /.uniq-top-section__inner  --></div>\r\n<!--  /.uniq-top-section  --></div>\r\n\r\n<div class=\"uniq-top-section uniq-top-section--vision\">\r\n<div class=\"uniq-top-section__inner\">\r\n\r\n<div class=\"uniq-top-vision js-observe-target js-observe-target--fade-in-up\">\r\n<h3 class=\"uniq-top-hdg-lv3\">Vision</h3>\r\n\r\n<div class=\"uniq-top-vision__content\">\r\n<p class=\"uniq-top-text\">かけがえのないいのちのためにできることを。挑戦と革新を続ける協和キリンをご紹介します。</p>\r\n\r\n<ul class=\"m-list-link m-list-link--large\">\r\n<li class=\"m-list-link__item\"><a href=\"/careers/recruit/company/\" class=\"m-list-link__link\"><span class=\"m-list-link__text\">詳細はこちら</span></a></li>\r\n<!--  /.m-list-link  --></ul>\r\n</div>\r\n<!--  /.uniq-top-vision  --></div>\r\n\r\n<img src=\"/careers/recruit/img/index-element-01.jpg\" width=\"746\" height=\"704\" alt=\"\" class=\"uniq-top-element-01 js-observe-target js-observe-target--fade-in-up\" decoding=\"async\" loading=\"lazy\">\r\n<!--  /.uniq-top-section__inner  --></div>\r\n<!--  /.uniq-top-section  --></div>\r\n\r\n<div class=\"uniq-top-section uniq-top-section--people\">\r\n<div class=\"uniq-top-section__inner uniq-top-section__inner--middle\">\r\n<h2 id=\"carousel-heading\" class=\"top-hdg-lv2 top-hdg-lv2--text-left js-observe-target js-observe-target--fade-in-up\">People &amp; Job<span class=\"top-hdg-lv2__sub\">人と仕事</span></h2>\r\n\r\n<div class=\"uniq-top-carousel\">\r\n<div class=\"uniq-top-carousel__body\">\r\n<div id=\"js-top-slider\" class=\"splide uniq-top-carousel-main is-right-full js-observe-target js-observe-target--fade-in-up js-observe-target--fase-up\" aria-labelledby=\"carousel-heading\">\r\n<div class=\"splide__track uniq-top-carousel-main__body\">\r\n<ul class=\"splide__list uniq-top-carousel-main__inner\">\r\n<li class=\"splide__slide uniq-top-carousel-main__slide\">\r\n<a href=\"/careers/recruit/interview/people01/\" class=\"uniq-top-card\">\r\n<div class=\"uniq-top-card__content\">\r\n<h3 class=\"uniq-top-card__title\">「今日の楽しみ」を抱え出社し、研究と向き合う</h3>\r\n<p class=\"uniq-top-card__about\">研究開発本部 トランスレーショナルリサーチユニット 安全性研究所</p>\r\n<p class=\"uniq-top-card__name\"><span class=\"uniq-top-card__label uniq-top-card__label--label-orange\">新卒：研究</span>弓桁 洋</p>\r\n<ul class=\"uniq-top-card__tag\">\r\n<li class=\"uniq-top-card__tag-item\"><span>#</span>新卒</li>\r\n<li class=\"uniq-top-card__tag-item\"><span>#</span>富士リサーチパーク</li>\r\n<li class=\"uniq-top-card__tag-item\"><span>#</span>研究</li>\r\n</ul>\r\n<!--  /.uniq-top-card__content  --></div>\r\n<div class=\"uniq-top-card__media\">\r\n<img src=\"/careers/recruit/share/img/interview/img-people01.jpg\" alt=\"\" width=\"440\" height=\"462\" decoding=\"async\" loading=\"lazy\">\r\n<!--  /.uniq-top-card__media  --></div>\r\n<!--  /.uniq-top-card  --></a>\r\n</li>\r\n<li class=\"splide__slide uniq-top-carousel-main__slide\">\r\n<a href=\"/careers/recruit/interview/people08/\" class=\"uniq-top-card\">\r\n<div class=\"uniq-top-card__content\">\r\n<h3 class=\"uniq-top-card__title\">苦手な英語を克服し、海外メンバーと働く今</h3>\r\n<p class=\"uniq-top-card__about\">ファーマコビジランス本部 PVオペレーション部</p>\r\n<p class=\"uniq-top-card__name\"><span class=\"uniq-top-card__label uniq-top-card__label--label-lightgreen\">新卒：ファーマコビジランス</span>東 真琴</p>\r\n<ul class=\"uniq-top-card__tag\">\r\n<li class=\"uniq-top-card__tag-item\"><span>#</span>新卒</li>\r\n<li class=\"uniq-top-card__tag-item\"><span>#</span>本社</li>\r\n<li class=\"uniq-top-card__tag-item\"><span>#</span>ファーマコビジランス</li>\r\n</ul>\r\n<!--  /.uniq-top-card__content  --></div>\r\n<div class=\"uniq-top-card__media\">\r\n<img src=\"/careers/recruit/share/img/interview/img-people08.jpg\" alt=\"\" width=\"440\" height=\"462\" decoding=\"async\" loading=\"lazy\">\r\n<!--  /.uniq-top-card__media  --></div>\r\n<!--  /.uniq-top-card  --></a>\r\n</li>\r\n<li class=\"splide__slide uniq-top-carousel-main__slide\">\r\n<a href=\"/careers/recruit/interview/people16/\" class=\"uniq-top-card\">\r\n<div class=\"uniq-top-card__content\">\r\n<h3 class=\"uniq-top-card__title\">一度しかない人生を全うするため、MRに</h3>\r\n<p class=\"uniq-top-card__about\">営業本部 東京支店 東京第1営業所</p>\r\n<p class=\"uniq-top-card__name\"><span class=\"uniq-top-card__label uniq-top-card__label--label-green\">新卒：営業</span>長谷川 公介</p>\r\n<ul class=\"uniq-top-card__tag\">\r\n<li class=\"uniq-top-card__tag-item\"><span>#</span>新卒</li>\r\n<li class=\"uniq-top-card__tag-item\"><span>#</span>営業支店</li>\r\n<li class=\"uniq-top-card__tag-item\"><span>#</span>営業</li>\r\n</ul>\r\n<!--  /.uniq-top-card__content  --></div>\r\n<div class=\"uniq-top-card__media\">\r\n<img src=\"/careers/recruit/share/img/interview/img-people16.jpg\" alt=\"\" width=\"440\" height=\"462\" decoding=\"async\" loading=\"lazy\">\r\n<!--  /.uniq-top-card__media  --></div>\r\n<!--  /.uniq-top-card  --></a>\r\n</li>\r\n<li class=\"splide__slide uniq-top-carousel-main__slide\">\r\n<a href=\"/careers/recruit/interview/people18/\" class=\"uniq-top-card\">\r\n<div class=\"uniq-top-card__content\">\r\n<h3 class=\"uniq-top-card__title\">世界中のメンバーを理解し支えるグローバル人事</h3>\r\n<p class=\"uniq-top-card__about\">人事部グローバル人事G</p>\r\n<p class=\"uniq-top-card__name\"><span class=\"uniq-top-card__label uniq-top-card__label--label-blue\">新卒：コーポレートスタッフ</span>長岡 桜子</p>\r\n<ul class=\"uniq-top-card__tag\">\r\n<li class=\"uniq-top-card__tag-item\"><span>#</span>新卒</li>\r\n<li class=\"uniq-top-card__tag-item\"><span>#</span>本社</li>\r\n<li class=\"uniq-top-card__tag-item\"><span>#</span>コーポレート</li>\r\n</ul>\r\n<!--  /.uniq-top-card__content  --></div>\r\n<div class=\"uniq-top-card__media\">\r\n<img src=\"/careers/recruit/share/img/interview/img-people18.jpg\" alt=\"\" width=\"440\" height=\"462\" decoding=\"async\" loading=\"lazy\">\r\n<!--  /.uniq-top-card__media  --></div>\r\n<!--  /.uniq-top-card  --></a>\r\n</li>\r\n</ul>\r\n</div>\r\n\r\n<div class=\"splide__arrows uniq-top-carousel-main-controls\">\r\n<button type=\"button\" class=\"splide__arrow splide__arrow--prev uniq-top-carousel-main-controls__prev\">\r\n<svg xmlns=\"http://www.w3.org/2000/svg\" viewbox=\"0 0 72 72\">\r\n<g transform=\"translate(-3385 -4312.313)\">\r\n<circle cx=\"36\" cy=\"36\" r=\"34\" transform=\"translate(3385 4312.313)\" fill=\"#fff\" stroke=\"#c9cccd\" stroke-width=\"3\"></circle>\r\n<circle cx=\"36\" cy=\"36\" r=\"34\" transform=\"translate(3385 4312.313)\" fill=\"#fff\" stroke=\"#ea5504\" stroke-width=\"3\"></circle>\r\n<path d=\"m3424.287 4353.952-1-.973 3.891-3.891H3415v-1.39h12.182l-3.914-3.914 1-.973 5.582 5.581Z\" fill=\"#ea5504\" stroke=\"#ea5504\"></path>\r\n</g>\r\n</svg>\r\n</button>\r\n<p class=\"uniq-top-carousel-main-controls__info js-top-slider-info\"></p>\r\n<button type=\"button\" class=\"splide__arrow splide__arrow--next uniq-top-carousel-main-