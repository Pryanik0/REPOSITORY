async\" loading=\"lazy\">\r\n</div>\r\n<p class=\"m-panel__text\">【新卒】職種紹介</p>\r\n</a>\r\n</li>\r\n\r\n<li class=\"m-panel__item\">\r\n<a href=\"/careers/recruit/project/\" class=\"m-panel__panel\">\r\n<div class=\"m-panel__media\">\r\n<img src=\"/careers/recruit/img/index-img-people&amp;job-02.jpg\" width=\"540\" height=\"360\" alt=\"\" decoding=\"async\" loading=\"lazy\">\r\n</div>\r\n<p class=\"m-panel__text\">プロジェクトストーリー</p>\r\n</a>\r\n</li>\r\n<!--  /.m-panel  --></ul>\r\n\r\n<img src=\"/careers/recruit/img/index-element-03.svg\" width=\"532\" height=\"530\" alt=\"\" class=\"uniq-top-element-03 js-observe-target js-observe-target--fade-in-up\" decoding=\"async\" loading=\"lazy\">\r\n<img src=\"/careers/recruit/img/index-element-04.svg\" width=\"919\" height=\"914\" alt=\"\" class=\"uniq-top-element-04 js-observe-target js-observe-target--fade-in-up\" decoding=\"async\" loading=\"lazy\">\r\n<!--  /.uniq-top-section__inner  --></div>\r\n<!--  /.uniq-top-section  --></div>\r\n\r\n<div class=\"uniq-top-section uniq-top-section--work-style js-observe-target\">\r\n<div class=\"uniq-top-section__inner uniq-top-section__inner--middle\">\r\n<h2 class=\"top-hdg-lv2 top-hdg-lv2--color-white\">Work Style<span class=\"top-hdg-lv2__sub\">働く環境</span></h2>\r\n\r\n<ul class=\"uniq-panel-link-2\" data-col=\"1\" data-col-wide=\"4\">\r\n<li class=\"uniq-panel-link-2__item\">\r\n<a href=\"/careers/recruit/office/\" class=\"uniq-panel-link-2__panel\">\r\n<div class=\"uniq-panel-link-2__media\">\r\n<img src=\"/careers/recruit/img/index-icon-career-office.svg\" width=\"140\" height=\"140\" alt=\"\" decoding=\"async\" loading=\"lazy\">\r\n</div>\r\n<p class=\"uniq-panel-link-2__text\">国内拠点紹介</p>\r\n</a>\r\n</li>\r\n\r\n<li class=\"uniq-panel-link-2__item\">\r\n<a href=\"/careers/recruit/interviewmovie/\" class=\"uniq-panel-link-2__panel\">\r\n<div class=\"uniq-panel-link-2__media\">\r\n<img src=\"/careers/recruit/img/index-icon-interviewmovie.svg\" width=\"140\" height=\"140\" alt=\"\" decoding=\"async\" loading=\"lazy\">\r\n</div>\r\n<p class=\"uniq-panel-link-2__text\">女性の経営職</p>\r\n</a>\r\n</li>\r\n\r\n<li class=\"uniq-panel-link-2__item\">\r\n<a href=\"/careers/recruit/training/\" class=\"uniq-panel-link-2__panel\">\r\n<div class=\"uniq-panel-link-2__media\">\r\n<img src=\"/careers/recruit/img/index-icon-human-resource-development.svg\" width=\"140\" height=\"140\" alt=\"\" decoding=\"async\" loading=\"lazy\">\r\n</div>\r\n<p class=\"uniq-panel-link-2__text\">人材育成</p>\r\n</a>\r\n</li>\r\n\r\n<li class=\"uniq-panel-link-2__item\">\r\n<a href=\"/careers/recruit/welfare/\" class=\"uniq-panel-link-2__panel\">\r\n<div class=\"uniq-panel-link-2__media\">\r\n<img src=\"/careers/recruit/img/index-icon-welfare.svg\" width=\"140\" height=\"140\" alt=\"\" decoding=\"async\" loading=\"lazy\">\r\n</div>\r\n<p class=\"uniq-panel-link-2__text\">福利厚生</p>\r\n</a>\r\n</li>\r\n<!--  /.uniq-panel-link-2  --></ul>\r\n<!--  /.uniq-top-section__inner  --></div>\r\n<!--  /.uniq-top-section  --></div>\r\n\r\n<div class=\"uniq-top-section uniq-top-section--cross-talk\">\r\n<div class=\"uniq-top-section__inner uniq-top-section__inner--middle\">\r\n\r\n<div class=\"uniq-top-cross-talk js-observe-target js-observe-target--fade-in-up\">\r\n<h2 class=\"top-hdg-lv2\">Cross Talk<span class=\"top-hdg-lv2__sub\">クロストーク</span></h2>\r\n\r\n<ul class=\"m-panel uniq-panel-link\" data-col=\"1\" data-col-wide=\"3\">\r\n<li class=\"m-panel__item\">\r\n<a href=\"/careers/recruit/talk/03.html\" class=\"m-panel__panel\">\r\n<div class=\"m-panel__media m-panel__media--large\">\r\n<img src=\"/careers/recruit/img/index-img-crosstalk-03.jpg\" width=\"540\" height=\"360\" alt=\"\" decoding=\"async\" loading=\"lazy\">\r\n</div>\r\n<p class=\"m-panel__text\">患者さんの声を大切に形にする活動</p>\r\n</a>\r\n</li>\r\n\r\n<li class=\"m-panel__item\">\r\n<a href=\"/careers/recruit/talk/02.html\" class=\"m-panel__panel\">\r\n<div class=\"m-panel__media m-panel__media--large\">\r\n<img src=\"/careers/recruit/img/index-img-crosstalk-01.jpg\" width=\"540\" height=\"360\" alt=\"\" decoding=\"async\" loading=\"lazy\">\r\n</div>\r\n<p class=\"m-panel__text\">協和キリンのグローバル化</p>\r\n</a>\r\n</li>\r\n\r\n<!--  /.m-panel  --></ul>\r\n<!--  /.uniq-top-cross-talk  --></div>\r\n\r\n<!--  /.uniq-top-section__inner  --></div>\r\n<!--  /.uniq-top-section  --></div>\r\n\r\n<div class=\"uniq-top-section uniq-top-section--gray uniq-top-section--aside js-observe-target\">\r\n<div class=\"uniq-top-section__inner uniq-top-section__inner--middle\">\r\n<div class=\"m-btn\">\r\n<a href=\"https://www.kyowakirin.co.jp/csr/human_resources/diversity_and_inclusion/index.html\" target=\"_blank\" class=\"m-btn__btn m-btn__btn--blank m-btn__btn--middle m-btn__btn--white m-btn__btn--top\">ダイバーシティへの取り組み<svg class=\"m-icon m-icon--blank\" role=\"img\" aria-label=\"別窓で開く\"><use href=\"#icon-blank\"></use></svg></a>\r\n<a href=\"https://www.kyowakirin.co.jp/csr/human_resources/workplace_safety/index.html\" target=\"_blank\" class=\"m-btn__btn m-btn__btn--blank m-btn__btn--middle m-btn__btn--white m-btn__btn--top\">健康経営<svg class=\"m-icon m-icon--blank\" role=\"img\" aria-label=\"別窓で開く\"><use href=\"#icon-blank\"></use></svg></a>\r\n<!--  /.m-btn  --></div>\r\n<!--  /.uniq-top-section__inner  --></div>\r\n<!--  /.uniq-top-section  --></div>\r\n\r\n<div class=\"uniq-top-section uniq-top-section--recruit\">\r\n<div class=\"uniq-top-section__inner uniq-top-section__inner--middle\">\r\n<div class=\"uniq-top-recruit-body js-observe-target js-observe-target--fade-in-up js-observe-target--fase-up\">\r\n<div class=\"uniq-top-recruit-body__inner\">\r\n<h2 class=\"top-hdg-lv2 top-hdg-lv2--text-left\">Recruit<span class=\"top-hdg-lv2__sub\">採用情報</span></h2>\r\n<p class=\"uniq-top-text\">協和キリンは病気と向き合う人々に笑顔をもたらすLife-changingな価値の創出に向けて、イノベーションへの情熱と多様な個性が輝くチームで、日々新しいチャレンジを続けています。</p>\r\n<p class=\"uniq-top-text\">私たちのビジョンに共感し、自律的に成長を続ける人と共に働きたいと願っています。</p>\r\n<img src=\"/careers/recruit/img/index-element-05.jpg\" width=\"757\" heig