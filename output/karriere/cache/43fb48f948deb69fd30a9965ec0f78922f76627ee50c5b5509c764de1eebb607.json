            \r\n   \r\n\r\n\r\n\n                            \n                        \n                    </div>\n                    <div class=\"col-12 col-md-6 col-lg-5\">\n                        \n                            \n                                \r\n\r\n\r\n\r\n        \r\n\r\n                <div id=\"c3592\"\r\n                    class=\"frame frame-default frame-type-text frame-layout-0\">\r\n                    \r\n                    \r\n                        \n\n\n\r\n                    \r\n                    \r\n                        \n\n    \n        <header>\n            \r\n\r\n    \r\n            <h1 class=\"\">\r\n                Karriere mit Sinn – Arbeiten bei KOB\r\n            </h1>\r\n        \r\n\r\n\r\n\n            \n\n\n\n            \n\n\n\n        </header>\n    \n\n\n\r\n                    \r\n                    \r\n\r\n    <p>Sichere Perspektiven, vielfältige Berufe und die Möglichkeit, etwas zu bewirken: Tragen Sie mit Ihrer Arbeit dazu bei, dass Medizinprodukte täglich weltweit verfügbar sind.</p>\r\n\r\n\r\n                    \r\n                        \n\n\n\r\n                    \r\n                    \r\n                        \n\n\n\r\n                    \r\n                </div>\r\n\r\n            \r\n   \r\n\r\n\r\n\n                            \n                        \n                    </div>\n                </div>\n            </div>\n        </section>\n    \r\n        \r\n            \r\n\r\n    \r\n\r\n\r\n\r\n\r\n\r\n        <section id=\"c3598\" class='multirow pl-three h-full default'>\r\n            <div class=\"grid\">\r\n                \r\n                    <div class=\"row\">\r\n                        <div class=\"header  col-12\">\r\n                            \r\n\r\n    \r\n            \r\n                \r\n\r\n    \r\n            <h2 class=\"ce-headline\">\r\n                Mehr als ein Arbeitsplatz …\r\n            </h2>\r\n        \r\n\r\n\r\n\r\n            \r\n  