temscope itemtype=\"http://schema.org/JobPosting\">\n        \n<div style=\"display:none;\">\n    \n    <span itemprop=\"datePosted\">2026-11-23T01:10:06+01:00</span>\n\n    <span itemprop=\"directApply\" content=\"true\"></span>\n    \n    <span itemprop=\"url\">https://www.mein-check-in.de/westerwaldkreis?position=542292</span>\n\n    <span itemprop=\"employmentType\">stellenangebote</span>\n    \n        \t<span itemprop=\"validThrough\">2026-12-20T23:59:59+01:00</span>\n    \n    <span itemprop=\"identifier\" itemscope itemtype=\"http://schema.org/PropertyValue\">\n        <span itemprop=\"name\">CHECK-IN</span>\n        <span itemprop=\"value\">www.mein-check-in.de#p542292</span>\n    </span>\n\n    <span itemprop=\"hiringOrganization\" itemscope itemtype=\"http://schema.org/Organization\">\n        <span itemprop=\"name\">Westerwaldkreis</span>\n        <span itemprop=\"url\">https://www.mein-check-in.de/westerwaldkreis</span>\n        \n                    </span>\n\n    </div>\n \t        \t\n    \t    \t\n        <div class=\"description_title block\">\n    \t    \t<h2 itemprop=\"title\">Sachbearbeiter (m/w/d) für das Jobcenter Westerwald </h2>\n        <p class=\"link_pdf\">        \t<a class=\"link_pdf\"\n        \t\thref=\"/westerwaldkreis/position-pdf/id/542292\"\n        \t\ttitle=\"Stellenausschreibung als PDF\">(PDF)</a>\n        </p>\n        \n        </div>\n\n                \n                <div class=\"item_action_top\" >\n        \t<a class=\"button\" href=\"/westerwaldkreis/nojavascript\"\n        \t\tonclick=\"document.forms['form-542292'].submit(); return false;\">\n        \t\t<span>Jetzt hier bewerben</span>\n        \t</a>\n        </div>\n                \n        \n        <div class=\"description_content\" itemprop=\"description\">\n \t\t<p style=\"text-align:justify\"><span style=\"color:black\">Die </span><span style=\"color:black\"><strong>Kreisverwaltung des Westerwaldkreises </strong></span><span style=\"color:black\">sucht </span><span style=\"color:black\"><strong>zum nächstmöglichen Zeitpunkt </strong></span><span style=\"color:black\">einen</span></p>\n\n<p style=\"text-align:center\">&nbsp;</p>\n\n<h3 style=\"text-align:center\"><span style=\"color:black\"><strong>Sachbearbeiter (m/w/d) in der Leistungsgewährung innerhalb des Jobcenters Westerwald.</strong></span></h3>\n\n<p style=\"text-align:left\">&nbsp;</p>\n\n<p style=\"text-align:justify\"><span style=\"color:black\">Der Einsatz ist an einem der Standorte in </span><span style=\"color:black\"><strong>Montabaur, Hachenburg, Höhr-Grenzhausen </strong></span><span style=\"color:black\">oder </span><span style=\"color:black\"><strong>Westerburg</strong></span><span style=\"color:black\"> möglich. </span></p>\n\n<p style=\"text-align:justify\">&nbsp;</p>\n\n<p style=\"text-align:justify\"><span style=\"color:black\">Dem Sachbearbeiter (m/w/d) in der Leistungsgewährung ist ein Arbeitsteam mit mehreren Fachassistenten zugeordnet. Es bestehen insbesondere folgende </span><u><span style=\"color:black\">Aufgabenschwerpunkte</span></u><span style=\"color:black\">:</span></p>\n\n<ul>\n\t<li style=\"text-align:left\"><span style=\"color:black\">Prüfung, Bewilligung und Zahlbarmachung von Anträgen auf Leistungen zum Lebensunterhalt und auf Leistungen für Unterkunft und Heizung, Mehrbedarfe, einmalige Leistungen sowie Leistungen für Bildung und Teilhabe,</span></li>\n\t<li style=\"text-align:left\"><span style=\"color:black\">Geltendmachung vorrangiger Leistungen,</span></li>\n\t<li style=\"text-align:left\"><span style=\"color:black\">persönliche und telefonische Beratung der Antragstellenden zu Leistungsansprüchen,</span></li>\n\t<li style=\"text-align:left\"><span style=\"color:black\">Prüfung etwaiger Aufhebungs- und Erstattungsverfahren sowie Leistungsminderungen,</span></li>\n\t<li style=\"text-align:left\"><span style=\"color:black\">Prüfung und Anordnung der von den Fachassistenten gefertigten Vorgänge,</span></li>\n\t<li style=\"text-align:left\"><span style=\"color:black\">Prüfung von Leistungsanträgen bzw. Sachverhalten mit hohem Schwierigkeitsgrad,</span></li>\n\t<li style=\"text-align:left\"><span style=\"color:black\">Organisation des Arbeitsteams.</span></li>\n</ul>\n\n<p style=\"text-align:justify\">&nbsp;</p>\n\n<p style=\"text-align:justify\"><u><span style=\"color:black\">Das erwarten wir von Ihnen: </span></u></p>\n\n<ul>\n\t<li style=\"text-align:left\"><span style=\"color:black\">Einstellungsvoraussetzung ist eine bestandene Prüfung für den Zugang zum </span><span style=\"color:black\"><strong>dritten Einstiegsamt </strong></span><span style=\"color:black\">in der Laufbahn „Verwaltung und Finanzen“</span> <u><span style=\"color:black\">oder</span></u><span style=\"color:black\"> ein erfolgreich abgeschlossenes Studium mit überwiegend rechtswissenschaftlichen oder verwaltungswissenschaftlichen Schwerpunkt (z. B. Bachelor </span><span style=\"color:black\">of</span><span style=\"color:black\"> Laws) </span><span style=\"color:black\"><strong>oder</strong></span></li>\n\t<li style=\"text-align:left\"><span style=\"color:black\">ein erfolgreicher Abschluss des </span><span style=\"color:black\"><strong>Angestelltenlehrganges II </strong></span><span style=\"color:black\">(Verwaltungsfachwirt (m/w/d)),</span></li>\n\t<li style=\"text-align:justify\"><span style=\"color:black\">Kenntnisse im Leistungsrecht des SGB II sowie Kenntnisse der angrenzenden Rechtsgebiete der Sozialgesetzbücher I-XIV sind von Vorteil, aber keine Voraussetzung,</span></li>\n\t<li style=\"text-align:justify\"><span style=\"color:black\">für die zu besetzende Stelle Sozial- und Persönlichkeitskompetenzen, insbesondere Planungs- und Organisationsfähigkeit sowie Belastbarkeit, </span></li>\n\t<li style=\"text-align:justify\"><span style=\"color:black\">gute EDV-Kenntnisse.</span></li>\n</ul>\n\n<p style=\"text-align:justify\">&nbsp;</p>\n\n<p style=\"text-align:justify\"><u><span style=\"color:black\">Das können wir Ihnen bieten: </span></u></p>\n\n<ul>\n\t<li style=\"text-align:justify\"><span style=\"color:black\">einen sicheren Arbeitsplatz, je nach Vorliegen der persönlichen Voraussetzungen im Beamten- oder Beschäftigungsverhältnis,</span>\n\n\t<ul>\n\t\t<li style=\"text-align:justify\"><span style=\"color:black\">als Beamter (m/w/d) erfolgt die Einstellung im Rahmen einer Versetzung entsprechend dem bislang erreichten Amt oder im unmittelbaren Anschluss an die Ausbildung durch Ernennung; bei entsprechender Bewährung bestehen Aufstiegsmöglichkeiten bis <a href=\"http://www.lff.rlp.de/service/gehaltstabellen\" target=\"_blank\">Besoldungsgruppe A 10 </a></span><a href=\"http://www.lff.rlp.de/service/gehaltstabellen\" target=\"_blank\"><span style=\"color:black\">LBesG</span></a><span style=\"color:black\">,</span></li>\n\t\t<li style=\"text-align:justify\"><span style=\"color:black\">als Beschäftigter (m/w/d): ein unbefristetes Arbeitsverhältnis nach dem Tarifvertrag für den öffentlichen Dienst (TVöD). <a href=\"http://oeffentlicher-dienst.info/c/t/rechner/tvoed/vka?id=tvoed-vka-2026&amp;matrix=1\" target=\"_blank\">Die Eingruppierung ist bei Vorliegen der tariflichen und persönlichen Voraussetzungen bis Entgeltgruppe E 9c TVöD möglich</a>, </span></li>\n\t</ul>\n\t</li>\n\t<li style=\"text-align:justify\"><span style=\"color:black\">eine unbefristete Vollzeitstelle (39 bzw. 40 Std./ Woche), </span></li>\n\t<li style=\"text-align:justify\"><span style=\"color:black\">ein motiviertes, kooperatives, engagiertes Team in einem kollegialen Betriebsklima, </span></li>\n\t<li style=\"text-align:justify\"><span style=\"color:black\">attraktives Gleitzeitangebot und Möglichkeit zur Mobilen Arbeit,</span></li>\n\t<li style=\"text-align:justify\"><span style=\"color:black\">attraktive Möglichkeiten der Entgeltumwandlung, z.B. als Fahrradleasing mit der Übernahme der Versicherungsbeiträge,</span></li>\n\t<li><span style=\"color:black\">weitere Informationen zu diesem Punkt können Sie auf unserer Homepage unter </span><span style=\"color:black\"><a href=\"http://www.westerwaldkreis.de/attraktive-arbeitgeberin\">www.westerwaldkreis.de/attraktive-arbeitgeberin</a></span><span style=\"color:black\"> nachlesen.</span></li>\n</ul>\n\n<p>&nbsp;</p>\n\n<p>&nbsp;</p>\n\n<p style=\"text-align:justify\"><span style=\"color:black\">Schwerbehinderte werden bei gleicher Eignung und Befähigung bevorzugt berücksichtigt. </span></p>\n\n<p style=\"text-align:justify\">&nbsp;</p>\n\n<p style=\"text-align:justify\"><span style=\"color:black\">Der Umwelt zuliebe wünschen wir uns Ihre Bewerbungsunterlagen ausschließlich online über unser Bewerberportal </span></p>\n\n<p style=\"text-align:justify\"><span style=\"color:black\">(</span><span style=\"color:black\"><a href=\"http://www.mein-check-in.de/westerwaldkreis\">www.mein-check-in.de/westerwaldkreis</a></span><span style=\"color:black\">) </span><span style=\"color:black\"><strong>bis zum 20.12.2026</strong></span><span style=\"color:black\">.</span></p>\n\n<p style=\"text-align:justify\">&nbsp;</p>\n\n<p style=\"text-align:justify\"><span style=\"color:black\">Für fachliche Fragen stehen Ihnen Frau Krätz (02602/9491-142) sowie für Fragen zum Auswahlverfahren Frau Habermann (02602/124-633) gerne zur Verfügung. </span></p>\n</div>\n        \t\t\n\t\t\t\t\n\t\t<div class=\"item_action\">\n        \t        \t\t<input type=\"hidden\" name=\"position_group_id\" value=\"2659\" />\n    \t        <input type=\"hidden\" name=\"positions[]\" value=\"542292\" />\n                <input type=\"hidden\" name=\"token\" value=\"18b92dd74927d4c7072594debbbc8009\" />\n    \t        \n    \t\t\t            \t<a class=\"button\" href=\"/westerwaldkreis/nojavascript\"\n            \t\tonclick=\"document.forms['form-542292'].submit(); return false;\"><span>Jetzt hier bewerben</span></a>\n            \t<span class=\"hideme\">,&nbsp;</span>\n            \t<a class=\"button_resume\" href=\"/westerwaldkreis/nojavascript\" onclick=\"this.href='/westerwaldkreis/login';\"><span>Bewerbung fortsetzen</span></a>\n            \t<span class=\"hideme\">&nbsp;oder&nbsp;</span>\n            \t            \t<span class=\"back\">&nbsp;<a href=\"/westerwaldkreis/nojavascript\" onclick=\"this.href='/westerwaldkreis/index';\">Zurück zur Übersicht</a></span>\n            \t<span class=\"button_reminder\">\n            \t    <a\n            \t    onclick=\"var href=$('.shariff-button.mail a').attr('href'); if (href) {window.location.href=href; return false;}\"\n            \t    href=\"mailto:?subject=Empfohlene%20Stelle%0A&body=Ich%20m%C3%B6chte%20Ihnen%20folgende%20Stelle%20empfehlen%3A%20%0A%0ASachbearbeiter%20%28m%2Fw%2Fd%29%20f%C3%BCr%20das%20Jobcenter%20Westerwald%20%2C%20Westerwaldkreis%20%0A%0ABitte%20klicken%20Sie%20auf%20folgenden%20Link%2C%20um%20sich%20die%20Stelle%20anzusehen%3A%20%0Ahttps%3A%2F%2Fwww.mein-check-in.de%2Fwesterwaldkreis%2Fposition-542292%0A\">\n            \t    Stelle merken\n            \t    </a>\n            \t</span>\n                    \t\n        </div>\n\t</div>\n\n            <div class=\"reminder_usage\">\n        <b>Für diese Stelle empfehlen wir Ihnen die Bewerbung über Ihren PC oder Laptop. Damit Sie bequem das Gerät\n            wechseln können, merken Sie sich die Stelle hier.</b>\n    </div>\n\t</form>\n</div>\n\n        \t<div class=\"small_link_pdf\">\n    \t\t<a href=\"/westerwaldkreis/position-pdf/id/542292\"\ttitle=\"Stellenbeschreibung (PDF)\">\n    \t\t\t<span>Stellenbeschreibung (PDF)</span>\n    \t\t</a>\n    \t</div>\n         \n    <div class=\"shariff\"\n    \tdata-url=\"https://www.mein-check-in.de/westerwaldkreis/position-542292\"\n        data-lang=\"de\"\n        data-button-style=\"icon\"\n        data-services=\"[&quot;facebook&quot;,&quot;twitter&quot;,&quot;xing&quot;,&quot;linkedin&quot;&quot;mail&quot;,&quot;whatsapp&quot;]\"\n        data-mail-url=\"mailto:\"\n        data-mail-subject=\"Empfohlene Stelle\n\"\n        data-mail-body=\"Ich möchte Ihnen folgende Stelle empfehlen: \n\nSachbearbeiter (m/w/d) für das Jobcenter Westerwald , Westerwaldkreis \n\nBitte klicken Sie auf folgenden Link, um sich die Stelle anzusehen: \nhttps://www.mein-check-in.de/westerwaldkreis/position-542292\n\"\n    ></div>\n    <script src=\"/js/shariff.complete.js\"></script>\n\n</div>\n\n                            </div>\n        </div>\n\n    </div>\n    <div class=\"footer-wave\"></div>\n\n<div class=\"footer-information\">\n    <div class=\"inside\">\n\t    <div class=\"footer-left\">\n\t\t\t<h3>Kontakt</h3>\n\t\t\t<span>Kreisverwaltung des Westerwaldkreises</span><br>\n\t\t\t<div>\n\t\t\t\t<span>Peter-Altmeier-Platz 1</span><br>\n\t\t\t\t<span>56410 Montabaur</span><br>\n\t\t\t</div>\n\t\t\tTelefon: <span>(+49)2602 124-0</span><br>\n\t\t\tTelefax: <span>(+49)2602 124-238</span><br>\n\t\t\tE-Mail: <span><a href=\"mailto:kreisverwaltung@westerwaldkreis.de\">kreisverwaltung@westerwaldkreis.de</a></span><br>\n\t\t\t<br>\n\t\t</div>\n\t</div>\n</div>    <div class=\"footer\">\n    <div class=\"inside\">\n\t<ul class=\"info\">\n\t\t<li><a href=\"/westerwaldkreis/imprint\"\n\t\t\ttarget=\"_self\">Impressum</a> | </li>\n\t\t<li><a href=\"/westerwaldkreis/privacy\"\n\t\t\ttarget=\"_self\">Datenschutz</a> | </li>\n\t\t\n\t\t<li class=\"contacts\"><a href=\"/westerwaldkreis/contacts\" target=\"_self\"> | Kontakte</a></li>\n\t</ul>\n</div></div></div>\n\n<script type=\"text/javascript\">MAIN_DIV_ID = 'wrapper';</script>\n<script type=\"text/javascript\">\n    if (window.jQuery) {\n        $('.toolbar_small + #search_box').insertAfter('#wrapper');\n        $('#search').attr('placeholder', '');\n    }\n</script>\n<script type=\"text/javaScript\" src=\"/js/fb/dynamicHeight.js\"></script>\n</body>\n</html>\n"
