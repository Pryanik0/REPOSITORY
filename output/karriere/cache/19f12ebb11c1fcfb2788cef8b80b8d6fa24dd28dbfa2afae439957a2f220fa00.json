=\"concludis-modal\" id=\"concludis-work-modal\" style=\"display:none;\">\n        <div id=\"workdiv\" class=\"concludis-modal-dialog\">\n            <input type=\"hidden\" value=\"https://scheidtbachmann.concludis.de/prj/shw/c7c3e78e3c9d26cc1158a8735d548eaa_0/10356/Information_Security_Officer_m_w_d.htm\" name=\"llink\" id=\"llink\">\n            <form action=\"#\" method=\"POST\" target=\"_self\" id=\"workform\" name=\"workform\">\n                <div class=\"jbpopup_header\">\n                    <div class=\"jbpopup_headline\">\n                        <span id=\"workdivhl\">Bewerben</span>\n                        <div class=\"jbpopup_headerclose tooltip_top\"\n                             onclick=\"cJobboard.layerV2('', 'close'); return false;\"\n                             title=\"Fenster Schließen\">&nbsp;\n                        </div>\n                    </div>\n                </div>\n\n                <input type=\"hidden\" value=\"c7c3e78e3c9d26cc1158a8735d548eaa_0\" name=\"prj\"\n                       id=\"prj\">\n                <input type=\"hidden\"\n                       value=\"\"\n                       name=\"oid\" id=\"workform_oid\">\n                <input type=\"hidden\" value=\"10\" name=\"b\" id=\"workform_b\">\n                <input type=\"hidden\" value=\"0\" name=\"quelle\"\n                       id=\"workform_quelle\">\n                <input type=\"hidden\" value=\"1\" name=\"ie\"\n                       id=\"workform_ie\">\n                            </form>\n            <iframe id=\"workif\" name=\"workif\" style=\"margin-top: 15px; width: 100%; height: 0;\" frameborder=\"0\"\n                    src=\"https://scheidtbachmann.concludis.de/bewerber/empty.php\"></iframe>\n        </div>\n    </div>\n\n        <div style=\"width:100%\" class=\"resdiv\">\n\n    \n    <table width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\">\n        <tr class=\"navtr\">\n            <td style=\"text-align:left;\" colspan=\"3\">\n                                    <div class=\"concludis-nav-item i18n-ls-nav\">\n                        <a class=\"i18n-ls-menu-opener\">\n                            <span class=\"i18n-ls-language\">Deutsch</span>\n                            <i class=\"concludisicon-down-dir\"></i>\n                        </a>\n                        <div class=\"i18n-ls-menu\">\n                            <strong>Language</strong>\n                            <div>\n                                <select id=\"i18n-ls-select\"\n                                        data-url=\"https://scheidtbachmann.concludis.de/prj/shw/c7c3e78e3c9d26cc1158a8735d548eaa_0/10356/Information_Security_Officer_m_w_d.htm?v=1&b=10&page=1&boerse=10\">\n                                                                            <option value=\"de_DE\"\n                                            selected>Deutsch (Deutschland)</option>\n                                                                            <option value=\"en_GB\"\n                                            >English (United Kingdom)</option>\n                                                                            <option value=\"sk_SK\"\n                                            >slovenčina (Slovensko)</option>\n                                                                    </select>\n                            </div>\n                        </div>\n                    </div>\n                    \n\t\t<div class=\"concludis-nav-item\" id=\"emailsubscription_liste\">\n\t\t\t<a class=\"subscriptionbutton textsmall tooltip_bottom\" onclick=\"cJobboard.showModalJobsubscription()\" title=\"Lassen Sie sich von uns über neue Jobangebote per E-Mail benachrichtigen\">Job-Benachrichtigung per E-Mail</a>\n\t\t</div>\n\n\t\t<div style=\"height:10px;\"></div>\n                <div id=\"hd_Stellenangebot\" style=\"padding:5px 8px\">Stellenangebote</div>            </td>\n        </tr>\n    </table>\n\n\n    <div id=\"container\">\n        <table style=\"width:100%\">\n                            <tr class=\"headtr\">\n                    <td class=\"headtd\" style=\"text-align:left; padding:5px\"><span id=\"hd_Stellenangebot\"><span id=\"pagetitle\" class=\"headerlink\" style=\"cursor: pointer;\" onclick=\"window.close();\" title=\"Fenster schließen\">« zurück</span></span></td>                        <!--</div>-->\n                                            <!--</td>-->\n                </tr>\n                        </table>\n    </div>\n    \n        </div>\n\n    <main class=\"jobad\" role=\"main\">\r\n\r\n\r\n    <div class=\"jb-container\">\r\n        <div class=\"jb-wrapper\">\r\n            <div class=\"col-xs-12 util-reset-margin-bottom\">\r\n                <div class=\"jb-header\">\r\n                    <a href=\"https://www.scheidt-bachmann.de\" target=\"_blank\" title=\"Scheidt & Bachmann\">\r\n                        <img src=\"https://jobs.scheidt-bachmann.de/download/design/MTAxNTQ5MzU=/sblogo.png\"\r\n                        alt=\"Scheidt & Bachmann\"/>\r\n                    </a>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n    <div class=\"jb-header-img\">\r\n        <img src=\"https://jobs.scheidt-bachmann.de/download/design/MTE0MjY3MzM=/header_general_project.jpg\" class=\"con-header-image\" alt=\"header image\">\r\n    </div>\r\n\r\n\r\n    <div class=\"bg-grey\">\r\n        <div class=\"jb-container\">\r\n            <div class=\"jb-wrapper\">\r\n                <div class=\"col-xs-12\">\r\n                    <div class=\"job-title\">\r\n                        <small><p><div>Wir suchen dich als</div></p></small>\r\n                        <h1>Information Security Officer <span class=\"m_w\">(m/w/d)</span></h1>\r\n                        <span><div>zur Unterstützung unseres ISMS-Teams für unsere Tochtergesellschaft Scheidt &amp; Bachmann Energy Retail Solutions GmbH am Standort Mönchengladbach.</div></span>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"jb-container\">\r\n        <div class=\"jb-wrapper\">\r\n            <div class=\"jb-items\">\r\n                <div class=\"jb-item\">\r\n                    <div class=\"content-wrapper\">\r\n                        <div class=\"intro-block\">\r\n                            <h3>Scheidt &amp; Bachmann - Mobilität, die verbindet</h3>\n<div>Ob beim Bahnfahren, Parken, Tanken bzw. Laden oder bei der Nutzung des öffentlichen Nahverkehrs – mit großer Wahrscheinlichkeit hast du dabei schon unsere Technik genutzt. Seit über 150 Jahren entwickeln wir Systeme und Lösungen für eine Mobilitätsinfrastruktur, die weltweit Menschen und Güter sicher, schnell und komfortabel ans Ziel bringt. Als Familienunternehmen leben wir Werte wie Vertrauen, Verlässlichkeit und Zusammenhalt – und gestalten gemeinsam die Mobilität von morgen.</div>\r\n                        </div>\r\n                        <div class=\"business-area\">\r\n                            <h3>Der Geschäftsbereich</h3>\n<div><strong><span style=\"color:#0095a9;\">Energy Retail Solutions</span></strong></div>\n<div></div>\n<div>ist Marktführer für Point-of-Sale-Lösungen und Energy-Retail-Managementsysteme in mittleren und großen Tankstellen- und EV-Chargingnetzen. Wir bieten unseren internationalen Kunden ein modernes Software-Produktportfolio von Kassen- und Backoffice-Systemen über Payment-Terminals bis hin zu zentralen Cloud-Lösungen und Payment-Apps an. Unsere Lösungen werden von namhaften Energiekonzernen und -händlern im In- und Ausland eingesetzt.</div>\r\n                            <img src=\"https://jobs.scheidt-bachmann.de/download/design/MTE4MDU2NjA=/ERS-SIQMA-OPT.jpg\"\r\n                                 alt=\"Signaltechnik\">\r\n                        </div>\r\n                        <div class=\"jb-offer\">\r\n                            <h3>Wir bieten</h3>\n<ul style=\"list-style-type:square;\">\n<li>\n<div><strong>Eine unbefristete Anstellung</strong> in einem innovativen, krisensicheren und etablierten Unternehmen, in dem Vielfalt und Gleichstellung zu unserer DNA gehören</div>\n</li>\n<li>\n<div><strong>Work-Life-Balance</strong>: Freu dich auf eine flexible, familienorientierte Arbeitszeitgestaltung, Home-Office- und Teilzeitmöglichkeiten, Bike Leasing, Altersvorsorge, Urban Sports Club und unseren Kinderbetreuungszuschuss</div>\n</li>\n<li>\n<div><strong>Gute Verpflegung</strong>: Entdecke das abwechslungsreiche Essensangebot in unserem modernen Betriebsrestaurant</div>\n</li>\n<li>\n<div><strong>Strukturierte Einarbeitung und Buddy-Programm</strong>: Wir wollen, dass du dich von Beginn an wohlfühlst und dein Know-how direkt einbringen kannst</div>\n</li>\n<li>\n<div><strong>Personalentwicklungs- und Weiterbildungsprogramme</strong>: Entwickle dich kontinuierlich weiter, um deinem Team immer wieder neue Impulse zu geben</div>\n</li>\n<li>\n<div><strong>Jede Menge Wertschätzung</strong>: Eine attraktive Vergütung ist für uns ebenso selbstverständlich wie ein kollegiales Miteinander auf Augenhöhe</div>\n</li>\n</ul>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n\r\n                <div class=\"jb-item\">\r\n                    <div class=\"content-wrapper\">\r\n                        <div class=\"tasks\">\r\n                            <h3>Deine Aufgaben</h3>\n<ul style=\"list-style-type:square;\">\n<li>Du verantwortest den Betrieb und die Weiterentwicklung des ISMS nach ISO 27001.</li>\n<li>Du steuerst das lokale ISMS-Team und vertrittst unseren Geschäftsbereich im konzernweiten ISMS-Board.</li>\n<li>Du berätst Geschäftsführung und Fachbereiche zu Informationssicherheit, Risiken und Compliance-Anforderungen.</li>\n<li>Du führst Risikoanalysen, Audits und Management Reviews durch und begleitest Verbesserungsmaßnahmen.</li>\n<li>Du setzt konzernweite Sicherheitsvorgaben in unseren Prozessen und Produkten um.</li>\n<li>Du bist zentrale Ansprechperson für Mitarbeitende, Kunden und Auditoren.</li>\n<li>Du koordinierst Richtlinien, Awareness-Maßnahmen und Sicherheitskennzahlen.</li>\n</ul>\r\n                        </div>\r\n                        <div class=\"qualifications\">\r\n                            <h3>Das bringst du mit</h3>\n<ul style=\"list-style-type:square;\">\n<li>Berufserfahrung im Bereich <strong>Informationssicherheit, ISMS, IT-Security</strong> oder Governance, Risk &amp; Compliance</li>\n<li><strong>Fundierte Kenntnisse</strong> der ISO 27001</li>\n<li>Erfahrung mit <strong>Risikoanalysen</strong>, Audits und Managementsystemen</li>\n<li><strong>Technisches Verständnis</strong> von IT-Systemen und IT-Sicherheitsmaßnahmen</li>\n<li>Sehr gute Deutsch- und Englischkenntnisse</li>\n<li>Eine strukturierte, <strong>eigenständige und risikoorientierte </strong>Arbeitsweise</li>\n<li>Klare Kommunikation, adressatengerecht und auf Augenhöhe – vom Fachbereich bis zur Geschäftsführung</li>\n<li>Verantwortungsbewusstsein, Integrität und Teamgeist</li>\n</ul>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n    </div>\r\n\r\n\r\n    <div class=\"bg-grey\">\r\n        <div class=\"jb-container\">\r\n            <div class=\"jb-wrapper\">\r\n                <div class=\"jb-contact\">\r\n                    <div class=\"contactimg\"><img src=\"https://jobs.scheidt-bachmann.de/download/design/MTExNzk0Mjc=/FrankDohmenmittel.jpg\"></div>\r\n                    <div class=\"jb-con-1\">\r\n                        <div class=\"questions\">\r\n                            <h3>Hast du Interesse?</h3>\n<div><strong>Für weitere Fragen kontaktiere:</strong></div>\n<p>Frank Dohmen</p>\n<div class=\"row\">\n<div class=\"col-xs-12\"><a>+49 2166 266-253</a></div>\n<div class=\"col-xs-12\"><strong><a href=\"http://www.scheidt-bachmann.de/karriere\">Karriere bei Scheidt &amp; Bachmann