  "text": "<!DOCTYPE html> <html lang=\"ja\"> <head itemscope itemtype=\"http://schema.org/WebSite\"> <meta charset=\"UTF-8\"> <meta name=\"format-detection\" content=\"telephone=no\"> <meta name=\"csrfToken\" content=\"\"> <meta name=\"referrer\" content=\"origin-when-cross-origin\"> <meta name=\"robots\" content=\"noindex,follow\"> <title itemprop=\"name\">宇部工場の魅力について | 協和キリン株式会社</title> <meta name=\"description\" content=\"宇部工場の魅力について（協和キリン株式会社）の求人情報です。 | HRMOS\"> <meta name=\"keywords\" content=\"宇部工場の魅力について,宇部工場の魅力について,協和キリン株式会社,求人,仕事,求人情報,正社員,転職,就職,HRMOS\"> <link rel=\"canonical\" href=\"https://hrmos.co/pages/kyowakirin/jobs/1793203219567173633\" itemprop=\"url\"> <link rel=\"shortcut icon\" href=\"https://cdn.hrmos.co/b2b-assets/favicon.ico\"> <link rel=\"apple-touch-icon-precomposed apple-touch-icon\" href=\"https://cdn.hrmos.co/b2b-assets/images/apple-touch-icon.png\"> <link rel=\"stylesheet\" href=\"/recruiting-pages/stylesheets/pg.jobDetailPage.css?v=688c11d2e632aa145d96343ee45968bd673f7cd5\"> <!--[if lt IE 9]><script src=\"http://ie7-js.googlecode.com/svn/version/2.1(beta4)/IE9.js\"></script><![endif]--> <meta property=\"fb:app_id\" content=\"1047279508664621\"> <meta property=\"og:type\" content=\"website\"> <meta property=\"og:title\" content=\"宇部工場の魅力について | 協和キリン株式会社\"> <meta property=\"og:url\" content=\"https://hrmos.co/pages/kyowakirin/jobs/1793203219567173633\"> <meta property=\"og:site_name\" content=\"スピードと効率で採用を強くするHRMOS | 株式会社ビズリーチ\"> <meta name=\"twitter:card\" content=\"summary_large_image\"> <meta name=\"twitter:title\" content=\"宇部工場の魅力について | 協和キリン株式会社\"> <meta property=\"og:description\" content=\"宇部工場の魅力について（協和キリン株式会社）の求人情報です。 | HRMOS\"> <meta name=\"twitter:description\" content=\"宇部工場の魅力について（協和キリン株式会社）の求人情報です。 | HRMOS\"> <meta id=\"fb-og-image\" property=\"og:image\" content=\"https://res.hrmos.co/hrmony/b_rgb:FFFFFF,c_mpad,h_200,w_200/m/a2c3/images/1628357475070029824_full\"> <meta name=\"twitter:image\" content=\"https://res.hrmos.c