ClientToken,\n          site: \"datadoghq.com\",\n          service: rumService,\n          env: rumEnv,\n          sessionSampleRate: rumSessionSampleRate,\n          sessionReplaySampleRate: 0,\n          trackUserInteractions: true,\n          trackResources: true,\n          trackLongTasks: true,\n          defaultPrivacyLevel: \"mask\",\n          beforeSend: (window.SgDatadogRum && window.SgDatadogRum.beforeSend) || function () { return true; },\n        });\n        window.DD_RUM.setGlobalContextProperty(\"org_cost_allocation_1\", \"aws-ats\");\n      })\n    }\n  })();\n</script> <script>\n    function link_site_check(url, innertxt){\n      const msg = 'リンク ' + (innertxt ? innertxt : url) + ' をクリックすると別のサイトが開きます。別のサイトを開きますか？';\n      if (window.confirm(msg)) {\n        window.open(url, \"_blank\");\n      }\n    }\n    document.addEventListener('DOMContentLoaded', function () {\n      const elements = [...document.getElementsByTagName('a')];\n      for (let element of elements) {\n        if (element.href && element.href.search(/^http.*@/) > -1) {\n          const command = `javascript:link_site_check(\"${element.href}\",\"${element.innerText}\")`;\n          element.target = '_self';\n          element.href = command;\n        }\n      }\n    });\n  </script> </head> <body> <script>\n            var documentId = '';\n            var isApplicable = false;\n            var isNotFound = false;\n          </script> <header class=\"sg-header sg-breadcrumbs\"> <ol class=\"sg-wrapper\"> <li> <a href=\"https://www.kyowakirin.co.jp/index.html\"> 協和キリン株式会社 </a> </li> <li> <a href=\"https://hrmos.co/pages/kyowakirin\">協和キリン株式会社 採用情報</a> </li> <li> <a href=\"https://hrmos.co/pages/kyowakirin/jobs\">協和キリン株式会社 の求人一覧</a> </li> <li>宇部工場の魅力について</li> </ol> </header> <section class=\"sg-wrapper jsc-container\"> <div class=\"sg-corporate-header\"> <a href=\"https://www.kyowakirin.co.jp/index.html\" class=\"sg-corporate-logo\"> <img src=\"https://res.hrmos.co/hrmony/m/a2c3/images/1628357475070029824_full\" alt=\"協和キリン株式会社\"> </a> <div class=\"sg-corporate-summary\"> <h1 class=\"sg-corporate-name\">宇部工場の魅力について</h1> <ul class=\"sg-tags\"> <li>正社員</li> </ul> <p><a href=\"https://hrmos.co/pages/kyowakirin/jobs\">協和キリン株式会社 の求人一覧</a></p> </div> <ul class=\"sg-social-buttons\"> <li class=\"sg-social-buttons-tweet\"><a class=\"twitter-share-button\" href=\"https://twitter.com/share\" data-count=\"none\">ツイート</a></li> <li class=\"sg-social-buttons-facebook\"><div class=\"fb-share-button\" data-href=\"https://hrmos.co/pages/kyowakirin/jobs/1793203219567173633\" data-layout=\"button_count\"></div></li> <li class=\"sg-social-buttons-linkedin\"><script type=\"IN/Share\" data-url=\"https://hrmos.co/pages/kyowakirin/jobs/1793203219567173633\" data-counter=\"right\"></script></li> </ul> </div> </section> <main class=\"sg-wrapper sg-container jsc-container\"> <nav id=\"jsi-markdown-anchors-nav\" class=\"not-has-cover\"> <ul id=\"jsi-markdown-anchors\"> </ul> </nav> <div class=\"pg-main-column cf\"> <article class=\"pg-body\"> <section class=\"pg-markdown jsc-markdown-text\"> <p>■協和キリングループでは「社員一人ひとりの健康で質の高い豊かな人生の実現」を目指して健康経営に取り組んでおります。キャリア採用にご応募いただく全応募者の方に関しまして以下を【必須項目】とさせていただきます。ご理解いただけますと幸いです。<br/>【必須項目】非喫煙者</p><p>Kyowa Kirin Group strives for Health &amp; Productivity Management aiming to “deliver good health, quality and well-being in each employee’s life.” We would like to request all the applicants for our mid-career recruitment to observe the following [Essential requirement]. We would appreciate your kind understanding.<br/>[Essential requirement] Nonsmoker</p><p>■過去一年以内に応募されたことがあるポジションには原則再応募できません／Reapplication for the same position within one year is not allowed in principle.</p> </section> <section class=\"pg-markdown jsc-markdown-text\"> <h1>仕事内容の魅力</h1><p>■宇部工場で活躍しているキャリア入社社員<br/>　宇部工場　製造部　製造技術課マネジャー（https://hrmos.co/pages/kyowakirin/jobs/0000007）</p><p>■技術系総合職で活躍している社員<br/>　宇部工場　製造部（https://www.kyowakirin.co.jp/careers/recruit/interview/people25/index.html）<br/>　宇部品質ユニット品質管理部（https://www.kyowakirin.co.jp/careers/recruit/interview/people27/index.html）</p><p>■宇部工場で活躍している社員コメント<br/>　◎宇部品質ユニット品質保証部　企画職<br/>　　多岐にわたる業務を円滑に進めるため、各部署と密接な連携と協力体制を築くことが求められます。<br/>　　ディスカッションが白熱することもありますが、安全・信頼・高品質な製品を提供できるよう取り組んでいます。<br/>　◎宇部品質ユニット品質管理部　技能職<br/>　　工程分析、製品試験、安定性試験を担当しています。各試験の合間に備品や試薬発注、翌日の器具等の準備、事務作業を行い、１日の労働時間を有効活用しています。<br/>　◎宇部品質ユニット品質管理部　企画職<br/>　　分析法技術移管、新レギュレーション対応、機器・文書管理などを担当しています。<br/>　　宇部工場で働く皆さんの協力がなければできない仕事です。Oneチームであることを日々感じながら働いています。<br/>　◎宇部工場　製造部　製造技術課　製造職<br/>　　宇部工場では部門を超えた協力で1つ1つ大小の壁を越え、新製品の立ち上げに取り組んでいます。<br/>　　品質向上のため新しい技術を取り入れ、顧客・患者さんの要望に応えていきたいです。<br/>　◎宇部工場　工務部　製造職<br/>　　宇部工場で働く従業員が業務に集中できるよう、DXを積極的に取り入れ、単純作業の自動化や技術の継承に努めています。</p><p>■宇部工場の従業員は『高品質の医薬品と笑顔を届ける』を目標に日々の業務に取り組んでいます。</p><h1>土地の魅力</h1><p>■協和キリン株式会社　宇部工場<br/>　〒755-8501 山口県宇部市大字藤曲2547-3</p><p>■宇部市の情報<br/>　「宇部市公式ウェブサイト（https://www.city.ube.yamaguchi.jp/）」には、暮らしに役立つ情報のほか、<br/>　宇部市SNS、関連サイト（ときわ公園、うべ旅ナビ、宇部移住計画など）の情報が掲載されています。</p><p>■山口県の地元スーパー<br/>　マルキュウ・アルク（丸久）<br/>　まるき（丸喜）<br/>■西日本（北九州）ホームセンター・家具・ホームファッションストア<br/>　ナフコ<br/>■山口県内のドラッグストア<br/>　ウォンツ（ツルハ）<br/>　くすり岩崎チェーン（ｺｺｶﾗﾌｧｲﾝ）<br/>　コスモス<br/>■山口県内の家具・インテリア<br/>　太陽家具<br/>　種田家具（タネダ）</p><p>■単身赴任・独身の居住地<br/>・工場近隣、または宇部新川駅、宇部駅の周辺に住む方が多い<br/>・工場から２km以遠であれば車通勤が可能<br/>【工場近隣】<br/>　・徒歩圏内にスーパー、ホームセンターあり<br/>【宇部新川駅】<br/>　・徒歩圏内にスーパー、ドラッグストアあり、繁華街に近い<br/>　・山口宇部空港へのアクセス良好（車15分、公共交通機関20分）（山口宇部空港は駐車料金が無料）<br/>【宇部駅】<br/>　・徒歩圏内にスーパー、ドラッグストアあり<br/>　・山陽本線のため、新幹線停車駅（新山口駅、厚狭駅）へのアクセス良好</p><p>■家族同伴者の居住地<br/>・工場から２km以遠であれば車通勤が可能<br/>・住環境（保育園、学校、病院）を重視して決める方が多い（通勤可能圏内から選択される場合あり）</p><p>■通勤可能圏内（単身、家族同伴ともに選択されるケース有）<br/>　ドアtoドア　90分以内<br/>　＊宇部工場では、車通勤圏内は50km未満に設定しています<br/>　＊主要な駅を基準としているため、実際の住所により異なります<br/>　山陽小野田市【山陽小野田駅】電車25分、車９km<br/>　山口市【新山口駅】電車50分、車28km<br/>　山口市【山口駅】電車80分、車42km<br/>　下関市【新下関駅】電車65分、車39km<br/>　下関市【下関駅】電車70分、車44km<br/>　防府市【防府駅】電車は不可、車45km<br/>　美祢市【美祢駅】電車は不可、車30km<br/>　周南市【徳山駅】電車80分(新幹線利用)、車不可</p><p>\"#LI-DNI\"</p> </section> <section class=\"pg-descriptions\"> <table> <tr> <th>職種 / 募集ポジション</th> <td>宇部工場の魅力について</td> </tr> <tr> <th>雇用形態</th> <td>正社員</td> </tr> <tr> <th>給与</th> <td> <dl> <dt>応相談</dt> <dd id=\"jsi-job-salary-amount-formatted\"></dd> <dd class=\"pg-supplement-txt\"> <pre></pre> </dd> </dl> </td> </tr> <tr> <th>勤務地</th> <td> <ul> </ul> <pre></pre> </td> </tr> </table> </section> <section class=\"pg-descriptions\"> <table> <caption>会社情報</caption> <tr> <th>会社名</th> <td>協和キリン株式会社</td> </tr> <tr> <th>設立</th> <td> <pre>1949年7月1日 \n※2008年10月1日付でキリンファーマ株式会社との合併により「協和醱酵工業株式会社」より「協和発酵キリン株式会社」に商号変更。\n※2019年7月1日付で「協和キリン株式会社」に社名変更。\n</pre> </td> </tr> <tr> <th>資本金</th> <td> <pre>26,745百万円（2025年12月31日現在）</pre> </td> </tr> <tr> <th>従業員数</th> <td> <pre>5,161人（連結ベース、2025年12月31日現在）</pre> </td> </tr> <tr> <th>代表者</th> <td> <pre>代表取締役会長 宮本昌志\n代表取締役社長CEO アブドゥル・マリック</pre> </td> </tr> <tr> <th>本社所在地</th> <td> <pre>〒100-0004 東京都千代田区大手町一丁目9番2号　大手町フィナンシャルシティ グランキューブ\nTEL：03-5205-7200</pre> </td> </tr> <tr> <th>事業内容</th> <td> <pre>医療用医薬品の研究・開発・製造・販売および輸出入等</pre> </td> </tr> <tr> <th>親会社</th> <td> <pre>キリンホールディングス株式会社</pre> </td> </tr> <tr> <th>就業場所に関して</th> <td> <pre>◆入社後の就業場所は上記の募集要項内にあります。\n◆就業場所の変更の範囲は下記のとおりです。\n協和キリン株式会社の全事業場および出向先・派遣先としての他の会社・法人・団体（在宅勤務を行う場所を含む）\nまた、海外出向や長期出張の可能性があります\n◆在宅勤務の勤務場所は入社後と変更の範囲において共通で下記のとおりです。\n自宅、自身もしくは配偶者の親元、配偶者宅（ただし、在宅勤務は会社が承認した場合に限る）</pre> </td> </tr> <tr> <th>従事すべき業務について</th> <td> <pre>◆入社後の従事すべき業務については上記の募集要項内にあります。\n◆従事すべき業務の変更の範囲は下記のとおりです。\n 会社内での全ての業務を命じることがある。</pre> </td> </tr> <tr> <th>採用活動において求職者の皆様に約束する事</th> <td> <pre>協和キリングループでは、採用・選考、インターンシップ、会社説明会、OB・OG訪問、面談を含む採用活動のすべての場面において、応募者一人ひとりの人格と尊厳を尊重し、安心してご参加いただける環境を整えることを重要な責務と考えています。\n\n-公平・公正な採用について\n私たちは、人種、肌の色、民族、国籍、社会的身分、門地、性別、障害の有無、健康状態、宗教、思想・信条、性的指向・性自認などに関係なく、応募者の適性および能力のみを基準として、公平で公正な採用を行うことを基本方針とします。また、年齢確認を徹底し、児童労働の年齢に該当する方は採用いたしません。\n\n-採用活動におけるハラスメント防止について\n協和キリングループは、採用活動に関わる社員による応募者の意に反する性的な言動や、不快感・不利益を与える行為（セクシュアルハラスメント）を決して容認しません。この方針は、採用活動に関与するすべての社員に周知・徹底しており、万一不適切な行為が確認された場合には、就業規則等に基づき厳正に対処します。\n\n-個人情報の取り扱いについて\n採用活動を通じて取得する個人情報については、「個人情報保護方針」に基づき、適切に管理・保護いたします。\n\n&lt;採用活動に関するハラスメント相談窓口&gt;\n採用・選考の過程で、面接担当者や採用スタッフ等によるセクシャルハラスメント、パワーハラスメント、その他の人権侵害行為を受けた場合は、下記の相談窓口までご連絡ください。ご相談内容についてはプライバシーに十分配慮し、相談いただいたことを理由に不利益な取り扱いを行うことは一切ありません。\n\n協和キリン　 採用活動に関するハラスメント相談窓口（下記URLより入力ください）https://faq.kirin.co.jp/form/kkc_31.html\n※「メール送信フォーム」の「お問い合わせ種類」は、「（５）その他コンプライアンスに関するお問い合わせ」を選択ください。</pre> </td> </tr> </table> </section> <section class=\"pg-apply-box\"> <ul> <li> <a class=\"sg-button l disabled\">募集終了</a> </li> </ul> </section> </article> <aside class=\"pg-side-column loading\" id=\"jsi-side\"> <section id=\"jsi-apply-box\" class=\"pg-apply-box\"> <ul> <li> <a class=\"sg-button l disabled\">募集終了</a> </li> </ul> </section> <section class=\"pg-related-jobs has-border\"> <h2>協和キリン株式会社 の求人</h2> <div id=\"jsi-related-jobs\"></div> <p class=\"sg-font aligncenter\"> <a href=\"https://hrmos.co/pages/kyowakirin/jobs\"> すべての求人を見る </a> </p> </section> <section class=\"pg-sns-wrapper\"> <ul class=\"sg-social-buttons\"> <li class=\"sg-social-buttons-tweet\"><a class=\"twitter-share-button\" href=\"https://twitter.com/share\" data-count=\"none\"></a></li> <li class=\"sg-social-buttons-facebook\"><div class=\"fb-share-button\" data-href=\"https://hrmos.co/pages/kyowakirin/jobs/1793203219567173633\" data-layout=\"button_count\"></div></li> <li class=\"sg-social-buttons-linkedin\"><script type=\"IN/Share\" data-url=\"https://hrmos.co/pages/kyowakirin/jobs/1793203219567173633\" data-counter=\"right\"></script></li> </ul> </section> <div id=\"jsi-side-spinner\" class=\"sg-spinner\"></div> </aside> </div> </main> <footer class=\"sg-footer\"> <nav class=\"sg-breadcrumbs\"> <ol class=\"sg-wrapper\"> <li> <a href=\"https://www.kyowakirin.co.jp/index.html\"> 協和キリン株式会社 </a> </li> <li> <a href=\"https://hrmos.co/pages/kyowakirin\">協和キリン株式会社 採用情報</a> </li> <li> <a href=\"https://hrmos.co/pages/kyowakirin/jobs\">協和キリン株式会社 の求人一覧</a> </li> <li>宇部工場の魅力について</li> </ol> </nav> <nav class=\"sg-wrapper sg-footer-nav\"> <ul> <li><a href=\"https://hrmos.co/terms/\" tar