  "fetched_at": "2026-11-25T16:01:31.542601+00:00",
  "text": "<!doctype html>\n\r\n<html lang=\"ja\">\r\n<head>\r\n<script src=\"//nexus.ensighten.com/kirin/prod_kyowakirin-co-jp/Bootstrap.js\"></script>\r\n<meta charset=\"UTF-8\">\r\n<meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\r\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n<title>FAQ｜採用情報｜採用情報サイト｜協和キリン株式会社</title>\r\n<meta name=\"description\" content=\"製薬会社・協和キリンの採用情報ウェブサイトです。新卒採用情報、キャリア採用情報、障害者採用情報、グループ各企業の採用情報を公開しています。\">\r\n<meta property=\"og:type\" content=\"website\">\r\n<meta property=\"og:image\" content=\"https://www.kyowakirin.co.jp/careers/recruit/share/img/ogp.png\">\r\n<meta property=\"og:title\" content=\"FAQ｜採用情報｜採用情報サイト｜協和キリン株式会社\">\r\n<meta property=\"og:description\" content=\"製薬会社・協和キリンの採用情報ウェブサイトです。新卒採用情報、キャリア採用情報、障害者採用情報、グループ各企業の採用情報を公開しています。\">\r\n<link rel=\"shortcut icon\" href=\"/careers/recruit/share/img/favicon.ico\">\r\n<link rel=\"apple-touch-icon\" href=\"/careers/recruit/share/img/apple_touch_icon.png\">\r\n<link rel=\"canonical\" href=\"https://www.kyowakirin.co.jp/careers/recruit/faq/\">\r\n<link rel=\"preconnect\" href=\"https://www.googletagmanager.com\">\r\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\r\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"\">\r\n\r\n<link href=\"https://fonts.googleapis.com/css2?family=Hind+Madurai:wght@400;500;600;700&amp;display=swap\" rel=\"stylesheet\">\r\n<link rel=\"stylesheet\" href=\"/careers/recruit/share/css/common.css?20261119121404442\">\r\n<script src=\"/careers/recruit/share/js/init.js?20261119121404442\"></script>\r\n<script type=\"module\" src=\"/careers/recruit/share/js/common.js?20261119121404442\" crossorigin=\"\"></script>\r\n<!--  Google Tag Manager  -->\r\n<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':\r\nnew Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],\r\nj=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=\r\n'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);\r\n})(window,document,'script','dataLayer','GTM-5BDMWGT');</script>\r\n<!--  End Google Tag Manager  --></head>\r\n<body id=\"top\">\r\n<!--  Google Tag Manager (noscript)  -->\r\n<noscript><iframe src=\"https://www.googletagmanager.com/ns.html?id=GTM-5BDMWGT\" height=\"0\" width=\"0\" style=\"display:none;visibility:hidden\"></iframe></noscript>\r\n<!--  End Google Tag Manager (noscript)  --><!--  /careers/recruit/share/inc/header.html include start  -->\r\n<div class=\"inc_careers_recruit_share_inc_header\">\r\n<header id=\"str-header\" class=\"str-header\">\r\n<div class=\"str-header__body\">\r\n<div class=\"str-header-logo\">\r\n<a href=\"/careers/recruit/\" class=\"str-header-logo__body\">\r\n<img src=\"/careers/recruit/share/img/logo-main.svg\" alt=\"KYOWA KIRIN\" width=\"221\" height=\"36\" class=\"str-header-logo__item\">\r\n<span class=\"str-header-logo__title\">Recruiting</span>\r\n</a>\r\n<!--  /.str-header-logo  --></div>\r\n\r\n<ul class=\"str-header-link\">\r\n<li class=\"str-header-link__item\"><a href=\"https://mypage.3010.i-webs.jp/kyowakirin2028/\" target=\"_blank\" class=\"str-header-link__link str-header-link__link--main str-header-link__link--new\">新卒 2028年卒<span>ENTRY・MY PAGE<svg class=\"m-icon m-icon--blank-default-white\" role=\"img\" aria-label=\"別窓で開く\"><use href=\"#icon-blank-default\"></use></svg></span></a></li>\r\n<li class=\"str-header-link__item\"><a href=\"https://mypage.3010.i-webs.jp/kyowakirin2027/\" target=\"_blank\" class=\"str-header-link__link str-header-link__link--main str-header-link__link--mid\">新卒 2027年卒<span>ENTRY・MY PAGE<svg class=\"m-icon m-icon--blank-default-white\" role=\"img\" aria-label=\"別窓で開く\"><use href=\"#icon-blank-default\"></use></svg></span></a></li>\r\n<li class=\"str-header-link__item\"><a href=\"https://hrmos.co/pages/kyowakirin\" target=\"_blank\" class=\"str-header-link__link\"><span>キャリア採用<svg class=\"m-icon m-icon--blank-default\" role=\"img\" aria-label=\"別窓で開く\"><use href=\"#icon-blank-default\"></use></svg></span></a></li>\r\n<li class=\"str-header-link__item\"><a href=\"/careers/recruit/handicapped/\" class=\"str-header-link__link\">障害をお持ちの方</a></li>\r\n<!--  /.str-header-link  --></ul>\r\n\r\n<button type=\"button\" class=\"str-header-menu\"><span class=\"js-gnav-btn-label\">MENU</span></button>\r\n<!--  /.str-header__body  --></div>\r\n\r\n<nav class=\"str-nav\" aria-label=\"global navigation\">\r\n<div class=\"str-nav__body\">\r\n<div class=\"str-nav__item\">\r\n<p class=\"str-nav__title js-gnav-toggle-btn\">Company（協和キリンについて）</p>\r\n\r\n<div class=\"str-nav-menu\">\r\n<div class=\"str-nav-menu__body\">\r\n<ul class=\"str-nav-menu-link\" data-col=\"1\" data-col-wide=\"3\">\r\n<li class=\"str-nav-menu-link__item\"><a href=\"/careers/recruit/ambition/\" class=\"str-nav-menu-link__link\">私たちの志</a></li>\r\n<li class=\"str-nav-menu-link__item\"><a href=\"/careers/recruit/company/\" class=\"str-nav-menu-link__link\">vision</a></li>\r\n</ul>\r\n<!--  /.str-nav-menu__body  --></div>\r\n<!--  /.str-nav-menu  --></div>\r\n<!--  /.str-nav__item  --></div>\r\n\r\n<div class=\"str-nav__item\">\r\n<p class=\"str-nav__title js-gnav-toggle-btn\">People&amp;Job（人と仕事）</p>\r\n\r\n<div class=\"str-nav-menu\">\r\n<div class=\"str-nav-menu__body\">\r\n<ul class=\"str-nav-menu-link\" data-col=\"1\" data-col-wide=\"3\">\r\n<li class=\"str-nav-menu-link__item\"><a href=\"/careers/recruit/interview/\" class=\"str-nav-menu-link__link\">社員インタビュー</a></li>\r\n<li class=\"str-nav-menu-link__item\"><a href=\"/careers/recruit/personality/\" class=\"str-nav-menu-link__link\">【新卒向け】求める人材像</a></li>\r\n<li class=\"str-nav-menu-link__item\"><a href=\"/careers/recruit/work/\" class=\"str-nav-menu-link__link\">【新卒向け】職種紹介</a></li>\r\n<li class=\"str-nav-menu-link__item\"><a href=\"/careers/recruit/project/\" class=\"str-nav-menu-link__link\">プロジェクトストーリー</a></li>\r\n</ul>\r\n<!--  /.str-nav-menu__body  --></div>\r\n<!--  /.str-nav-menu  --></div>\r\n<!--  /.str-nav__item  --></div>\r\n\r\n<div class=\"str-nav__item\">\r\n<p class=\"str-nav__title js-gnav-toggle-btn\">Work Style（働く環境）</p>\r\n\r\n<div class=\"str-nav-menu\">\r\n<div class=\"str-nav-menu__body\">\r\n<ul class=\"str-nav-menu-link\" data-col=\"1\" data-col-wide=\"3\">\r\n<li class=\"str-nav-menu-link__item\"><a href=\"/careers/recruit/office/\" class=\"str-nav-menu-link__link\">国内拠点紹介</a></li>\r\n<li class=\"str-nav-menu-link__item\"><a href=\"/careers/recruit/interviewmovie/\" class=\"str-nav-menu-link__link\">女性の経営職</a></li>\r\n<li class=\"str-nav-menu-link__item\"><a href=\"/careers/recruit/training/\" class=\"str-nav-menu-link__link\">人材育成</a></li>\r\n<li class=\"str-nav-menu-link__item\"><a href=\"/careers/recruit/welfare/\" class=\"str-nav-menu-link__link\">福利厚生</a></li>\r\n<li class=\"str-nav-menu-link__item\"><a href=\"https://www.kyowakirin.co.jp/sustainability/human_resources_infrastructure/dei/index.html\" target=\"_blank\" class=\"str-nav-menu-link__link\">ダイバーシティへの取り組み<svg class=\"m-icon m-icon--blank-default\" role=\"img\" aria-label=\"別窓で開く\"><use href=\"#icon-blank-default\"></use></svg></a></li>\r\n<li class=\"str-nav-menu-link__item\"><a href=\"https://www.kyowakirin.co.jp/sustainability/human_resources_infrastructure/portfolio/workplace_safety/index.html\" target=\"_blank\" class=\"str-nav-menu-link__link\">健康経営<svg class=\"m-icon m-icon--blank-default\" role=\"img\" aria-label=\"別窓で開く\"><use href=\"#icon-blank-default\"></use></svg></a></li>\r\n</ul>\r\n<!--  /.str-nav-menu__body  --></div>\r\n<!--  /.str-nav-menu  --></div>\r\n<!--  /.str-nav__item  --></div>\r\n\r\n<div class=\"str-nav__item\">\r\n<p class=\"str-nav__title js-gnav-toggle-btn\">Cross Talk（クロストーク）</p>\r\n\r\n<div class=\"str-nav-menu\">\r\n<div class=\"str-nav-menu__body\">\r\n<ul class=\"str-nav-menu-link\" data-col=\"1\" data-col-wide=\"3\">\r\n<li class=\"str-nav-menu-link__item\"><a href=\"/careers/recruit/talk/03.html\" class=\"str-nav-menu-link__link\">患者さんの声を大切に形にする活動</a></li>\r\n<li class=\"str-nav-menu-link__item\"><a href=\"/careers/recruit/talk/02.html\" class=\"str-nav-menu-link__link\">協和キリンのグローバル化</a></li>\r\n</ul>\r\n<!--  /.str-nav-menu__body  --></div>\r\n<!--  /.str-nav-menu  --></div>\r\n<!--  /.str-nav__item  --></div>\r\n\r\n<div class=\"str-nav__item\">\r\n<p class=\"str-nav__title js-gnav-toggle-btn\">Recruit（採用情報）</p>\r\n\r\n<div class=\"str-nav-menu\">\r\n<div class=\"str-nav-menu__body\">\r\n<ul class=\"str-nav-menu-link\" data-col=\"1\" data-col-wide=\"3\">\r\n<li class=\"str-nav-menu-link__item\"><a href=\"/careers/recruit/guideline/\" class=\"str-nav-menu-link__link\">新卒採用</a></li>\r\n<li class=\"str-nav-menu-link__item\"><a href=\"https://hrmos.co/pages/kyowakirin\" target=\"_blank\" class=\"str-nav-menu-link__link\">キャリア採用<svg class=\"m-icon m-icon--blank-default\" role=\"img\" aria-label=\"別窓で開く\"><use href=\"#icon-blank-default\"></use></svg></a></li>\r\n<li class=\"str-nav-menu-link__item\"><a href=\"/careers/recruit/handicapped/\" class=\"str-nav-menu-link__link\">障害者採用</a></li>\r\n<li class=\"str-nav-menu-link__item\"><a href=\"/careers/recruit/faq/\" class=\"str-nav-menu-link__link\">FAQ</a></li>\r\n</ul>\r\n<!--  /.str-nav-menu__body  --></div>\r\n<!--  /.str-nav-menu  --></div>\r\n<!--  /.str-nav__item  --></div>\r\n\r\n<!--  /.str-nav__body  --></div>\r\n<!--  /.str-nav  --></nav>\r\n<!--  /.str-header  --></header>\r\n</div>\r\n<!--  /careers/recruit/share/inc/header.html include end  -->\r\n\r\n<main class=\"str-main\">\r\n<nav class=\"str-breadcrumb\" aria-label=\"breadcrumb\">\r\n<ol class=\"str-breadcrumb__list\">\r\n<li class=\"str-breadcrumb__item\"><a href=\"/careers/recruit/\" class=\"str-breadcrumb__text str-breadcrumb__text--top\"><span class=\"str-breadcrumb__label\">ホーム</span></a></li>\r\n<li class=\"str-breadcrumb__item\"><span class=\"str-breadcrumb__text\" aria-current=\"page\">FAQ</span></li>\r\n</ol>\r\n<!--  /.breadcrumb  --></nav>\r\n\r\n<div class=\"m-hdg-lv1-2\">\r\n<h1 class=\"m-hdg-lv1-2__title\">FAQ</h1>\r\n<!--  /.m-hdg-lv1-2  --></div>\r\n\r\n<div class=\"str-section\">\r\n<div class=\"str-section__inner\">\r\n\r\n<div class=\"m-tab-2 js-tab\">\r\n<ul class=\"m-tab-2__ul js-tab-list\">\r\n<li class=\"m-tab-2__li\">\r\n<a href=\"#tab-group-01\" class=\"m-tab-2__btn js-tab-trigger is-opened\"><span class=\"m-tab-2__icon\">共通</span></a>\r\n</li>\r\n<li class=\"m-tab-2__li\">\r\n<a href=\"#tab-group-02\" class=\"m-tab-2__btn js-tab-trigger\"><span class=\"m-tab-2__icon\">新卒</span></a>\r\n</li>\r\n<li class=\"m-tab-2__li\">\r\n<a href=\"#tab-group-03\" class=\"m-tab-2__btn js-tab-trigger\"><span class=\"m-tab-2__icon\">キャリア</span></a>\r\n</li>\r\n<!--  /.m-tab-2__ul  --></ul>\r\n\r\n<div class=\"m-tab-2__panel js-tab-content\" id=\"tab-group-01\">\r\n<div class=\"m-hdg-lv2\">\r\n<h2 class=\"m-hdg-lv2__title\">会社について</h2>\r\n<!--  /.m-hdg-lv2  --></div>\r\n\r\n<dl class=\"m-list-question\">\r\n<div class=\"m-list-question__item\">\r\n<dt class=\"m-list-question__question\">\r\n<span class=\"m-list-question__symbol\">Q</span>\r\n<div class=\"m-list-question__content\">協和キリンの売上高研究開発費比率を教えてください。</div>\r\n</dt>\r\n<dd class=\"m-list-question__answer\">\r\n<span class=\"m-list-question__symbol\">A</span>\r\n<div class=\"m-list-question__content\">こちらの最新の<a href=\"https://ir.kyowakirin.com/ja/library/annual.html\" target=\"_blank\">統合報告書<svg class=\"m-icon m-icon--blank-default\" role=\"img\" aria-label=\"別窓で開く\"><use href=\"#icon-blank-default\"></use></svg></a>をご参考にしてください。</div>\r\n</dd>\r\n<!--  /.m-list-question__item  --></div>\r\n\r\n<div class=\"m-list-question__item\">\r\n<dt class=\"m-list-question__question\">\r\n<span class=\"m-list-question__symbol\">Q</span>\r\n<div class=\"m-list-question__content\">ワークライフバランスの実現に向けてどのように取り組んでいますか？</div>\r\n</dt>\r\n<dd class=\"m-list-question__answer\">\r\n<span class=\"m-list-question__symbol\">A</span>\r\n<div class=\"m-list-question__content\">協和キリンではワークライフバランスを支援する様々な制度があります。<br>\r\n詳細は<a href=\"/careers/recruit/welfare/\">福利厚生ページ</a>をご覧ください。</div>\r\n</dd>\r\n<!--  /.m-list-question__item  --></div>\r\n<!--  /.m-list-question  --></dl>\r\n\r\n<div class=\"m-hdg-lv2\">\r\n<h2 class=\"m-hdg-lv2__title\">応募について</h2>\r\n<!--  /.m-hdg-lv2  --></div>\r\n\r\n<dl class=\"m-list-question\">\r\n<div class=\"m-list-question__item\">\r\n<dt class=\"m-list-question__question\">\r\n<span class=\"m-list-question__symbol\">Q</span>\r\n<div class=\"m-list-question__content\">複数ポジションの併願応募はできますか？</div>\r\n</dt>\r\n<dd class=\"m-list-question__answer\">\r\n<span class=\"m-list-question__symbol\">A</span>\r\n<div class=\"m-list-question__content\">併願応募はできません。1ポジションずつご応募ください。</div>\r\n</dd>\r\n<!--  /.m-list-question__item  --></div>\r\n\r\n<div class=\"m-list-question__item\">\r\n<dt class=\"m-list-question__question\">\r\n<span class=\"m-list-question__symbol\">Q</span>\r\n<div class=\"m-list-question__content\">外国籍の方の採用は行っていますか？</div>\r\n</dt>\r\n<dd class=\"m-list-question__answer\">\r\n<span class=\"m-list-question__symbol\">A</span>\r\n<div class=\"m-list-question__content\">国籍による制限はありません。ただし、業務上ビジネスレベル以上の日本語力を求めるポジションが多くあります。詳細は募集要項を確認してください。</div>\r\n</dd>\r\n<!--  /.m-list-question__item  --></div>\r\n<!--  /.m-list-question  --></dl>\r\n\r\n<div class=\"m-hdg-lv2\">\r\n<h2 class=\"m-hdg-lv2__title\">入社後について</h2>\r\n<!--  /.m-hdg-lv2  --></div>\r\n\r\n<dl class=\"m-list-question\">\r\n<div class=\"m-list-question__item\">\r\n<dt class=\"m-list-question__question\">\r\n<span class=\"m-list-question__symbol\">Q</span>\r\n<div class=\"m-list-question__content\">試用期間はありますか？</div>\r\n</dt>\r\n<dd class=\"m-list-question__answer\">\r\n<span class=\"m-list-question__symbol\">A</span>\r\n<div class=\"m-list-question__content\">試用期間は6か月間です。</div>\r\n</dd>\r\n<!--  /.m-list-question__item  --></div>\r\n\r\n<div class=\"m-list-question__item\">\r\n<dt class=\"m-list-question__question\">\r\n<span class=\"m-list-question__symbol\">Q</span>\r\n<div class=\"m-list-question__content\">海外赴任の可能性はありますか？</div>\r\n</dt>\r\n<dd class=\"m-list-question__answer\">\r\n<span class=\"m-list-question__symbol\">A</span>\r\n<div class=\"m-list-question__content\">海外赴任の可能性はあります。会社が適性やご本人の希望等を考慮して総合的に判断します。</div>\r\n</dd>\r\n<!--  /.m-list-question__item  --></div>\r\n\r\n<div class=\"m-list-question__item\">\r\n<dt class=\"m-list-question__question\">\r\n<span class=\"m-list-question__symbol\">Q</span>\r\n<div class=\"m-list-question__content\">入社後のキャリアパスについて会社に申告できますか？</div>\r\n</dt>\r\n<dd class=\"m-list-question__answer\">\r\n<span class=\"m-list-question__symbol\">A</span>\r\n<div class=\"m-list-question__content\">年に1度、会社が指定する書式を用いて今後のキャリアについて申告する機会があります。<br>\r\nその書式は中長期的な視点に立ったキャリア形成について具体的に考えるためのシートで、社員一人ひとりが年に1回作成します。<br>\r\n上長との面談の中で、このシートをもとにアドバイスを受けることにより、社員一人ひとりのキャリアプランと会社が目指す能力開発の方向性を相互に確認することができます。<br>\r\nまた、社内公募制度があります。協和キリングループの中で実現したいキャリアを一人ひとりが自ら見つけ、会社はその実現に向け努力することを支援していく施策の一環です。<br>\r\n<a href=\"https://www.kyowakirin.co.jp/sustainability/human_resources_infrastructure/portfolio/index.html\" target=\"_blank\">関連するページはこちら<svg class=\"m-icon m-icon--blank-default\" role=\"img\" aria-label=\"別窓で開く\"><use href=\"#icon-blank-default\"></use></svg></a></div>\r\n\r\n</dd>\r\n<!--  /.m-list-question__item  --></div>\r\n\r\n<div class=\"m-list-question__item\">\r\n<dt class=\"m-list-question__question\">\r\n<span class=\"m-list-question__symbol\">Q</span>\r\n<div class=\"m-list-question__content\">異動はありますか？</div>\r\n</dt>\r\n<dd class=\"m-list-question__answer\">\r\n<span class=\"m-list-question__symbol\">A</span>\r\n<div class=\"m-list-question__content\">協和キリンが募集している職種は、原則として全国転勤・異動が可能な方となります。<br>\r\n異動先は「本人の希望・事情」「本人の適性・育成の観点」「職場ごとの必要要員数」等を総合的に考えた上、会社が決定します。</div>\r\n</dd>\r\n<!--  /.m-list-question__item  --></div>\r\n\r\n<div class=\"m-list-question__item\">\r\n<dt class=\"m-list-question__question\">\r\n<span class=\"m-list-question__symbol\">Q</span>\r\n<div class=\"m-list-question__content\">在宅勤務はできますか？</div>\r\n</dt>\r\n<dd class=\"m-list-question__answer\">\r\n<span class=\"m-list-question__symbol\">A</span>\r\n<div class=\"m-list-question__content\">在宅勤務制度があり会社が承認した場合に利用することができます。所属する本部や各部署・グループ、担当業務によって利用頻度は異なります。</div>\r\n</dd>\r\n<!--  /.m-list-question__item  --></div>\r\n<!--  /.m-list-question  --></dl>\r\n\r\n<div class=\"m-hdg-lv2\">\r\n<h2 class=\"m-hdg-lv2__title\">福利厚生について</h2>\r\n<!--  /.m-hdg-lv2  --></div>\r\n\r\n\r\n<dl class=\"m-list-question\">\r\n<div class=\"m-list-question__item\">\r\n<dt class=\"m-list-question__question\">\r\n<span class=\"m-list-question__symbol\">Q</span>\r\n<div class=\"m-list-question__content\">どのような福利厚生がありますか？</div>\r\n</dt>\r\n<dd class=\"m-list-question__answer\">\r\n<span class=\"m-list-question__symbol\">A</span>\r\n<div class=\"m-list-question__content\">手当類に関しては社宅の補助、家族手当、別居手当などがあります。他、退職給付制度、確定拠出年金、各種保険、従業員持株会、財形貯蓄、各種福利厚生サービスの利用（会員価格での提供）などもあります。<a href=\"/careers/recruit/welfare/\">福利厚生ページ</a>をご参考にしてください。</div>\r\n</dd>\r\n<!--  /.m-list-question__item  --></div>\r\n\r\n<div class=\"m-list-question__item\">\r\n<dt class=\"m-list-question__question\">\r\n<span class=\"m-list-question__symbol\">Q</span>\r\n<div class=\"m-list-question__content\">育児休暇はいつから取得できますか？</div>\r\n</dt>\r\n<dd class=\"m-list-question__answer\">\r\n<span class=\"m-list-question__symbol\">A</span>\r\n<div class=\"m-list-question__content\">こちらの<a href=\"/careers/recruit/welfare/#anc-support\">出産・育児・介護・転勤などをサポートする制度</a>をご参考にしてください。</div>\r\n</dd>\r\n<!--  /.m-list-question__item  --></div>\r\n<!--  /.m-list-question  --></dl>\r\n<!--  /.m-tab-2__panel  --></div>\r\n\r\n<div class=\"m-tab-2__panel js-tab-content\" id=\"tab-group-02\">\r\n<div class=\"m-hdg-lv2\">\r\n<h2 class=\"m-hdg-lv2__title\">応募について</h2>\r\n<!--  /.m-hdg-lv2  --></div>\r\n\r\n<dl class=\"m-list-question\">\r\n<div class=\"m-list-question__item\">\r\n<dt class=\"m-list-question__question\">\r\n<span class=\"m-list-question__symbol\">Q</span>\r\n<div class=\"m-list-question__content\">募集職種及び仕事内容について教えてください。</div>\r\n</dt>\r\n<dd class=\"m-list-question__answer\">\r\n<span class=\"m-list-question__symbol\">A</span>\r\n<div class=\"m-list-question__content\"><a href=\"/careers/recruit/guideline/\">募集要項</a>および<a href=\"/careers/recruit/work/\">職種紹介</a>ページをご覧ください。</div>\r\n</dd>\r\n<!--  /.m-list-question__item  --></div>\r\n\r\n<div class=\"m-list-question__item\">\r\n<dt class=\"m-list-question__question\">\r\n<span class=\"m-list-question__symbol\">Q</span>\r\n<div class=\"m-list-question__content\">既に、大学/大学院を卒業していますが、応募できますか？</div>\r\n</dt>\r\n<dd class=\"m-list-question__answer\">\r\n<span class=\"m-list-question__symbol\">A</span>\r\n<div class=\"m-list-question__content\"><a href=\"/careers/recruit/guideline/\">新卒採用の募集要項</a>をご確認ください。</div>\r\n</dd>\r\n<!--  /.m-list-question__item  --></div>\r\n\r\n<div class=\"m-list-question__item\">\r\n<dt class=\"m-list-question__question\">\r\n<span class=\"m-list-question__symbol\">Q</span>\r\n<div class=\"m-list-question__content\">留学生は応募できますか？ また、留学生向けの選考はありますか？海外大学に在籍する学生向けの選考はありますか？</div>\r\n</dt>\r\n<dd class=\"m-list-question__answer\">\r\n<span class=\"m-list-question__symbol\">A</span>\r\n<div class=\"m-list-question__content\">国籍に関わらず応募できますが、留学生のみ対象とした選考はご用意していません。<br>\r\n新卒採用より応募してください。積極的なご応募をお待ちしています。</div>\r\n</dd>\r\n<!--  /.m-list-question__item  --></div>\r\n\r\n<div class=\"m-list-question__item\">\r\n<dt class=\"m-list-question__question\">\r\n<span class=\"m-list-question__symbol\">Q</span>\r\n<div class=\"m-list-question__content\">海外大学に在籍する学生（卒業・修了見込み）は応募できますか？</div>\r\n</dt>\r\n<dd class=\"m-list-question__answer\">\r\n<span class=\"m-list-question__symbol\">A</span>\r\n<div class=\"m-list-question__content\">国内外の大学に関わらず応募できますが、海外大学の在籍学生のみ対象とした選考はご用意していません。<br>\r\n新卒採用より応募してください。積極的なご応募をお待ちしています。</div>\r\n</dd>\r\n<!--  /.m-list-question__item  --></div>\r\n\r\n<div class=\"m-list-question__item\">\r\n<dt class=\"m-list-question__question\">\r\n<span class=\"m-list-question__symbol\">Q</span>\r\n<div class=\"m-list-question__content\">研究職について、現在の研究テーマは選考に関係ありますか？</div>\r\n</dt>\r\n<dd class=\"m-list-question__answer\">\r\n<span class=\"m-list-question__symbol\">A</span>\r\n<div class=\"m-list-question__content\">研究概要は参考情報として確認しますが、研究テーマのみで採用を決めることはありません。<br>\r\n専門分野に関わらず、積極的なご応募をお待ちしております。</div>\r\n</dd>\r\n<!--  /.m-list-question__item  --></div>\r\n\r\n<div class=\"m-list-question__item\">\r\n<dt class=\"m-list-question__question\">\r\n<span class=\"m-list-question__symbol\">Q</span>\r\n<div class=\"m-list-question__content\">OB・OG訪問をしたいのですが、社員の方を紹介してくれますか？</div>\r\n</dt>\r\n<dd class=\"m-list-question__answer\">\r\n<span class=\"m-list-question__symbol\">A</span>\r\n<div class=\"m-list-question__content\">OB・OGのご紹介は一律お断りしております。個人的にOB・OGを訪問されることは制限しておりませんので、ご検討ください。</div>\r\n</dd>\r\n<!--  /.m-list-question__item  --></div>\r\n<!--  /.m-list-question  --></dl>\r\n\r\n<div class=\"m-hdg-lv2\">\r\n<h2 class=\"m-hdg-lv2__title\">入社後について</h2>\r\n<!--  /.m-hdg-lv2  --></div>\r\n\r\n<dl class=\"m-list-question\">\r\n<div class=\"m-list-question__item\">\r\n<dt class=\"m-list-question__question\">\r\n<span class=\"m-list-question__symbol\">Q</span>\r\n<div class=\"m-list-question__content\">入社後の配属はどのように決まりますか？</div>\r\n</dt>\r\n<dd class=\"m-list-question__answer\">\r\n<span class=\"m-list-question__symbol\">A</span>\r\n<div class=\"m-list-question__content\">ご本人の適性および人員配置の状況により決定します。</div>\r\n</dd>\r\n<!--  /.m-list-question__item  --></div>\r\n<!--  /.m-list-question  --></dl>\r\n<!--  /.m-tab-2__panel  --></div>\r\n\r\n<div class=\"m-tab-2__panel js-tab-content\" id=\"tab-group-03\">\r\n<div class=\"m-hdg-lv2\">\r\n<h2 class=\"m-hdg-lv2__title\">応募について</h2>\r\n<!--  /.m-hdg-lv2  --></div>\r\n\r\n<dl class=\"m-list-question\">\r\n<div class=\"m-list-question__item\">\r\n<dt class=\"m-list-question__question\">\r\n<span class=\"m-list-question__symbol\">Q</span>\r\n<div class=\"m-list-question__content\">応募方法を教えてください</div>\r\n</dt>\r\n<dd class=\"m-list-question__answer\">\r\n<span class=\"m-list-question__symbol\">A</span>\r\n<div class=\"m-list-question__content\">応募は<a href=\"https://hrmos.co/pages/kyowakirin\" target=\"_blank\">こちらのキャリア採用ホームページ<svg class=\"m-icon m-icon--blank-default\" role=\"img\" aria-label=\"別窓で開く\"><use href=\"#icon-blank-default\"></use></svg></a>から受け付けております。<a href=\"https://hrmos.co/pages/kyowakirin/jobs\" target=\"_blank\">募集職種一覧<svg class=\"m-icon m-icon--blank-default\" role=\"img\" aria-label=\"別窓で開く\"><use href=\"#icon-blank-default\"></use></svg></a>をご覧のうえエントリーしてください。電話・郵便・FAXでの応募は受け付けておりません。</div>\r\n</dd>\r\n<!--  /.m-list-question__item  --></div>\r\n\r\n<div class=\"m-list-question__item\">\r\n<dt class=\"m-list-question__question\">\r\n<span class=\"m-list-question__symbol\">Q</span>\r\n<div class=\"m-list-question__content\">過去に応募したことのあるポジションに再応募可能ですか？</div>\r\n</dt>\r\n<dd class=\"m-list-question__answer\">\r\n<span class=\"m-list-question__symbol\">A</span>\r\n<div class=\"m-list-question__content\">原則1年以内に同じポジションに再応募することはできません。</div>\r\n</dd>\r\n<!--  /.m-list-question__item  --></div>\r\n\r\n<div class=\"m-list-question__item\">\r\n<dt class=\"m-list-question__question\">\r\n<span class=\"m-list-question__symbol\">Q</span>\r\n<div class=\"m-list-question__content\">応募から入社までの選考プロセスを教えてください</div>\r\n</dt>\r\n<dd class=\"m-list-question__answer\">\r\n<span class=\"m-list-question__symbol\">A</span>\r\n<div class=\"m-list-question__content\">書類選考、一次面接、SPI試験（オンライン）、最終面接、内定となります。ポジションによりSPI試験のタイミングが異なる場合や、英語での面接を別途実施させていただく場合があります。</div>\r\n</dd>\r\n<!--  /.m-list-question__item  --></div>\r\n\r\n<div class=\"m-list-question__item\">\r\n<dt class=\"m-list-question__question\">\r\n<span class=\"m-list-question__symbol\">Q</span>\r\n<div class=\"m-list-question__content\">以前、協和キリンに在籍していた人の応募は可能ですか？</div>\r\n</dt>\r\n<dd class=\"m-list-question__answer\">\r\n<span class=\"m-list-question__symbol\">A</span>\r\n<div class=\"m-list-question__content\">可能です。</div>\r\n</dd>\r\n<!--  /.m-list-question__item  --></div>\r\n\r\n<div class=\"m-list-question__item\">\r\n<dt class=\"m-list-question__question\">\r\n<span class=\"m-list-question__symbol\">Q</span>\r\n<div class=\"m-list-question__content\">面接は対面ですか？</div>\r\n</dt>\r\n<dd class=\"m-list-question__answer\">\r\n<span class=\"m-list-question__symbol\">A</span>\r\n<div class=\"m-list-question__content\">現在は原則オンラインで実施しています。</div>\r\n</dd>\r\n<!--  /.m-list-question__item  --></div>\r\n<!--  /.m-list-question  --></dl>\r\n\r\n<div class=\"m-hdg-lv2\">\r\n<h2 class=\"m-hdg-lv2__title\">入社後について</h2>\r\n<!--  /.m-hdg-lv2  --></div>\r\n\r\n<dl class=\"m-list-question\">\r\n<div class=\"m-list-question__item\">\r\n<dt class=\"m-list-question__question\">\r\n<span class=\"m-list-question__symbol\">Q</span>\r\n<div class=\"m-list-question__content\">入社時期はいつですか。</div>\r\n</dt>\r\n<dd class=\"m-list-question__answer\">\r\n<span class=\"m-list-question__symbol\">A</span>\r\n<div class=\"m-list-question__content\">入社日は毎月1日付の入社となります。</div>\r\n</dd>\r\n<!--  /.m-list-question__item  --></div>\r\n\r\n<div class=\"m-list-question__item\">\r\n<dt class=\"m-list-question__question\">\r\n<span class=\"m-list-question__symbol\">Q</span>\r\n<div class=\"m-list-question__content\">年次有給休暇は入社直後から使えますか？年度途中からの入社では付与日数はどのくらいですか？</div>\r\n</dt>\r\n<dd class=\"m-list-question__answer\">\r\n<span class=\"m-list-question__symbol\">A</span>\r\n<div class=\"m-list-question__content\">付与されていれば直後から使用できます。付与日数は入社月ごとに異なり、4月時点で20日が付与されます。\r\nまた、年休のほかに、通院や家族の介護、ボランティア活動等の取得事由がある際に利用できるセルフマネジメント休暇（有給休暇10日間）が付与されます。詳細は<a href=\"/careers/recruit/welfare/#anc-leave\">福利厚生ページの休暇制度</a>をご参考にしてください。</div>\r\n</dd>\r\n<!--  /.m-list-question__item  --></div>\r\n<!--  /.m-list-question  --></dl>\r\n<!--  /.m-tab-2__panel  --></div>\r\n<!--  /.m-tab-2  --></div>\r\n<!--  /.str-section__inner  --></div>\r\n<!--  /.str-section  --></div></main>\r\n\r\n<nav class=\"str-breadcrumb str-breadcrumb--bottom\" aria-label=\"breadcrumb\">\r\n<ol class=\"str-breadcrumb__list\">\r\n<li class=\"str-breadcrumb__item\"><a href=\"/careers/recruit/\" class=\"str-breadcrumb__text str-breadcrumb__text--top\"><span class=\"str-breadcrumb__label\">ホーム</span></a></li>\r\n<li class=\"str-breadcrumb__item\"><span class=\"str-breadcrumb__text\" aria-current=\"page\">FAQ</span></li>\r\n</ol>\r\n<!--  /.breadcrumb  --></nav>\r\n\r\n<!--  /careers/recruit/share/inc/footer.html include start  -->\r\n<div class=\"inc_careers_recruit_share_inc_footer\">\r\n<div class=\"str-pagetop\">\r\n<p class=\"str-pagetop__body\"><a href=\"#top\" class=\"str-pagetop__btn\"><span class=\"str-pagetop__label\">ページトップへ</span></a></p>\r\n<!--  /.str-pagetop  --></div>\r\n\r\n<section class=\"str-entry\">\r\n<div class=\"str-entry__inner\">\r\n<h2 class=\"str-entry__hdg\">Entry &amp; Mypage<span>エントリー・マイページ</span></h2>\r\n\r\n<ul class=\"str-entry-link\">\r\n<li class=\"str-entry-link__item\"><a href=\"https://mypage.3010.i-webs.jp/kyowakirin2028/\" target=\"_blank\" class=\"str-entry-link__link\">新卒 2028年卒<br>ENTRY・MY PAGE<svg class=\"m-icon m-icon--blank\" role=\"img\" aria-label=\"別窓で開く\"><use href=\"#icon-blank\"></use></svg></a></li>\r\n<li class=\"str-entry-link__item\"><a href=\"https://mypage.3010.i-webs.jp/kyowakirin2027/\" target=\"_blank\" class=\"str-entry-link__link str-entry-link__link\">新卒 2027年卒<br>ENTRY・MY PAGE<svg class=\"m-icon m-icon--blank\" role=\"img\" aria-label=\"別窓で開く\"><use href=\"#icon-blank\"></use></svg></a></li>\r\n<li class=\"str-entry-link__item\"><a href=\"https://hrmos.co/pages/kyowakirin\" target=\"_blank\" class=\"str-entry-link__link\">キャリア採用<svg class=\"m-icon m-icon--blank\" role=\"img\" aria-label=\"別窓で開く\"><use href=\"#icon-blank\"></use></svg></a></li>\r\n<!--  /.str-entry-link  --></ul>\r\n<!--  /.str-entry__inner  --></div>\r\n<!--  /.str-entry  --></section>\r\n\r\n<nav class=\"str-footer-nav\">\r\n<div class=\"str-footer-nav__body\">\r\n<div class=\"str-footer-nav__inner\">\r\n\r\n