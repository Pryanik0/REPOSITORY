g']);\n            (function () {\n                var u = 'https://bmedx.com/analytics/';\n                _paq.push(['setTrackerUrl', u + 'matomo.php']);\n                _paq.push(['setSiteId', '2']);\n                var d = document, g = d.createElement('script'), s = d.getElementsByTagName('script')[0];\n                g.async = true;\n                g.src = u + 'matomo.js';\n                s.parentNode.insertBefore(g, s);\n            }());\n        }\n\n        // Apply a previously stored choice before the DOM is ready\n        if (consent === 'all') {\n            initMatomo();\n        } else if (consent === 'necessary') {\n            _paq.push(['optUserOut']);\n        }\n\n        // -- UI wiring (runs after DOM is ready) ---------------------------\n        document.addEventListener('DOMContentLoaded', function () {\n            var main   = document.getElementById('cc1990kb-main');\n            var banner = document.getElementById('cc1990kb-cookie-consent-banner');\n            var modal  = document.getElementById('cc1990kb-cookie-settings-modal');\n            var html   = document.documentElement;\n\n            if (!main) { return; }\n\n            function closeAll() {\n                main.classList.remove('is-open');\n                if (banner) { banner.classList.remove('is-open'); }\n                if (modal)  { modal.classList.remove('is-open'); }\n                html.classList.remove('cc1990kb-main-is-open');\n            }\n\n            function openBanner() {\n                if (modal)  { modal.classList.remove('is-open'); }\n                if (banner) { banner.classList.add('is-open'); }\n                main.classList.add('is-open');\n                html.classList.add('cc1990kb-main-is-open');\n            }\n\n            function openModal() {\n                if (banner) { banner.classList.remove('is-open'); }\n                if (modal)  { modal.classList.add('is-open'); }\n                main.classList.add('is-open');\n  