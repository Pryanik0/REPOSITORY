tem\">\n                                    <a class=\"logo-slider-item-link\" href=\"https://bmedx.com\" target=\"_blank\">\n                                        <span class=\"logo-slider-item-image-container\">\n                                                                                            <span class=\"logo-slider-item-image\" style=\"background-image: url('https://career.bmedx.com/sitelogo/pG8_XSeedLabsLogoWeb.jpg')\"></span>\n                                                                                    </span>\n                                        <p class=\"logo-slider-caption\">XSeed Labs, Ridgefield</p>\n                                    </a>\n                                </li>\n                                                            <li class=\"logo-slider-item element-slider-item\">\n                                    <a class=\"logo-slider-item-link\" href=\"https://bmedx.com\" target=\"_blank\">\n                                        <span class=\"logo-slider-item-image-container\">\n                                                                                            <span class=\"logo-slider-item-image\" style=\"background-image: url('https://career.bmedx.com/sitelogo/4tE_BioMedXLogoWeb.jpg')\"></span>\n                                                                                    </span>\n                                        <p class=\"logo-slider-caption\">BioMed X Institutes, Heidelberg or New Haven</p>\n                                    </a>\n                                </li>\n                                                            <li class=\"logo-slider-item element-slider-item\">\n                                    <a class=\"logo-slider-item-link\" href=\"https://bmedx.com\" target=\"_blank\">\n                                        <span class=\"logo-slider-item-image-container\">\n                                                                                            <span class=\"logo-slider-item-image\" style=\"background-image: url('https://career.bmedx.com/sitelogo/kRh_XSeedLabsLogoWeb.jpg')\"></span>\n                                                                                    </span>\n                                        <p class=\"logo-slider-caption\">XSeed Labs, Paris-Saclay</p>\n                                    </a>\n                                </li>\n                                                            <li class=\"logo-slider-item element-slider-item\">\n                                    <a class=\"logo-slider-item-link\" href=\"https://bmedx.com\" target=\"_blank\">\n                                        <span class=\"logo-slider-item-image-container\">\n                                                                                            <span class=\"logo-slider-item-image\" style=\"background-image: url('https://career.bmedx.com/sitelogo/EED_BioMedXLogoWeb.jpg')\"></span>\n                                                                                    </span>\n                                        <p class=\"logo-slider-caption\">BioMed X, Barbados</p>\n                                    </a>\n                                </li>\n                                                            <li class=\"logo-slider-item element-slider-item\">\n                                    <a class=\"logo-slider-item-link\" href=\"https://bmedx.com\" target=\"_blank\">\n                                        <span class=\"logo-slider-item-image-container\">\n                                                                                            <span class=\"logo-slider-item-image\" style=\"background-image: url('https://career.bmedx.com/sitelogo/FpB_XFemLabsLogoWeb.jpg')\"></span>\n                                                                                    </span>\n                                        <p class=\"logo-slider-caption\">XFem Labs, Heidelberg</p>\n                                    </a>\n                                </li>\n                                                    </ul>\n                        <div class=\"slider-navigation-container\">\n                            <button class=\"element-slider-prev logo-slider-prev\">\n                                <span class=\"icon\" data-icon=\"arrow-left-alternate\"></span>\n                            </button>\n                            <button class=\"element-slider-next logo-slider-next\">\n                                <span class=\"icon\" data-icon=\"arrow-right-alternate\"></span>\n                            </button>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    \n    <div class=\"row\">\n        <div class=\"col desktop-12 tablet-12 phablet-12 phone-12 content-box\" data-boxcolor=\"gray-outline\">\n            <h1>BioMed X Career Space</h1>\n            <h3>We provide new career perspectives at the interface between academia and industry.</h3>\n            <div class=\"row\">\n                <div class=\"col desktop-12 tablet-12 phablet-12 phone-12\">\n                    <p>\n                        Welcome to the BioMed X Career Space. It enables you to apply for research career opportunities at the interface between academia and industry at all our BioMed X locations worldwide. As part of this community, we will keep you updated about future calls for application and job offers. You can always come back, update your profile, and submit a new application.\n                    </p>\n                </div>\n            </div>\n\n            <div class=\"row\">\n\n                <div class=\"col desktop-7 tablet-7 phablet-12 phone-12\">\n                    <p class=\"red\">To access this page, please login with your email address and password.</p>\n                    <div class=\"content-box\" data-boxcolor=\"light-gray\">\n                        <p>If you have not registered yet, please <a href=\"/registration\">register here</a>.</p>\n                        <p>If you don't remember your password, please <a href=\"/reset\">reset your password here</a>.</p>\n                        <p>For comments or suggestions, please contact us at <a href=\"mailto:career@bmedx.com\">career@bmedx.com</a>.</p>\n                    </div>\n                </div>\n                <div class=\"col desktop-5 tablet-5 phablet-12 phone-12\">\n\n                    <div class=\"content-box\" data-boxcolor=\"white\" id=\"login-form\">\n                        <form action=\"/login_check\" method=\"post\">\n                            <label for=\"email\">Email</label>\n                            <input class=\"size-medium\" type=\"text\" id=\"email\" name=\"_email\" value=\"\">\n                            <label for=\"email\">Password</label>\n                            <input class=\"size-medium\" type=\"password\" id=\"password\" name=\"_password\">\n                            <div class=\"form-footer-cta\">\n                                <button type=\"submit\">Login</button>\n                            </div>\n                        </form>\n                    </div>\n\n                </div>\n\n            </div>\n        </div>\n    </div>\n\n\n            </div>\n\n        </section>\n    </article>\n\n    <!-- SEITEN-FOOTER -->\n                                                <footer id=\"site-footer\">\n\n        <div class=\"site-footer-section-social-media\">\n            <div class=\"grid\">\n                <ul>\n                    <li><a href=\"https://www.linkedin.com/company/biomed-x-institute/\" target=\"_blank\" rel=\"noopener\"><span class=\"has-icon\" data-icon=\"linkedin\">LinkedIn</span></a></li>\n                    <li><a href=\"https://www.youtube.com/channel/UC_bFsCYwZ2FD3JhPk-IKkrA\" target=\"_blank\" rel=\"noopener\"><span class=\"has-icon\" data-icon=\"youtube\">YouTube</span></a></li>\n                    <li><a href=\"https://bsky.app/profile/biomedx.bsky.social\" target=\"_blank\" rel=\"noopener\"><span class=\"has-icon\" data-icon=\"bluesky\">Bluesky</span></a></li>\n                    <li><a href=\"https://bmedx.com/contact/\"><span class=\"has-icon\" data-icon=\"mail-outlined\">Contact</span></a></li>\n                </ul>\n            </div>\n        </div>\n\n        <div class=\"site-footer-section-main section-padding\">\n            <div class=\"grid tbe-module-grid\">\n                <div class=\"row gutter-h-60\">\n                    <div class=\"col desktop-5 tablet-10 phablet-12 phone-12 tbe-module-marginal-column-right tbe-module-column\">\n                        <p><strong>ABOUT BioMed X</strong></p>\n                        <p>BioMed X is a leading innovation hub for pharma. With our global network of research institutes at top universities and incubators within pharmaceutical companies, we bridge the gap between academia and industry.</p>\n                        <p>We are pioneers in applying the principles of design thinking and crowdsourcing to drug discovery and development. With our unique model, we identify key challenges across all therapeutic areas, recruit top academic talent, and co-create tailored solutions with our pharma partners.</p>\n                        <p>In our stimulating ecosystem, early-career researchers grow into future scientific leaders. They perform exploratory research, deliver industry-grade results, and pave the way to next-generation therapies. At BioMed X, we value curiosity, diversity, and purpose. Our goal is to serve as a vital catalyst for innovation in global health for the benefit of all patients.</p>\n                    </div>\n                    <div class=\"col desktop-4 tablet-6 phablet-6 phone-12 tbe-module-marginal-column-right tbe-module-column\">\n                        <h6>Contact</h6>\n                        <p><span class=\"has-icon\" data-icon=\"location-outlined\"><strong>BioMed X Germany GmbH</strong><br>\n                        Im Neuenheimer Feld 515<br>\n                        69120 Heidelberg, Germany</span></p>\n                        <p>\n                            <span class=\"has-icon\" data-icon=\"phone-outlined\"><a href=\"tel:+496221426110\">+49 6221 426 11 0</a></span><br>\n                            <span class=\"has-icon\" data-icon=\"fax-outlined\">+49 6221 426 11 22</span><br>\n                            <a href=\"mailto:info@bmedx.com\"><span class=\"has-icon\" data-icon=\"mail-outlined\">info@bmedx.com</span></a>\n                        </p>\n                    </div>\n                    <div class=\"col desktop-3 tablet-6 phablet-6 phone-12 tbe-module-column\">\n                        <h6>Quick Navigation</h6>\n                        <ul class=\"arrow-link-list\">\n                            <li><a href=\"https://bmedx.com/\">Home</a></li>\n                            <li><a href=\"https://bmedx.com/who-we-are/about-biomed-x/\">About <span class=\"dont-break-word\">BioMed X</span></a></li>\n                            <li><a href=\"https://bmedx.com/who-we-are/fact-sheet/\"><span class=\"dont-break-word\">BioMed X</span> Fact Sheet</a></li>\n                            <li><a href=\"https://bmedx.com/news/press-releases/\">Press Releases</a></li>\n                            <li><a href=\"https://bmedx.com/our-network/\">Our Network</a></li>\n                            <li><a href=\"https://career.bmedx.com/login\" target=\"_blank\" rel=\"noopener\"><strong><span class=\"dont-break-word\">BioMed X</span> Career Space</strong></a></li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <div class=\"site-footer-section-copyright\">\n            <div class=\"grid\">\n                <div class=\"site-footer-section-copyright-inner margin-fix\">\n                    <p><strong>© 2026 BioMed X AG. All rights reserved.</strong></p>\n                    <p>\n                        <a href=\"https://bmedx.com/imprint-legal-notice/\">Imprint &amp; Legal Notice</a>\n                        · <a href=\"https://bmedx.com/privacy-policy/\">Privacy Policy</a>\n                        · <a href=\"https://bmedx.com/data-protection-information-for-applicants/\">Data Protection Information for Applicants</a>\n                        · <a href=\"https://bmedx.com/whistleblower-system-internal-reporting-office/\">Whistleblower System / Internal Reporting Office</a>\n                        · <a href=\"#edit-cookie-settings\">Cookie Settings</a>\n                    </p>\n                </div>\n            </div>\n        </div>\n\n    </footer>\n            \n                        <div id=\"cc1990kb-main\">\n\n        <div id=\"cc1990kb-cookie-consent-banner\">\n            <div class=\"cc1990kb-banner-inner\">\n                <div class=\"cc1990kb-banner-text-column\">\n                    <p><strong>Cookie Notice</strong></p>\n                    <p>We use strictly necessary session cookies for login. We also use cookieless Matomo Analytics (no personal data stored in cookies) to improve this platform. Choose your preference&nbsp;below.</p>\n                </div>\n                <div class=\"cc1990kb-banner-actions-column\">\n                    <button id=\"cc1990kb-btn-accept-all\" class=\"button button-primary\">Accept all</button>\n                    <button id=\"cc1990kb-btn-necessary\" class=\"button\">Necessary only</button>\n                </div>\n            </div>\n        </div>\n\n        <div id=\"cc1990kb-cookie-settings-modal\">\n            <div class=\"cc1990kb-modal-inner\">\n                <div class=\"cc1990kb-cookie-settings-modal-header\">\n                    <h3>Cookie Settings</h3>\n                    <p>Manage your cookie preferences below. Your choice is saved in your browser and can be changed at any time via the &ldquo;Cookie Settings&rdquo; link in the footer.</p>\n                </div>\n                <div class=\"cc1990kb-cookie-settings-modal-body\">\n                    <h4>Strictly Necessary (always active)</h4>\n                    <p>A session cookie (<code>PHPSESSID</code>) is required for login and application functionality. It contains no tracking data and expires after 24&nbsp;hours or when you close your browser.</p>\n                    <h4>Analytics (optional)</h4>\n                    <p>We use <a href=\"https://matomo.org\" target=\"_blank\" rel=\"noopener\">Matomo Analytics</a> with cookies explicitly disabled and the browser&rsquo;s &ldquo;Do Not Track&rdquo; signal honoured. No personal data is stored in cookies. Choosing &ldquo;Necessary only&rdquo; fully disables Matomo tracking.</p>\n                </div>\n                <div class=\"cc1990kb-cookie-settings-modal-footer\">\n                    <button id=\"cc1990kb-modal-necessary\" class=\"button\">Necessary only</button>\n                    <button id=\"cc1990kb-modal-accept-all\" class=\"button button-primary\">Accept all</button>\n                </div>\n            </div>\n        </div>\n\n    </div>\n            \n                <script type=\"text/html\" id=\"the-megalightbox-template\"><div id=\"the-megalightbox\" class=\"the-megalightbox\"><div class=\"megalightbox-body-wrap\"><div class=\"megalightbox-body\"><div class=\"megalightbox-left\"><div class=\"megalightbox-header\"><button class=\"megalightbox-button megalightbox-fs-toggle\" data-title-enter=\"Enter fullscreen\" data-title-exit=\"Exit fullscreen\" title=\"Enter fullscreen\"><span class=\"megalightbox-fs-label -visually-hidden\">Enter fullscreen</span></button><button class=\"megalightbox-button megalightbox-close\" title=\"Close / [ESC]\"><span class=\"megalightbox-close-label -visually-hidden\">Close</span></button></div><button class=\"megalightbox-button megalightbox-arrow megalightbox-arrow-prev\" title=\"Previous Image / [←]\"><span class=\"-visually-hidden\">Previous Image / [←]</span></button><