den\" value=\"0\" name=\"quelle\"\n                       id=\"workform_quelle\">\n                <input type=\"hidden\" value=\"1\" name=\"ie\"\n                       id=\"workform_ie\">\n                            </form>\n            <iframe id=\"workif\" name=\"workif\" style=\"margin-top: 15px; width: 100%; height: 0;\" frameborder=\"0\"\n                    src=\"https://scheidtbachmann.concludis.de/bewerber/empty.php\"></iframe>\n        </div>\n    </div>\n\n        <div style=\"width:100%\" class=\"resdiv\">\n\n    \n    <table width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\">\n        <tr class=\"navtr\">\n            <td style=\"text-align:left;\" colspan=\"3\">\n                                    <div class=\"concludis-nav-item i18n-ls-nav\">\n                        <a class=\"i18n-ls-menu-opener\">\n                            <span class=\"i18n-ls-language\">Deutsch</span>\n                            <i class=\"concludisicon-down-dir\"></i>\n                        </a>\n                        <div class=\"i18n-ls-menu\">\n                            <strong>Language</strong>\n                            <div>\n                                <select id=\"i18n-ls-select\"\n                                        data-url=\"https://scheidtbachmann.concludis.de/prj/shw/9bde76f262285bb1eaeb7b40c758b53e_0/10267/Absolventin_Absolvent_Wirtschaftsingenieurwesen_Elektrotechnik_Informatik_oder_Betriebswirtschaft_als_Trainee_m_w_d_im_technischen_Vertrieb.htm?v=1&b=11&page=1&boerse=11\">\n                                                                            <option value=\"de_DE\"\n                                            selected>Deutsch (Deutschland)</option>\n                                                                            <option value=\"en_GB\"\n                                            >English (United Kingdom)</option>\n                                                                            <option value=\"sk_SK\"\n                                            >slovenčina (Slovensko)</option>\n                                                                    </select>\n                            </div>\n                        </div>\n                    </div>\n                    \n\t\t<div class=\"concludis-nav-item\" id=\"emailsubscription_liste\">\n\t\t\t<a class=\"subscriptionbutton textsmall tooltip_bottom\" onclick=\"cJobboard.showModalJobsubscription()\" title=\"Lassen Sie sich von uns über neue Jobangebote per E-Mail benachrichtigen\">Job-Benachrichtigung per E-Mail</a>\n\t\t</div>\n\n\t\t<div style=\"height:10px;\"></div>\n                <div id=\"hd_Stellenangebot\" style=\"padding:5px 8px\">Stellenangebote</div>            </td>\n        </tr>\n    </table>\n\n\n    <div id=\"container\">\n        <table style=\"width:100%\">\n                            <tr class=\"headtr\">\n                    <td class=\"headtd\" style=\"text-align:left; padding:5px\"><span id=\"hd_Stellenangebot\"><span id=\"pagetitle\" class=\"headerlink\" style=\"cursor: pointer;\" onclick=\"window.close();\" title=\"Fenster schließen\">« zurück</span></span></td>                        <!--</div>-->\n                                            <!--</td>-->\n                </tr>\n                        </table>\n    </div>\n    \n        </div>\n\n    <main class=\"jobad\" role=\"main\">\r\n\r\n\r\n    <div class=\"jb-container\">\r\n        <div class=\"jb-wrapper\">\r\n            <div class=\"col-xs-12 util-reset-margin-bottom\">\r\n                <div class=\"jb-header\">\r\n                    <a href=\"https://www.scheidt-bachmann.de\" target=\"_blank\" title=\"Scheidt & Bachmann\">\r\n                        <img src=\"https://jobs.scheidt-bachmann.de/download/design/MTAxNTQ5MzU=/sblogo.png\"\r\n                        alt=\"Scheidt & Bachmann\"/>\r\n                    </a>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n    <div class=\"jb-header-img\">\r\n        <img src=\"https://jobs.scheidt-bachmann.de/download/design/MTE3ODExNDQ=/SB_Werksgelaende.jpg\" class=\"con-header-image\" alt=\"header image\">\r\n    </div>\r\n\r\n\r\n    <div class=\"bg-grey\">\r\n        <div class=\"jb-container\">\r\n            <div class=\"jb-wrapper\">\r\n                <div class=\"col-xs-12\">\r\n                    <div class=\"job-title\">\r\n                        <small><p><div>Wir suchen dich als</div></p></small>\r\n                        <h1>Absolventin / Absolvent Wirtschaftsingenieurwesen / Elektrotechnik / Informatik oder Betriebswirtschaft als Trainee <span class=\"m_w\">(m/w/d)</span> im technischen Vertrieb</h1>\r\n                        <span><div>zur Unterstützung unseres Vertriebsteams am Standort Mönchengladbach</div></span>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"jb-container\">\r\n        <div class=\"jb-wrapper\">\r\n            <div class=\"jb-items\">\r\n                <div class=\"jb-item\">\r\n                    <div class=\"content-wrapper\">\r\n                        <div class=\"intro-block\">\r\n                            <h3>Scheidt &amp; Bachmann - Mobilität, die verbindet</h3>\n<div>Ob beim Bahnfahren, Parken, Tanken bzw. Laden oder bei der Nutzung des öffentlichen Nahverkehrs – mit großer Wahrscheinlichkeit hast du dabei schon unsere Technik genutzt. Seit über 150 Jahren entwickeln wir Systeme und Lösungen für eine Mobilitätsinfrastruktur, die weltweit Menschen und Güter sicher, schnell und komfortabel ans Ziel bringt. Als Familienunternehmen leben wir Werte wie Vertrauen, Verlässlichkeit und Zusammenhalt – und gestalten gemeinsam die Mobilität von morgen.</div>\r\n                        </div>\r\n                        <div class=\"business-area\">\r\n                            \r\n                            <img src=\"https://jobs.scheidt-bachmann.de/download/design/MTE3OTg2Njc=/4er-Bild-2025.jpg\"\r\n                                 alt=\"Signaltechnik\">\r\n                        </div>\r\n                        <div class=\"jb-offer\">\r\n                            <h3>Wir bieten</h3>\n<ul style=\"list-style-type:square;\">\n<li>\n<div><strong>Eine unbefristete Anstellung</strong> in einem innovativen, krisensicheren und etablierten Unternehmen, in dem Vielfalt und Gleichstellung zu unserer DNA gehören</div>\n</li>\n<li>\n<div><strong>Work-Life-Balance</strong>: Freu dich auf eine flexible, familienorientierte Arbeitszeitgestaltung, Home-Office- und Teilzeitmöglichkeiten und unseren Kinderbetreuungszuschuss</div>\n</li>\n<li>\n<div><strong>Gute Verpflegung</strong>: Entdecke das abwechslungsreiche Essensangebot in unserem modernen Betriebsrestaurant</div>\n</li>\n<li>\n<div><strong>Strukturierte Einarbeitung und Buddy-Programm</strong>: Wir wollen, dass du dich von Beginn an wohlfühlst und dein Know-how direkt einbringen kannst</div>\n</li>\n<li>\n<div><strong>Personalentwicklungs- und Weiterbildungsprogramme</strong>: Entwickle dich kontinuierlich weiter, um deinem Team immer wieder neue Impulse zu geben</div>\n</li>\n<li>\n<div><strong>Jede Menge Wertschätzung</strong>: Eine attraktive Vergütung ist für uns ebenso selbstverständlich wie ein kollegiales Miteinander auf Augenhöhe</div>\n</li>\n</ul>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n\r\n                <div class=\"jb-item\">\r\n                    <div class=\"content-wrapper\">\r\n                        <div class=\"tasks\">\r\n                            <h3></h3>\n<ul>\n<li><strong>Du willst Technik verstehen, Kunden begeistern und früh Verantwortung übernehmen? </strong>Dann starte mit unserem Traineeprogramm im technischen B2B-Vertrieb. In 12–15 Monaten lernst du unsere Geschäftsbereiche kennen, arbeitest an spannenden Projekten mit und erhältst Einblicke in Bid Management, Produktmanagement und Key Account Management.</li>\n<li><strong>Starte flexibel und mit Sicherheit:</strong> Bei uns erhältst du direkt einen unbefristeten Vertrag, viel Gestaltungsspielraum und einen individuellen Einsatzplan. Außerdem lernst du die Arbeit an einem unserer internationalen Standorte aus erster Hand kennen.</li>\n<li><strong>Du möchtest von Anfang an mitgestalten, statt nur zuzuschauen?</strong> Du bist vom ersten Tag an Teil des Teams, übernimmst eigene Aufgaben und bringst dich aktiv ins Tagesgeschäft ein. Gemeinsam mit uns wächst du schrittweise in mehr Verantwortung hinein und entwickelst Lösungen für unsere internationalen Kunden mit.</li>\n</ul>\n<div></div>\n<div>\n<div>Nach dem Traineeprogramm übernimmst du eine verantwortungsvolle Position in einer unserer Gesellschaften. Wir schaffen dir einen strukturierten, individuellen Berufseinstieg mit klarer Perspektive.</div>\n</div>\r\n                        </div>\r\n                        <div class=\"qualifications\">\r\n                            <h3>Das bringst du mit</h3>\n<ul style=\"list-style-type:square;\">\n<li>Ein erfolgreich <strong>abgeschlossenes Studium</strong> – mit Schwerpunkt Wirtschaftsingenieurwesen, Elektrotechnik, Informatik, Betriebswirtschaft oder eine vergleichbare Qualifikation</li>\n<li><strong>Erste praktische Erfahrungen im Vertrieb</strong> oder technischen Umfeld sind von Vorteil, aber auch motivierte Berufseinsteiger (m/w/d) sind herzlich willkommen.</li>\n<li>Sehr gute<strong> Deutsch</strong>- und <strong>Englischkenntnisse </strong></li>\n<li><strong>Kommunikationsstarke </strong>und<strong> offene</strong> Persönlichkeit </li>\n<li><strong>Spaß </strong>an einem internationalen Arbeitsumfeld </li>\n</ul>\n<div></div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n    </div>\r\n\r\n\r\n    <div class=\"bg-grey\">\r\n        <div class=\"jb-container\">\r\n            <div class=\"jb-wrapper\">\r\n                <div class=\"jb-contact\">\r\n                    <div class=\"contactimg\"><img src=\"https://jobs.scheidt-bachmann.de/download/design/MTExNzk3NjM=/IMG_0949.jpg\"></div>\r\n                    <div class=\"jb-con-1\">\r\n                        <div class=\"questions\">\r\n                            <h3>Hast du Interesse?</h3>\n<div><strong>Für weitere Fragen kontaktiere:</strong></div>\n<p>Christa Junghans</p>\n<div class=\"row\">\n<div class=\"col-xs-12\"><a>+49 2166 / 266-233</a></div>\n<div class=\"col-xs-12\"><strong><a href=\"http://www.scheidt-bachmann.de/karriere\">Karriere bei Scheidt &amp; Bachmann</a></strong></div>\n<div class=\"col-xs-12\"><strong><a href=\"http://www.scheidt-bachmann.de/karriere/arbeiten-bei-scheidt-bachmann/\">Karriere-Videos</a></strong></div>\n</div>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"jb-con-2\">\r\n                        <div class=\"questions\">\r\n                            <p><h3>Bewirb dich jetzt!</h3>\n<div>Wenn es dich reizt, dich in unserem innovativen Familienunternehmen einzubringen, dann <strong>bewirb dich jetzt</strong> unter Angabe deiner Gehaltsvorstellungen.</div></p>\r\n\r\n                            <a href=\"https://jobs.scheidt-bachmann.de/bewerber/landingpage.php?prj=75P10267&oid=&qid=0&b=11&ie=1&lang=de_DE\" class=\"btn\">Jetzt bewerben!</a>\r\n                            <div class=\"jobad-whatsapp-apply\">\r\n                                <a href=\"https://jobs.scheidt-bachmann.de/bewerber/landingpage.php?prj=75P10267&oid=&qid=0&b=11&ie=1&lang=de_DE&bw=P\">\r\n                                    <img src=\"https://jobs.scheidt-bachmann.de/download/design/MTE3MzU3Mzk=/whatsapp_mini.png\" alt=\"WhatsApp Icon\">\r\n                                    <strong>via WhatsApp</strong>\r\n                                </a>\r\n                            </div>\r\n                            <div class=\"share concludis-share\"><span class=