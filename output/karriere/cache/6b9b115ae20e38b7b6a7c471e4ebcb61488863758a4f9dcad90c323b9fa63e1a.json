ll=\"#B6181D\" d=\"M0,0h18v3H0V0z M0,6.6h18v3H0V6.6z M0,13.2h18v3H0V13.2z\" />\r\n                </g>\r\n              </svg>\r\n            </a>\r\n            <a href=\"/\" class=\"right logo drlogo\">\r\n              \r\n                  <img src=\"/typo3conf/ext/mask_project/Resources/Public/Images/dr_logo_de.png\" alt=\"\">\r\n                \r\n            </a>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </nav>\r\n\r\n</div>\r\n\r\n<ul class=\"sidenav\" id=\"navi\">\r\n  <li><a href=\"/unternehmen\" class=\"waves-effect waves-red\">Unternehmen</a></li><li><a href=\"/rueckversicherung\" class=\"waves-effect waves-red\">Rückversicherung</a></li><li><a href=\"/aktuelles\" class=\"waves-effect waves-red\">Aktuelles</a></li><li><a href=\"/karriere\" class=\"waves-effect waves-red\">Karriere</a></li><li><a href=\"/downloads\" class=\"waves-effect waves-red\">Downloads</a></li>\r\n  <li><a href=\"https://www.deutscherueck.com\" class=\"waves-effect waves-red\">English Version</a></li><li><a href=\"https://aip.deutscherueck.de/\" target=\"_blank\" rel=\"noopener\" class=\"waves-effect waves-red\">Login</a></li><li><a href=\"https://www.xing.com/spi/shares/new?url=\" target=\"_blank\" class=\"xiicon sidebaricons\" rel=\"noreferrer nofollow\" onclick=\"javascript:window.open(this.href, &#039;&#039;, &#039;menubar=no,toolbar=no,resizable=yes,scrollbars=yes,height=600,width=600&#039;);return false;\" title=\"Auf Xing teilen\"><img src=\"/typo3conf/ext/mask_project/Resources/Public/Icons/xing.svg \" alt=\"Auf Xing teilen\" /></a><a href=\"https://www.linkedin.com/shareArticle?mini=true&amp;url=\" target=\"_blank\" class=\"liicon sidebaricons\" rel=\"noreferrer nofollow\" onclick=\"javascript:window.open(this.href, &#039;&#039;, &#039;menubar=no,toolbar=no,resizable=yes,scrollbars=yes,height=600,width=600&#039;);return false;\" title=\"Auf LinkedIn teilen\"><img src=\"/typo3conf/ext/mask_project/Resources/Public/Icons/linkedin.svg \" alt=\"Auf LinkedIn teilen\" /></a><a href=\"https://www.facebook.com/sharer.php?u=\" target=\"_blank\" class=\"fbicon sidebaricons\" rel=\"noreferrer nofollow\" onclick=\"javascript:window.open(this.href, &#039;&#039;, &#039;menubar=no,toolbar=no,resizable=yes,scrollbars=yes,height=600,width=600&#039;);return false;\" title=\"Auf Facebook teilen\"><img src=\"/typo3conf/ext/mask_project/Resources/Public/Icons/facebook.svg \" alt=\"Auf Facebook teilen\" /></a><a href=\"https://twitter.com/intent/tweet?url=\" target=\"_blank\" class=\"twicon sidebaricons\" rel=\"noreferrer nofollow\" onclick=\"javascript:window.open(this.href, &#039;&#039;, &#039;menubar=no,toolbar=no,resizable=yes,scrollbars=yes,height=600,width=600&#039;);return false;\" title=\"Auf Twitter teilen\"><img src=\"/typo3conf/ext/mask_project/Resources/Public/Icons/twitter.svg \" alt=\"Auf Twitter teilen\" /></a></li>\r\n</ul>\r\n\r\n<main>\r\n  \r\n    \r\n      <div id=\"c2989\" class=\"mask mask-header bg-kreide\" data-bgcolor=\"bg-kreide\">\r\n        <div class=\"bgimage fokus-mitte\" style=\"background-image: url('/fileadmin/_processed_/e/d/csm_DR_Chronik75_Teaser_DE_kleiner_2ba3258a06.jpg')\"></div>\r\n        \r\n          <div class=\"overlay container\">\r\n            <div class=\"row\">\r\n              <div class=\"col s12 l6\">\r\n                \r\n                  <h1>  75 Jahre Deutsche Rück.</h1>\r\n                \r\n                \r\n                  <h3>Tauchen Sie mit uns ein in 75 Jahre bewegte und bewegende Unternehmensgeschichte!</h3>\r\n                \r\n                \r\n                  <p>Am 22. August wurde die Deutsche Rück 75 Jahre alt. Wir erzählen ihre Geschichte – von ihrer Geburtsstunde, über Höhen und Tiefen bis hin zu dem, was sie heute ist: ein erfolgreicher internationaler Rückversicherer. </p>\r\n                \r\n                \r\n                  <a href=\"https://75jahre.deutscherueck.de/\" target=\"_blank\" rel=\"noreferrer\" class=\"btn waves-effect waves-light\">Hier geht es zur Story der Deutschen Rück! </a>\r\n                \r\n              </div>\r\n            </div>\r\n          </div>\r\n        \r\n      </div>\r\n      <img src=\"/fileadmin/_processed_/e/d/csm_DR_Chronik75_Teaser_DE_kleiner_2ba3258a06.jpg\" alt=\"\" class=\"mobileheader\" /> \r\n    \r\n  \r\n<a id=\"c2290\" class=\"sprungmarke\"></a>\r\n<div class=\"mask mask-text bg-white\">\r\n  <div class=\" container\">\r\n    \r\n      <div class=\"row\">\r\n        <div class=\"col s12\">\r\n          <h3>Willkommen bei der Deutschen Rück!</h3>\r\n          \r\n        </div>\r\n      </div>\r\n    \r\n    <div class=\"row \">\r\n      <div class=\"col s12 l6\">\r\n        \r\n          \r\n          \r\n            <p>Vor&nbsp;75 Jahren haben wir damit begonnen unseren Eigentümern, den deutschen öffentlichen Versicherern, Rückversicherungsschutz zu bieten. 1951 gegründet zählt die Deutsche Rück heute zu den führenden Rückversicherern Deutschlands.</p>\r\n          \r\n          \r\n        \r\n      </div>\r\n      <div class=\"col s12 l6 \">\r\n        \r\n          \r\n          \r\n            <p>Auch international sind wir anerkannt: Gemeinsam mit ihrer Züricher Tochter DR Swiss bietet die Deutsche Rück im gesamten europäischen Markt und in ausgewählten internationalen Märkten Rückversicherungsschutz. <a href=\"/unternehmen\">Lernen Sie uns kennen!</a></p>\r\n          \r\n          \r\n        \r\n        \r\n        \r\n        \r\n      </div>\r\n    </div>\r\n  </div>\r\n</div>\r\n<a id=\"c3109\" class=\"sprungmarke\"></a>\r\n<div class=\"mask mask-text bg-blue\">\r\n  <div class=\" container\">\r\n    \r\n      <div class=\"row\">\r\n        <div class=\"col s12\">\r\n          <h3>marktreport</h3>\r\n          \r\n        </div>\r\n      </div>\r\n    \r\n    <div class=\"row \">\r\n      <div class=\"col s12 l6\">\r\n        \r\n          \r\n            <h5>Was Versicherer bewegt!</h5>\r\n          \r\n          \r\n            <p><strong>In der aktuellen Ausgabe unseres Webmagazins marktreport </strong>beschäftigen wir uns mit der Frage, wie <strong>finanzielle Inklusion</strong> die Grundlage für nachhaltiges Wachstum in den Versicherungsmärkten von Schwellenländern bilden kann. Außerdem schauen wir uns die <strong>Auswirkungen von KI auf das Underwriting in der Sachversicherung </strong>an. Und wir tauchen ein in <strong>75 Jahre&nbsp; Geschichte der Deutschen Rück</strong>.&nbsp;</p>\n<p>&nbsp;</p>\r\n          \r\n          \r\n            <a href=\"https://marktreport.deutscherueck.de/2026-01/\" target=\"_blank\" rel=\"noreferrer\" class=\"btn waves-effect waves-light\">Hier geht es zum marktreport!</a>\r\n          \r\n        \r\n      </div>\r\n      <div class=\"col s12 l6 \">\r\n        \r\n          \r\n          \r\n          \r\n        \r\n        \r\n          \r\n            <img src=\"/fileadmin/_processed_/3/1/csm_Marktreport2026_iPad_Vorschau_Rand_DE_0f2495be4f.png\" width=\"1000\" height=\"469\" alt=\"\" />\r\n            \r\n            \r\n          \r\n        \r\n        \r\n        \r\n      </div>\r\n    </div>\r\n  </div>\r\n</div>\r\n<div id=\"c5\" class=\"mask mask-piktogrammteaser bg-white\">\r\n  <div class=\"container\">\r\n    <div class=\"row\">\r\n      <div class=\"col s12\">\r\n        \r\n      </div>\r\n    </div>\r\n    \r\n      <div class=\"row child-fade\">\r\n        \r\n          \r\n              <a href=\"/aktuelles/deutsche-rueck-sp-rating-2026\" class=\"mask-teaser col s12 m6 l3\">\r\n                \r\n                  \r\n                    <img src=\"/fileadmin/Icons/DR_ICONSET_CS-Elemente_Auszeichnungen.svg\" width=\"500\" height=\"500\" alt=\"\" />\r\n                  \r\n                \r\n                <p>\r\n                  \r\n                    <strong>S&amp;P Global Ratings 2026</strong><br>\r\n                  \r\n                  \r\n                    S&amp;P Global Ratings bestätigt das &quot;A+&quot;-Rating mit Ausblick &quot;stabil&quot; für die Deutsche Rück Gruppe.\r\n                  \r\n                </p>\r\n              </a>\r\n            \r\n        \r\n          \r\n              <a href=\"/aktuelles/deutsche-rueck-fitch-rating-2026\" class=\"mask-teaser col s12 m6 l3\">\r\n                \r\n                  \r\n                    <img src=\"/fileadmin/Icons/DR_ICONSET_CS-Elemente_Erfolg.svg\" width=\"500\" height=\"500\" alt=\"\" />\r\n                  \r\n                \r\n                <p>\r\n                  \r\n                    <strong>Fitch Rating 2026</strong><br>\r\n                  \r\n                  \r\n                    Deutsche Rück Gruppe erhält erstmals Rating von Fitch: &quot;A+&quot; mit Ausblick &quot;stabil&quot;\r\n                  \r\n                </p>\r\n              </a>\r\n            \r\n        \r\n          \r\n              <a href=\"/zahlen-und-fakten\" class=\"mask-teaser col s12 m6 l3\">\r\n                \r\n                  \r\n                    <img src=\"/fileadmin/Icons/DR_ICONSET_CS-Elemente_Diagramm_Balken.svg\" width=\"500\" height=\"500\" alt=\"\" />\r\n                  \r\n                \r\n                <p>\r\n                  \r\n                    <strong>Unsere Zahlen sprechen die Sprache der Sicherheit</strong><br>\r\n                  \r\n                  \r\n                    Aktuelle Zahlen &amp; Fakten und unsere Geschäftsberichte finden Sie hier!\r\n                  \r\n                </p>\r\n              </a>\r\n            \r\n        \r\n      </div>\r\n    \r\n  </div>\r\n</div>\r\n<a id=\"c15\" class=\"sprungmarke\"></a>\r\n<div class=\"mask mask-text bg-indigo\">\r\n  <div class=\" container\">\r\n    \r\n      <div class=\"row\">\r\n        <div class=\"col s12\">\r\n          <h3>News zur Deutschen Rück</h3>\r\n          \r\n        </div>\r\n      </div>\r\n    \r\n    <div class=\"row \">\r\n      <div class=\"col s12 l6\">\r\n        \r\n          \r\n          \r\n            <p><strong>Halten Sie sich auf dem Laufenden über die Deutsche Rück!</strong></p>\r\n          \r\n          \r\n            <a href=\"/aktuelles\" class=\"btn waves-effect waves-light\">Alle News im Überblick</a>\r\n          \r\n        \r\n      </div>\r\n      <div class=\"col s12 l6 \">\r\n        \r\n          \r\n            <h5>Düsseldorf, 20. August 2026</h5>\r\n          \r\n          \r\n            <p>Deutsche Rück Gruppe erneut mit “A+” von S&amp;P<strong> </strong>Global Ratings bewertet – Ausblick stabil</p>\r\n          \r\n          \r\n            <a href=\"/aktuelles/deutsche-rueck-sp-rating-2026\" class=\"btn waves-effect waves-light\">Lesen Sie weiter</a>\r\n          \r\n        \r\n          \r\n            <h5>Düsseldorf, 24. Juni 2025</h5>\r\n          \r\n          \r\n            <p>Sonnig, trocken, mit vereinzelten Temperaturrekorden und einer vergleichsweise niedrigen Schadenbilanz – so war das Wettergeschehen 2025.</p>\r\n          \r\n          \r\n            <a href=\"/aktuelles/sturmdokumentation-2025\" class=\"btn waves-effect waves-light\">Lesen Sie weiter</a>\r\n          \r\n        \r\n          \r\n            <h5>Düsseldorf, 1. Juni 2026</h5>\r\n          \r\n          \r\n            <p>Deutsche Rück Gruppe erhält \"A+\"-Rating von Fitch – Ausblick \"stabil\"</p>\r\n          \r\n          \r\n            <a href=\"/aktuelles/deutsche-rueck-fitch-rating-2026\" class=\"btn waves-effect waves-light\">Lesen Sie weiter</a>\r\n          \r\n        \r\n        \r\n        \r\n        \r\n      </div>\r\n    </div>\r\n  </div>\r\n</div>\r\n\r\n\r\n<div id=\"c4\" class=\"mask mask-themenkachel bg-blue\">\r\n  <div class=\"container\">\r\n    <div class=\"row\">\r\n      <div class=\"col s12\">\r\n        \r\n          <h3>Diese Themen könnten Sie interessieren!</h3>\r\n        \r\n      </div>\r\n    </div>\r\n\r\n    \r\n        \r\n          <div class=\"row isotope child-fade\">\r\n            \r\n            \r\n              \r\n              \r\n                <a href=\"/rueckversicherung/vertragsrueckversicherung\" class=\"col s12 m6 l4 xl3 themenkachel\">\r\n                  <div class=\"themenkachel-content\">\r\n                    \r\n                      <div class=\"themenkachel-image\">\r\n                        \r\n                          <img src=\"/fileadmin/_processed_/a/d/csm_Vertragsabschluss___ASDF_AdobeStock_300177662_4d12ab0a8c.jpeg\" alt=\"\" class=\"themenkachel-image\">\r\n                        \r\n                      </div>\r\n                    \r\n                    <div class=\"themenkachel-text\">\r\n                      \r\n                          <small>Vertragsrückversicherung Nichtleben</small>\r\n                        \r\n                      <h5>Unsere Expertise ist Ihr Vorteil</h5>\r\n                      <p>Als einer der führenden Rückversicherer in Deutschland verstehen wir den Bedarf unserer Kunden und arbeiten gemeinsam mit ihnen an passgenauen Deckungskonzepten. Erfahren Sie mehr über das Thema Vertragsrückversicherung!</p>\r\n                    </div>            \r\n                  </div>\r\n                </a>\r\n              \r\n                \r\n            \r\n              \r\n              \r\n                <a href=\"/aktuarielle-services\" class=\"col s12 m6 l4 xl3 themenkachel\">\r\n                  <div class=\"themenkachel-content\">\r\n                    \r\n                      <div class=\"themenkachel-image\">\r\n                        \r\n                          <img src=\"/fileadmin/_processed_/e/1/csm_Business_Analyse___tippapatt__AdobeStock_313209466_caa7fc5053.jpeg\" alt=\"\" class=\"themenkachel-image\">\r\n                        \r\n                      </div>\r\n                    \r\n                    <div class=\"themenkachel-text\">\r\n                      \r\n                          <small>Aktuarielle Services Nichtleben</small>\r\n                        \r\n                      <h5>Kernkompetenz Portefeuille-Analysen</h5>\r\n                      <p>Unsere Experten des Marktaktuariats analysieren Ihr Portefeuille und liefern wichtige Entscheidungshilfen bei der Ausgestaltung der Rückversicherung.</p>\r\n                    </div>            \r\n                  </div>\r\n                </a>\r\n              \r\n                \r\n            \r\n              \r\n              \r\n                <a href=\"/rueckversicherung/sach-und-ertragsausfall\" class=\"col s12 m6 l4 xl3 themenkachel\">\r\n                  <div class=\"themenkachel-content\">\r\n                    \r\n                      <div class=\"themenkachel-image\">\r\n                        \r\n                          <img src=\"/fileadmin/_processed_/1/c/csm_Industrie_Digitalisierung___ipopba_AdobeStock_219100685_7110c07627.jpeg\" alt=\"\" class=\"themenkachel-image\">\r\n                        \r\n                      </div>\r\n                    \r\n                    <div class=\"themenkachel-text\">\r\n                      \r\n                          <small>Sach- und Ertragsausfall</small>\r\n                        \r\n                      <h5>Gute Antworten auf internationale Entwicklungen</h5>\r\n                      <p>Die internationale Vernetzung der Wirtschaft und die zunehmende Spezialisierung und Digitalisierung erzeugen Abhängigkeiten und neue Risiken. Die Deutsche Rück ist Expertin im Sachversicherungsgeschäft. Lernen Sie uns kennen!</p>\r\n                    </div>            \r\n                  </div>\r\n                </a>\r\n              \r\n                \r\n            \r\n              \r\n              \r\n                <a href=\"/rueckversicherung/naturgefahren\" class=\"col s12 m6 l4 xl3 themenkachel\">\r\n                  <div class=\"themenkachel-content\">\r\n                    \r\n                      <div class=\"themenkachel-image\">\r\n                        \r\n                          <img src=\"/fileadmin/_processed_/c/0/csm_Sturm__Sachsen____Artur_Bociarski_AdobeStock_162048967_a9081ceda4.jpeg\" alt=\"\" class=\"themenkachel-image\">\r\n                        \r\n                      </div>\r\n                    \r\n                    <div class=\"themenkachel-text\">\r\n                      \r\n                          <small>Naturgefahren</small>\r\n                        \r\n                      <h5>Die Naturgefahren-Expertise der Deutschen Rück</h5>\r\n                      <p>Ob es um die Kalkulation von Sturmschäden oder von Überschwemmungen geht: Wir unterstützen unsere Kunden bei der \"Beherrschung\" der Schadenpotenziale aus Naturgefahren-exponierten Policen durch Risikomodellierung.</p>\r\n                    </div>            \r\n                  </div>\r\n                </a>\r\n              \r\n                \r\n            \r\n              \r\n              \r\n                <a href=\"/rueckversicherung/haftpflichtversicherung\" class=\"col s12 m6 l4 xl3 themenkachel\">\r\n                  <div class=\"themenkachel-content\">\r\n                    \r\n                      <div class=\"themenkachel-image\">\r\n                        \r\n                          <img src=\"/fileadmin/_processed_/d/a/csm_Teaserbild_Paragraph_rot_eed777e8d0.jpg\" alt=\"\" class=\"themenkachel-image\">\r\n                        \r\n                      </div>\r\n                    \r\n                    <div class=\"themenkachel-text\">\r\n                      \r\n                          <small>Haftpflicht</small>\r\n                        \r\n                      <h5>Absicherung von Haftungsrisiken in immer dynamischeren Märkten</h5>\r\n                      <p>Ob es um Trends bei Deckungssummen, neue Pflichtversicherungen für Berufsgruppen oder das Einschätzen neuer Risiken geht: Die Deutsche Rück begleitet Haftpflichtversicherer mit ihrer Expertise.</p>\r\n                    </div>            \r\n                  </div>\r\n                </a>\r\n              \r\n                \r\n            \r\n              \r\n              \r\n                <a href=\"/rueckversicherung/kraftfahrt\" class=\"col s12 m6 l4 xl3 themenkachel\">\r\n                  <div class=\"themenkachel-content\">\r\n                    \r\n                      <div class=\"themenkachel-image\">\r\n                        \r\n                          <img src=\"/fileadmin/_processed_/7/3/csm_Kraftfahrt_dd6f0d1382.jpg\" alt=\"\" class=\"themenkachel-image\">\r\n                        \r\n                      </div>\r\n                    \r\n                    <div class=\"themenkachel-text\">\r\n                      \r\n                          <small>Kraftfahrt</small>\r\n                        \r\n                      <h5>Kraftfahrtversicherung: Intelligente Konzepte für bewegte Märkte</h5>\r\n                      <p>Mobilität ist mehr denn je im Wandel. Die Deutsche Rück begleitet Branchentrends, die die Kraftfahrtversicherung bewegen – vom Autonomen Fahren, über Telematik und die Elektrifizierung des Verkehrs bis hin zu Mobilitätsökosystemen.</p>\r\n                    </div>            \r\n                  </div>\r\n                </a>\r\n              \r\n                \r\n            \r\n              \r\n              \r\n                <a href=\"/rueckversicherung/marktkennzahlen\" class=\"col s12 m6 l4 xl3 themenkachel\">\r\n                  <div class=\"themenkachel-content\">\r\n                    \r\n                      <div class=\"themenkachel-image\">\r\n                        \r\n                          <img src=\"/fileadmin/_processed_/4/c/csm_Markttrend___SFIO_CRACHO_AdobeStock_266513774_ca049bc109.jpeg\" alt=\"\" class=\"themenkachel-image\">\r\n                        \r\n                      </div>\r\n                    \r\n                    <div class=\"themenkachel-text\">\r\n                      \r\n                          <small>Nichtleben</small>\r\n                        \r\n                      <h5>Markttrends sicher erkennen mit den Zeitreihen der Deutschen Rück</h5>\r\n                      <p>Für Erstversicherer ist es enorm wichtig, Entwicklungen frühzeitig zu erkennen. Nur so können Sie ihr Geschäft mit dem Markt vergleichen und auf Branchentrends angemessen reagieren. Wir liefern unentbehrliche Schadenkennzahlen. </p>\r\n                    </div>            \r\n                  </div>\r\n                </a>\r\n              \r\n                \r\n            \r\n              \r\n              \r\n                <a href=\"/rueckversicherung/risikomanagement\" class=\"col s12 m6 l4 xl3 themenkachel\">\r\n                  <div class=\"themenkachel-content\">\r\n                    \r\n                      <div class=\"themenkachel-image\">\r\n                        \r\n                          <img src=\"/fileadmin/_processed_/7/9/csm_Risiko_Helm___howtogoto_AdobeStock_278402323_ca680e2766.jpeg\" alt=\"\" class=\"themenkachel-image\">\r\n                        \r\n                      </div>\r\n                    \r\n                    <div class=\"themenkachel-text\">\r\n                      \r\n                          <small>Risikomanagement Leben</small>\r\n                        \r\n                      <h5>Individuelle Lösungen für ein erfolgreiches Risikomanagement</h5>\r\n                      <p>Identifizieren, Analysieren, Bewerten – ein erfolgreiches Risikomanagement für Erstversicherer basiert auf drei wesentlichen Faktoren. Bei uns gibt es keine Lösungen von der Stange. Die Deutsche Rück unterstützt Ihre Kunden mit individuellen Lösungen.</p>\r\n                    </div>            \r\n                  </div>\r\n                </a>\r\n              \r\n                \r\n            \r\n              \r\n              \r\n                <a href=\"/rueckversicherung/risiko-und-leistungspruefung\" class=\"col s12 m6 l4 xl3 themenkachel\">\r\n                  <div class=\"themenkachel-content\">\r\n                    \r\n                      <div class=\"themenkachel-image\">\r\n                        \r\n                          <img src=\"/fileadmin/_processed_/5/f/csm_Mediziner___bongkarn_AdobeStock_310609778_ecd524eb5c.jpeg\" alt=\"\" class=\"themenkachel-image\">\r\n                        \r\n                      </div>\r\n                    \r\n                    <div class=\"themenkachel-text\">\r\n                      \r\n                          <small>Risiko- und Leistungsprüfung</small>\r\n                        \r\n                      <h5>Bester Support – digital und persönlich</h5>\r\n                      <p>Die Risiko- und Leistungsprüfung muss effizient, sachgerecht und vor allem kundenorientiert arbeiten. Die Deutsche Rück unterstützt mit ihrem Know-how und ihren digitalen Services und verschafft so echte Wettbewerbsvorteile. </p>\r\n                    </div>            \r\n                  </div>\r\n                </a>\r\n              \r\n                \r\n            \r\n              \r\n              \r\n                <a href=\"/rueckversicherung/innovationen\" class=\"col s12 m6 l4 xl3 themenkachel\">\r\n                  <div class=\"themenkachel-content\">\r\n                    \r\n                      <div class=\"themenkachel-image\">\r\n                        \r\n                          <img src=\"/fileadmin/_processed_/9/a/csm_Creativity___weedezign_AdobeStock_284656559_8253f1a04f.jpeg\" alt=\"\" class=\"themenkachel-image\">\r\n                        \r\n                      </div>\r\n                    \r\n                    <div class=\"themenkachel-text\">\r\n                      \r\n                          <small>Innovationen Leben</small>\r\n                        \r\n                      <h5>Innovativ und intelligent – Unsere Produktkonzepte </h5>\r\n                      <p>Wir entwickeln neue, innovative Produkte und Produktfeatures für Erstversicherer: von der Idee über die konkrete Ausgestaltung, von der Bedingungsformulierung über das Pricing, bis hin zu passenden Vermarktungsansätzen. Erfahren Sie mehr!</p>\r\n                    </div>            \r\n                  </div>\r\n                </a>\r\n              \r\n                \r\n            \r\n              \r\n              \r\n                \r\n            \r\n\r\n\r\n          </div>\r\n        \r\n      \r\n\r\n\r\n  </div>\r\n</div>\r\n</main>\r\n\r\n<footer>\r\n  <div id=\"c5\" class=\"mask bg-white\">\r\n    <div class=\"container\">\r\n      <div class=\"row\">\r\n        \r\n            <div class=\"col s12\">\r\n              <h3 class=\"footerhead\">Sie haben weitere Fragen?</h3>\r\n            </div>\r\n            <div class=\"col s12 l6\">\r\n              \r\n    \r\n    \r\n    \r\n    \r\n      \r\n    \r\n        <div id=\"c81\" class=\"mask mask-html bg-white\">\r\n            <p>\r\n    <strong>Hausanschrift:</strong><br>\r\n    Heerdter Lohweg 53<br>\r\n    40549 Düsseldorf<br>\r\n    Postanschrift:<br>\r\n    Postfach 29 01 10<br>\r\n    40528 Düsseldorf<br>\r\n    Telefon: +49 211 4554-01<br>\r\n    Telefax: +49 211 4554-45199<br>\r\n    E-Mail: info(at)deutscherueck.de\r\n  </p>\r\n  <p>\r\n    <strong>Vorstände der Aktiengesellschaft:</strong><br>\r\n    Achim Bosch (Vorsitzender), Caren Büning, Michael Rohde\r\n  </p>\r\n  <p>\r\n    <strong>Vorsitzender des Aufsichtsrats:</strong><br>\r\n    Prof. Dr. Frank Walthes\r\n  </p>\r\n        </div>\r\n      \r\n      \r\n  \r\n\r\n\r\n            </div>\r\n            <div class=\"col s12 l6\">\r\n              \r\n            </div>\r\n          \r\n      </div>\r\n    </div>\r\n  </div>\r\n  <div id=\"footernav\">\r\n    <div class=\"container\">\r\n      <div class=\"row\">\r\n        <div class=\"col s12\">\r\n          <ul>\r\n            \r\n                <li><a href=\"/impressum\">Impressum</a></li><li><a href=\"/datenschutz\">Datenschutz</a></li><li><a href=\"javascript: Cookiebot.re