labelledby=\"filter[taetigkeit_id][]_caption\" id=\"taetigkeit\" multiple=\"multiple\">\n            \n\n\n\n\n\n\n\n<option value=\"2,2\" title=\"Option Students\">Students</option>\n\n<option value=\"6,6\" title=\"Option Young Professionals\">Young Professionals</option>\n\n<option value=\"3,3\" title=\"Option Professionals\">Professionals</option>\n\n\n\n\n\n\n        </select>\n    </div>    \n\n</div>\n\n\n\n\n\n\n\n</div>\n                <div class=\"job_alert_filter\">\n\n\n\n\n\n<div class=\"group_field filter_selbox\">\n                   \n    <label for=\"aufgabengebiet\" id=\"filter[aufgabengebiet_id][]_caption\">Area of Interest</label>\n\n    <div class=\"input_box\">\n        <select name=\"filter[aufgabengebiet_id][]\" title=\"Area of Interest\" aria-labelledby=\"filter[aufgabengebiet_id][]_caption\" id=\"aufgabengebiet\" multiple=\"multiple\">\n            \n\n\n\n\n\n\n\n<option value=\"29\" title=\"Option Real Estate Investmentmanagement\">Real Estate Investmentmanagement</option>\n\n<option value=\"30\" title=\"Option Originate &amp; Cooperate\">Originate &amp; Cooperate</option>\n\n<option value=\"18\" title=\"Option Audit\">Audit</option>\n\n<option value=\"19\" title=\"Option Business Management\">Business Management</option>\n\n<option value=\"20\" title=\"Option Communications\">Communications</option>\n\n<option value=\"21\" title=\"Option Compliance\">Compliance</option>\n\n<option value=\"22\" title=\"Option Corporate Office/Corporate Development\">Corporate Office/Corporate Development</option>\n\n<option value=\"23\" title=\"Option Credit Risk Management\">Credit Risk Management</option>\n\n<option value=\"12\" title=\"Option Finance\">Finance</option>\n\n<option value=\"1_1\" title=\"Option General Function\">General Function</option>\n\n<option value=\"17\" title=\"Option Human Resources\">Human Resources</option>\n\n<option value=\"13_13\" title=\"Option Information Technology\">Information Technology</option>\n\n<option value=\"10\